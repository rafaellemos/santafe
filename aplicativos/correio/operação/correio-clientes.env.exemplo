# Credenciais dos bancos postais externos. Este arquivo é lido pelos
# portões compartilhados, mas cada cliente conserva banco, depósito, chaves,
# fila e ciclo operacional independentes.
#
# O prefixo precisa coincidir com CORREIO_BANCOS_ADICIONAIS. Repita o bloco
# com outro prefixo para cada implantação. Não grave segredos no repositório.

SECUNDARIO_MARIADB_HOST=127.0.0.1
SECUNDARIO_MARIADB_PORTA=3306
SECUNDARIO_MARIADB_USUARIO=troque_este_usuario
SECUNDARIO_MARIADB_SENHA=troque_esta_senha
SECUNDARIO_MARIADB_BANCO=troque_este_banco
