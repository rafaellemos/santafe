# Este arquivo deve ser instalado como /etc/santafe/mailjet.env com modo 0640,
# proprietário root e grupo correio. Nunca grave credenciais reais no fonte.
CORREIO_ENVIOS_MODO=retransmissor
CORREIO_ENVIOS_ENDERECO=in-v3.mailjet.com
CORREIO_ENVIOS_PORTA=587
CORREIO_ENVIOS_SEGURANCA=inícioTLS
CORREIO_ENVIOS_USUARIO=troque_pela_chave_de_api
CORREIO_ENVIOS_SENHA=troque_pela_chave_secreta
CORREIO_ENVIOS_VALIDAR_CERTIFICADO=verdadeiro
