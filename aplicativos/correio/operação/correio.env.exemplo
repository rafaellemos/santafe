CORREIO_RAIZ=/opt/correio
CORREIO_DEPOSITO=/var/lib/santafé/correio
CORREIO_DOMINIO=santafé.dev.br
CORREIO_DOMINIOS_LOCAIS=santafé.dev.br,xn--santaf-gva.dev.br
CORREIO_LIMITE_MENSAGEM=52428800
CORREIO_LIMITE_DESTINATARIOS=50
CORREIO_PULSO_ARQUIVO=/var/log/santafé/correio.pulso
CORREIO_PISCINA_MINIMA=2
CORREIO_PISCINA_MAXIMA=12
CORREIO_PISCINA_FILA=200
CORREIO_PISCINA_ESPERA=5000

# Antivírus. O Correio usa INSTREAM sobre a porta local e falha fechado:
# ameaça é recusada; motor indisponível produz falha temporária.
CORREIO_ANTIVIRUS_ATIVO=verdadeiro
CORREIO_ANTIVIRUS_ENDERECO=127.0.0.1
CORREIO_ANTIVIRUS_PORTA=3310
CORREIO_ANTIVIRUS_TEMPO_LIMITE=120000
CORREIO_ANTIVIRUS_BLOCO=65536

# Triagem explicável. Domínios completos usam a forma @exemplo.org.
CORREIO_TRIAGEM_ATIVA=verdadeiro
CORREIO_TRIAGEM_LIMITE_SUSPEITA=4
CORREIO_TRIAGEM_LIMITE_INDESEJADA=8
CORREIO_TRIAGEM_BLOQUEADOS=

SANTAFE_MARIADB_HOST=127.0.0.1
SANTAFE_MARIADB_PORTA=3306
SANTAFE_MARIADB_USUARIO=troque_este_usuario
SANTAFE_MARIADB_SENHA=troque_esta_senha
SANTAFE_MARIADB_BANCO=troque_este_banco

# Bancos independentes atendidos pelos mesmos portões SMTP/IMAP. Credenciais
# ficam em /etc/santafe/correio-clientes.env; aqui entram apenas a rota e o
# depósito: domínio|PREFIXO_MARIADB|caminho, separados por vírgula. Cada
# implantação externa ocupa um subdiretório próprio da raiz autorizada.
CORREIO_BANCOS_ADICIONAIS=domínio.example|SECUNDARIO|/var/lib/correio-clientes/secundario/correio

# Entrega direta por MX é o modo principal. O modo retransmissor permanece
# disponível como contingência e exige CORREIO_ENVIOS_ENDERECO.
CORREIO_ENVIOS_MODO=direto
# O nome apresentado no EHLO deve resolver para o IP de saída e coincidir
# com o PTR desse IP.
CORREIO_ENVIOS_NOME=xn--santaf-gva.dev.br
CORREIO_ENVIOS_PORTA_DIRETA=25
CORREIO_ENVIOS_SEGURANCA_DIRETA=oportunista
CORREIO_ENVIOS_TEMPO_LIMITE=15000
CORREIO_ENVIOS_TEMPO_LIMITE_DNS=5000
CORREIO_ENVIOS_MAXIMO_MX=10
# Duas tentativas na primeira hora; depois, recuo de duas a três horas.
CORREIO_ENVIOS_INTERVALOS=1800,7200,7200,10800
CORREIO_ENVIOS_AVISO_ATRASO=14400
CORREIO_ENVIOS_PRAZO=432000
CORREIO_ENVIOS_TENTATIVAS_AVISO=5
CORREIO_ENVIOS_FALHAS_QUARENTENA=3
CORREIO_ENVIOS_VALIDAR_CERTIFICADO=verdadeiro

# Somente para CORREIO_ENVIOS_MODO=retransmissor:
CORREIO_ENVIOS_ENDERECO=smtp.exemplo.org
CORREIO_ENVIOS_PORTA=587
CORREIO_ENVIOS_SEGURANCA=inícioTLS
CORREIO_ENVIOS_USUARIO=
CORREIO_ENVIOS_SENHA=

# DKIM rsa-sha256. A chave privada deve pertencer a root:correio e usar 0640.
CORREIO_DKIM_DOMINIO=xn--santaf-gva.dev.br
CORREIO_DKIM_SELETOR=santafe2026
CORREIO_DKIM_CHAVE=/etc/santafe-correio/dkim/santafe2026.pem
CORREIO_DKIM_EXIGIR=verdadeiro
# Domínios adicionais usam domínio|seletor|caminho, separados por vírgula.
# A identidade antiga acima continua válida e é incorporada automaticamente.
CORREIO_DKIM_IDENTIDADES=xn--domnio-5va.example|secundario2026|/etc/santafe-correio/dkim/secundario2026.pem

# Recebedor SMTP. Use 2525 no laboratório; a ativação da porta 25 exige
# firewall, DNS, reputação e certificados.
CORREIO_RECEBEDOR_ENDERECO=0.0.0.0
CORREIO_RECEBEDOR_PORTA=2525
CORREIO_RECEBEDOR_NOME=xn--santaf-gva.dev.br
CORREIO_RECEBEDOR_SEGURANCA=nenhuma
# CORREIO_RECEBEDOR_CERTIFICADO=/etc/letsencrypt/live/exemplo/fullchain.pem
# CORREIO_RECEBEDOR_CHAVE=/etc/letsencrypt/live/exemplo/privkey.pem

# Agência de submissão autenticada. A porta 465 inicia TLS imediatamente e é
# a preferência para novos clientes; a porta 587 oferece STARTTLS.
CORREIO_AGENCIA_ENDERECO=0.0.0.0
CORREIO_AGENCIA_PORTA_STARTTLS=587
CORREIO_AGENCIA_PORTA_TLS=465
CORREIO_AGENCIA_NOME=xn--santaf-gva.dev.br
CORREIO_AGENCIA_CERTIFICADO=/etc/letsencrypt/live/exemplo/fullchain.pem
CORREIO_AGENCIA_CHAVE=/etc/letsencrypt/live/exemplo/privkey.pem
CORREIO_AGENCIA_LIMITE_CONEXOES=500
CORREIO_AGENCIA_LIMITE_CONEXOES_POR_ENDERECO=10
CORREIO_AGENCIA_LIMITE_NOVAS_POR_MINUTO=30
CORREIO_AGENCIA_LIMITE_AUTENTICACAO=3

# Acesso às caixas por clientes externos. IMAP usa TLS desde o primeiro taco
# na porta 993; não existe LOGIN em texto aberto nem porta 143 nesta versão.
CORREIO_IMAP_ENDERECO=0.0.0.0
CORREIO_IMAP_PORTA=993
CORREIO_IMAP_NOME=xn--santaf-gva.dev.br
CORREIO_IMAP_CERTIFICADO=/etc/letsencrypt/live/exemplo/fullchain.pem
CORREIO_IMAP_CHAVE=/etc/letsencrypt/live/exemplo/privkey.pem
CORREIO_IMAP_TEMPO_LIMITE=1800000
CORREIO_IMAP_LIMITE_LINHA=16384
CORREIO_IMAP_LIMITE_COMANDOS=10000
CORREIO_IMAP_INTERVALO_OCIOSO=15000
CORREIO_IMAP_LIMITE_CONEXOES=500
CORREIO_IMAP_LIMITE_CONEXOES_POR_ENDERECO=10
CORREIO_IMAP_LIMITE_NOVAS_POR_MINUTO=60
CORREIO_IMAP_LIMITE_AUTENTICACAO=5

# Autenticação postal de entrada. Falhas temporárias fecham com SMTP 451.
CORREIO_AUTENTICACAO_ATIVA=verdadeiro
CORREIO_AUTENTICACAO_TEMPO_LIMITE=5000
