[Unit]
Description=Correio Envios Santafé (uma carta pendente)
After=network-online.target mariadb.service
Wants=network-online.target mariadb.service

[Service]
Type=oneshot
User=correio
Group=correio
WorkingDirectory=/opt/correio
EnvironmentFile=/etc/santafe/correio.env
Environment=GSETTINGS_BACKEND=memory
ExecStart=/usr/local/bin/santafé /opt/correio/envios.fé
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/santafé /var/lib/santafé/correio
