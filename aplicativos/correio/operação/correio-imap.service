[Unit]
Description=Correio IMAP Santafé (acesso cifrado às caixas)
After=network-online.target mariadb.service
Wants=network-online.target mariadb.service

[Service]
Type=simple
User=correio
Group=correio
WorkingDirectory=/opt/correio
EnvironmentFile=/etc/santafe/correio.env
EnvironmentFile=-/etc/santafe/correio-clientes.env
Environment=GSETTINGS_BACKEND=memory
ExecStart=/usr/local/bin/santafé /opt/correio/imap.fé
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/letsencrypt
ReadWritePaths=/var/log/santafé /var/lib/santafé/correio /var/lib/correio-clientes
RestrictAddressFamilies=AF_INET AF_INET6
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
