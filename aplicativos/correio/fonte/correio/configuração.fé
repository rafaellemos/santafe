        1024, 100 * 1024 * 1024)
    local modoDeEnvio = so.obterVariável("CORREIO_ENVIOS_MODO") ou "direto"
    garanta(modoDeEnvio == "direto" ou modoDeEnvio == "retransmissor",
        "CORREIO_ENVIOS_MODO deve ser direto ou retransmissor")
    local dkim = {
        domínio = so.obterVariável("CORREIO_DKIM_DOMINIO") ou domínioASCII,
        seletor = so.obterVariável("CORREIO_DKIM_SELETOR"),
        chave = so.obterVariável("CORREIO_DKIM_CHAVE"),
        exigir = lógico("CORREIO_DKIM_EXIGIR", modoDeEnvio == "direto")
    }
    dkim.identidades = identidadesDKIM(dkim)
    local prefixoDoBanco = prefixoVálido(
        so.obterVariável("CORREIO_BANCO_PREFIXO") ou "SANTAFE")
    local valores = {
        domínio = domínio,
        domínioASCII = domínioASCII,
        domíniosLocais = lista("CORREIO_DOMINIOS_LOCAIS", { domínio }),
        limiteCorpo = limiteCorpo,
        limiteDestinatários = inteiro("CORREIO_LIMITE_DESTINATARIOS", 50, 1, 100),
        tabelaDaFila = so.obterVariável("CORREIO_TABELA_FILA") ou
            "correio_fila",
        depósito = {
            raiz = so.obterVariável("CORREIO_DEPOSITO") ou
                "/var/lib/santafé/correio",
            limite = limiteCorpo
        },
        banco = configuração.carregueBanco(prefixoDoBanco),
        envios = {
            modo = modoDeEnvio,
            endereço = so.obterVariável("CORREIO_ENVIOS_ENDERECO"),
            porta = modoDeEnvio == "direto" e
                inteiro("CORREIO_ENVIOS_PORTA_DIRETA", 25, 1, 65535) ou
                inteiro("CORREIO_ENVIOS_PORTA", 587, 1, 65535),
            segurança = modoDeEnvio == "direto" e
                (so.obterVariável("CORREIO_ENVIOS_SEGURANCA_DIRETA") ou
                    "oportunista") ou
                (so.obterVariável("CORREIO_ENVIOS_SEGURANCA") ou "inícioTLS"),
            nome = so.obterVariável("CORREIO_ENVIOS_NOME") ou
                ("mail." .. domínioASCII),
            usuário = so.obterVariável("CORREIO_ENVIOS_USUARIO"),
            senha = so.obterVariável("CORREIO_ENVIOS_SENHA"),
            validarCertificado = lógico("CORREIO_ENVIOS_VALIDAR_CERTIFICADO", verdadeiro),
            tempoLimite = inteiro("CORREIO_ENVIOS_TEMPO_LIMITE", 15000,
                1000, 120000),
            tempoLimiteDNS = inteiro("CORREIO_ENVIOS_TEMPO_LIMITE_DNS", 5000,
                500, 60000),
            máximoMX = inteiro("CORREIO_ENVIOS_MAXIMO_MX", 10, 1, 50),
            prazo = inteiro("CORREIO_ENVIOS_PRAZO", 5 * 24 * 60 * 60,
                3600, 14 * 24 * 60 * 60),
            intervalos = intervalos("CORREIO_ENVIOS_INTERVALOS",
                { 1800, 7200, 7200, 10800 }),
            avisoDeAtraso = inteiro("CORREIO_ENVIOS_AVISO_ATRASO",
