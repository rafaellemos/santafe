local configuração = {}
local rede = importe "rede"

local função prefixoVálido(valor)
    valor = paraColar(valor ou ""):apare():maiúscula()
    garanta(valor:procure("^[A-Z][A-Z0-9_]*$") ~= nulo,
        "prefixo do banco aceita somente A-Z, 0-9 e sublinhado")
    retorne valor
fim

local função inteiro(nome, padrão, mínimo, máximo)
    local texto = so.obterVariável(nome)
    se não texto ou texto == "" então retorne padrão fim
    local valor = paraNúmero(texto)
    valor = valor e mat.paraInteiro(valor) ou nulo
    garanta(valor e valor >= mínimo e valor <= máximo,
        nome .. " deve ser um inteiro entre " .. mínimo .. " e " .. máximo)
    retorne valor
fim

local função lógico(nome, padrão)
    local texto = so.obterVariável(nome)
    se não texto ou texto == "" então retorne padrão fim
    texto = texto:minúscula():apare()
    se texto == "1" ou texto == "sim" ou texto == "verdadeiro" então
        retorne verdadeiro
    fim
    se texto == "0" ou texto == "não" ou texto == "nao" ou texto == "falso" então
        retorne falso
    fim
    erro(nome .. " deve ser sim/não ou verdadeiro/falso")
fim

local função lista(nome, padrão)
    local texto = so.obterVariável(nome)
    se não texto ou texto:apare() == "" então retorne padrão fim
    local itens = {}
    para item em texto:capture("[^,]+") início
        item = item:apare()
        se item ~= "" então itens[#itens + 1] = item fim
    fim
    retorne itens
fim

local função intervalos(nome, padrão)
    local itens = lista(nome, padrão)
    local resultado = {}
    para _, item em ipares(itens) início
        local valor = mat.paraInteiro(paraNúmero(item))
        garanta(valor e valor >= 60 e valor <= 24 * 60 * 60,
            nome .. " aceita segundos entre 60 e 86400")
        resultado[#resultado + 1] = valor
    fim
    garanta(#resultado > 0, nome .. " precisa de ao menos um intervalo")
    retorne resultado
fim

local função identidadesDKIM(padrão)
    local resultado = {}
    para _, item em ipares(lista("CORREIO_DKIM_IDENTIDADES", {})) início
        local domínio, seletor, chave = item:separe(
            "^([^|]+)|([^|]+)|(.+)$")
        garanta(domínio e seletor e chave,
            "CORREIO_DKIM_IDENTIDADES usa domínio|seletor|caminho")
        domínio = garanta(rede.domínioASCII(domínio:apare())):minúscula()
        seletor, chave = seletor:apare(), chave:apare()
        garanta(seletor ~= "" e chave ~= "",
            "identidade DKIM precisa de seletor e caminho")
        garanta(não resultado[domínio],
            "identidade DKIM repetida para " .. domínio)
        resultado[domínio] = {
            domínio = domínio, seletor = seletor, chave = chave
        }
    fim
    se padrão.seletor e padrão.chave então
        local domínio = garanta(rede.domínioASCII(padrão.domínio)):minúscula()
        se não resultado[domínio] então
            resultado[domínio] = {
                domínio = domínio,
                seletor = padrão.seletor,
                chave = padrão.chave
            }
        fim
    fim
    retorne resultado
fim

função configuração.carregueBanco(prefixo)
    prefixo = prefixoVálido(prefixo ou "SANTAFE")
    local função nome(sufixo)
        retorne prefixo .. "_MARIADB_" .. sufixo
    fim
    retorne {
        prefixo = prefixo,
        endereço = so.obterVariável(nome("HOST")) ou "127.0.0.1",
        usuário = so.obterVariável(nome("USUARIO")),
        senha = so.obterVariável(nome("SENHA")) ou "",
        banco = so.obterVariável(nome("BANCO")),
        porta = inteiro(nome("PORTA"), 3306, 1, 65535),
        mínimo = inteiro("CORREIO_PISCINA_MINIMA", 2, 1, 32),
        máximo = inteiro("CORREIO_PISCINA_MAXIMA", 12, 1, 128),
        máximoDaFila = inteiro("CORREIO_PISCINA_FILA", 200, 1, 10000),
        tempoDeEspera = inteiro("CORREIO_PISCINA_ESPERA", 5000, 100, 60000)
    }
fim

local função bancosPostais(valores, prefixoPrincipal)
    local bancos, domínios, prefixos = {}, {}, {}

    local função adicione(domínio, prefixo, raiz)
        domínio = paraColar(domínio ou ""):apare()
        prefixo = prefixoVálido(prefixo)
        raiz = paraColar(raiz ou ""):apare()
        garanta(domínio ~= "", "banco postal precisa de um domínio")
        garanta(raiz:corte(1, 1) == "/",
            "depósito do banco postal precisa de um caminho absoluto")
        local domínioASCII = garanta(rede.domínioASCII(domínio)):minúscula()
        garanta(não domínios[domínioASCII],
            "domínio postal repetido: " .. domínioASCII)
        garanta(não prefixos[prefixo],
            "prefixo de banco postal repetido: " .. prefixo)
        local específica = {}
        para nome, valor em pares(valores) início
            específica[nome] = valor
        fim
        específica.chave = prefixo:minúscula()
        específica.prefixoDoBanco = prefixo
        específica.domínio = domínio
        específica.domínioASCII = domínioASCII
        específica.domíniosLocais = { domínio, domínioASCII }
        específica.banco = configuração.carregueBanco(prefixo)
        específica.depósito = { raiz = raiz, limite = valores.limiteCorpo }
        específica.bancosPostais = nulo
        bancos[#bancos + 1] = específica
        domínios[domínioASCII] = específica
        prefixos[prefixo] = específica
    fim

    adicione(valores.domínio, prefixoPrincipal, valores.depósito.raiz)
    para _, item em ipares(lista("CORREIO_BANCOS_ADICIONAIS", {})) início
        local domínio, prefixo, raiz = item:separe(
            "^([^|]+)|([^|]+)|(.+)$")
        garanta(domínio e prefixo e raiz,
            "CORREIO_BANCOS_ADICIONAIS usa domínio|prefixo|depósito")
        adicione(domínio, prefixo, raiz)
    fim
    retorne bancos
fim

