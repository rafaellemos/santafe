                100, 1000000),
            intervaloOcioso = inteiro("CORREIO_IMAP_INTERVALO_OCIOSO", 15000,
                1000, 300000),
            limiteConexões = inteiro("CORREIO_IMAP_LIMITE_CONEXOES",
                500, 1, 100000),
            limiteConexõesPorEndereço = inteiro(
                "CORREIO_IMAP_LIMITE_CONEXOES_POR_ENDERECO",
                10, 1, 1000),
            limiteNovasConexõesPorMinuto = inteiro(
                "CORREIO_IMAP_LIMITE_NOVAS_POR_MINUTO",
                60, 1, 10000),
            limiteTentativasDeAutenticação = inteiro(
                "CORREIO_IMAP_LIMITE_AUTENTICACAO", 5, 1, 20)
        },
        pulsoArquivo = so.obterVariável("CORREIO_PULSO_ARQUIVO") ou
            "/var/log/santafé/correio.pulso"
    }
    valores.bancosPostais = bancosPostais(valores, prefixoDoBanco)
    retorne valores
fim

retorne configuração
