local função caminhoDaPágina(pasta, busca, página)
    local argumentos = {}
    busca = util.apare(busca):corte(1, 100)
    se busca ~= "" então
        argumentos[#argumentos + 1] = "busca=" ..
            util.codifiquePercentual(busca)
    fim
    se página > 1 então
        argumentos[#argumentos + 1] = "pagina=" .. página
    fim
    local caminho = "/carteiro/" .. pasta
    se #argumentos > 0 então
        caminho = caminho .. "?" .. tabela.concatene(argumentos, "&amp;")
    fim
    retorne caminho
fim

função páginas.lista(usuário, caixa, pasta, mensagens, busca,
                              página, total, limite)
    página = paraNúmero(página) ou 1
    limite = paraNúmero(limite) ou 50
    total = paraNúmero(total) ou #mensagens
    se página < 1 então página = 1 fim
    local começo = total > 0 e ((página - 1) * limite + 1) ou 0
    local término = mat.mínimo(total, começo + #mensagens - 1)
    se total == 0 então término = 0 fim
    local temAnterior = página > 1
    local temPróxima = término < total
    local itens = {}
    para índice, mensagem em ipares(mensagens) início
        local nãoLida = não mensagem.lida e " não-lida" ou ""
        local interlocutor = (mensagem.direção == "saída" ou
            mensagem.direção == "saida") e
            junteEndereços(mensagem.destinatários) ou
            util.endereçoLegível(mensagem.remetente)
        local identificaçãoDaSeleção = "carteiro-carta-" .. mensagem.id
        local seleção =
            '<input id="' .. identificaçãoDaSeleção .. '" type="checkbox" ' ..
            'name="carta_' .. mensagem.id .. '" value="' .. mensagem.id ..
            '" data-carta data-lida="' ..
            (mensagem.lida e "verdadeiro" ou "falso") .. '"><label ' ..
            'class="carteiro-seletor-item" for="' .. identificaçãoDaSeleção ..
            '" aria-label="Selecionar carta"></label>'
        local participantes = participantesDaConversa(mensagem, interlocutor)
        local caminho = '/carteiro/mensagens/' .. mensagem.id .. '?pasta=' .. pasta ..
            '&amp;posicao=' .. (começo + índice - 1) ..
            '&amp;total=' .. total
        itens[#itens + 1] = '<div class="carteiro-linha' .. nãoLida .. '">' ..
            seleção .. '<div class="carteiro-item' .. nãoLida .. '"><a ' ..
            'class="carteiro-item-cabeçalho" href="' .. caminho .. '">' ..
            '<span class="carteiro-item-remetente">' ..
            util.escapeHTML(participantes) .. '</span>' ..
            '<span class="carteiro-item-assunto"><strong>' ..
            util.escapeHTML(assuntoLegívelDaConversa(mensagem.assunto)) ..
            ((mensagem.quantidadeNaConversa ou 1) > 1 e
                (' <b class="carteiro-contagem-conversa">' ..
                    mensagem.quantidadeNaConversa .. '</b>') ou '') ..
            '</strong>' .. etiquetaDaTriagem(mensagem) .. '<small> — ' ..
            util.escapeHTML(mensagem.resumo) .. '</small></span>' ..
            '<span class="carteiro-item-data">' .. dataRelativa(mensagem.criadaEm) .. '</span>' ..
            '</a>' .. anexosResumidosDaConversa(mensagem) .. '</div></div>'
    fim
    se #itens == 0 então
        itens[1] = '<div class="carteiro-vazio"><i class="material-icons">mark_email_read</i>' ..
            '<h5>Nenhuma mensagem aqui</h5><p>Esta pasta ainda está vazia.</p></div>'
    fim

    local esvaziar = ""
    se pasta == "lixeira" e #mensagens > 0 então
        esvaziar = '<form class="carteiro-esvaziar" ' ..
            'action="/carteiro/lixeira/esvaziar" method="POST" ' ..
            'data-confirma="Esvaziar a lixeira definitivamente? Esta ação não pode ser desfeita.">' ..
            '<input type="hidden" name="csrf" value="' ..
            util.escapeHTML(usuário.csrf) .. '"><button class="btn-flat red-text" ' ..
            'type="submit"><i class="material-icons left" aria-hidden="true">' ..
            'delete_forever</i>Esvaziar lixeira</button></form>'
    fim

    local anterior = temAnterior e
        ('<a class="carteiro-botão-ícone" rel="prev" href="' ..
        caminhoDaPágina(pasta, busca, página - 1) ..
        '" title="Página anterior" aria-label="Página anterior"><i ' ..
        'class="material-icons" aria-hidden="true">chevron_left</i></a>') ou
        '<span class="carteiro-botão-ícone desativado" aria-disabled="true" ' ..
        'aria-label="Não há página anterior"><i class="material-icons" ' ..
        'aria-hidden="true">chevron_left</i></span>'
    local próxima = temPróxima e
        ('<a class="carteiro-botão-ícone" rel="next" href="' ..
        caminhoDaPágina(pasta, busca, página + 1) ..
        '" title="Próxima página" aria-label="Próxima página"><i ' ..
        'class="material-icons" aria-hidden="true">chevron_right</i></a>') ou
        '<span class="carteiro-botão-ícone desativado" aria-disabled="true" ' ..
        'aria-label="Não há próxima página"><i class="material-icons" ' ..
        'aria-hidden="true">chevron_right</i></span>'
    local controleDaPágina = '<div class="carteiro-controle-página" ' ..
        'aria-label="Navegação entre páginas"><span>' .. númeroLegível(começo) ..
        '–' .. númeroLegível(término) .. ' de ' .. númeroLegível(total) ..
        '</span>' .. anterior .. próxima .. '</div>'
    local atualizar = '<a class="carteiro-botão-ícone" href="' ..
        caminhoDaPágina(pasta, busca, página) .. '" title="Atualizar esta caixa" ' ..
        'aria-label="Atualizar esta caixa"><i class="material-icons" ' ..
        'aria-hidden="true">refresh</i></a>'
    local lista = '<section class="carteiro-lista">' ..
        tabela.concatene(itens) .. '</section>'

    se #mensagens > 0 então
        local ações
        se pasta == "lixeira" então
            ações = '<div class="carteiro-ações-selecionadas" ' ..
                'data-ações-selecionadas hidden><button ' ..
                'class="carteiro-botão-ícone" type="button" ' ..
                'data-executar-acao value="restaurar" ' ..
                'title="Restaurar em Todas" aria-label="Restaurar em Todas">' ..
                '<i class="material-icons" aria-hidden="true">' ..
                'restore_from_trash</i></button></div>'
        senão
            ações = '<div class="carteiro-ações-selecionadas" ' ..
                'data-ações-selecionadas hidden>' ..
                '<button class="carteiro-botão-ícone" type="button" ' ..
                'data-executar-acao value="arquivar" title="Arquivar" ' ..
                'aria-label="Arquivar"><i class="material-icons" ' ..
                'aria-hidden="true">archive</i></button>' ..
                '<button class="carteiro-botão-ícone" type="button" ' ..
                'data-executar-acao value="indesejada" title="Indesejada" ' ..
                'aria-label="Marcar como indesejada"><i class="material-icons" ' ..
                'aria-hidden="true">report</i></button>' ..
                '<button class="carteiro-botão-ícone" type="button" ' ..
                'data-executar-acao value="excluir" title="Descartar" ' ..
                'aria-label="Descartar na Lixeira"><i class="material-icons" ' ..
                'aria-hidden="true">delete</i></button>' ..
                '<details class="carteiro-menu carteiro-menu-ações"><summary ' ..
                'class="carteiro-botão-ícone" title="Ações das cartas" ' ..
                'aria-label="Ações das cartas selecionadas"><i class="material-icons" ' ..
                'aria-hidden="true">more_vert</i></summary><div ' ..
                'class="carteiro-menu-conteúdo"><button type="button" ' ..
                'data-executar-acao value="lida"><i class="material-icons" ' ..
                'aria-hidden="true">drafts</i>Marcar como lida</button>' ..
                '<button type="button" data-executar-acao value="não-lida"><i ' ..
                'class="material-icons" aria-hidden="true">markunread</i>' ..
                'Marcar como não lida</button><button type="button" ' ..
                'data-executar-acao value="arquivar"><i class="material-icons" ' ..
                'aria-hidden="true">archive</i>Arquivar</button><button type="button" ' ..
                'data-executar-acao value="excluir"><i class="material-icons" ' ..
                'aria-hidden="true">delete</i>Descartar</button><button type="button" ' ..
                'data-executar-acao value="indesejada"><i class="material-icons" ' ..
                'aria-hidden="true">report</i>Indesejada</button></div></details></div>'
        fim
        local seletor = '<div class="carteiro-seletor-menu"><input ' ..
            'id="carteiro-selecionar-todas" type="checkbox" ' ..
            'data-selecionar-todas><label for="carteiro-selecionar-todas" ' ..
            'aria-label="Selecionar todas as cartas desta página"></label>' ..
            '<details class="carteiro-menu"><summary title="Opções de seleção" ' ..
            'aria-label="Opções de seleção"><i class="material-icons" ' ..
            'aria-hidden="true">arrow_drop_down</i></summary>' ..
            '<div class="carteiro-menu-conteúdo"><button type="button" ' ..
            'data-selecionar="todas">Todas</button><button type="button" ' ..
            'data-selecionar="nenhuma">Nenhuma</button><button type="button" ' ..
            'data-selecionar="lidas">Lidas</button><button type="button" ' ..
            'data-selecionar="não-lidas">Não lidas</button></div></details></div>'
        local avisoGlobal = '<div class="carteiro-seleção-global" ' ..
            'data-seleção-global data-total="' .. total .. '" data-pasta="' ..
            util.escapeHTML(nomesDasPastas[pasta]) .. '" hidden><span ' ..
            'data-aviso-página>Todas as ' .. númeroLegível(#mensagens) ..
            ' conversas nesta página estão selecionadas.</span> ' ..
            '<button type="button" data-selecionar-escopo>Selecionar todas as ' ..
            númeroLegível(total) .. ' conversas em ' ..
            util.escapeHTML(nomesDasPastas[pasta]) .. '</button><span ' ..
            'data-aviso-total hidden>Todas as ' .. númeroLegível(total) ..
            ' conversas em ' .. util.escapeHTML(nomesDasPastas[pasta]) ..
            ' estão selecionadas.</span> <button type="button" ' ..
            'data-limpar-escopo hidden>Limpar seleção</button></div>'
        lista = '<form class="carteiro-seleção-em-lote" ' ..
            'action="/carteiro/mensagens/acao-em-lote" method="POST" ' ..
            'data-seleção-em-lote><input type="hidden" name="csrf" value="' ..
            util.escapeHTML(usuário.csrf) .. '"><input type="hidden" ' ..
            'name="pastaDeOrigem" value="' .. pasta .. '"><input type="hidden" ' ..
            'name="busca" value="' .. util.escapeHTML(busca) .. '">' ..
            '<input type="hidden" name="pagina" value="' .. página .. '">' ..
            '<input type="hidden" name="acao" value="" data-acao-lote>' ..
            '<input type="hidden" name="escopo" value="pagina" ' ..
            'data-escopo-seleção><div class="carteiro-barra-postal"><div ' ..
            'class="carteiro-ferramentas">' .. seletor .. atualizar .. ações ..
            '</div>' .. controleDaPágina .. '</div>' .. avisoGlobal .. lista ..
            '</form>'
    senão
        lista = '<div class="carteiro-barra-postal"><div ' ..
            'class="carteiro-ferramentas">' .. atualizar .. '</div>' ..
            controleDaPágina .. '</div>' .. lista
    fim

    local conteúdo = '<section class="carteiro-cabeçalho-lista"><div><h1>' ..
        nomesDasPastas[pasta] .. '</h1><p>' .. númeroLegível(total) ..
        (total == 1 e ' conversa' ou ' conversas') .. '</p></div>' ..
        '<div class="carteiro-cabeçalho-ações">' .. esvaziar ..
        '<form action="/carteiro/' .. pasta .. '" method="GET" role="search">' ..
        '<i class="material-icons">search</i><input name="busca" type="search" maxlength="100" ' ..
        'value="' .. util.escapeHTML(busca) .. '" placeholder="Pesquisar nesta pasta">' ..
        '<button class="btn-flat teal-text" type="submit">Buscar</button></form></div></section>' ..
        lista
    retorne páginas.base(usuário, caixa, nomesDasPastas[pasta], conteúdo, pasta)
