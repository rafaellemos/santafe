função páginas.triagem(usuário, caixa, regras)
    local linhas = {}
    para _, regra em ipares(regras ou {}) início
        local decisão = regra.decisão == "permitir" e
            "Entregar na entrada" ou "Separar em indesejadas"
        linhas[#linhas + 1] = '<tr><td>' .. util.escapeHTML(regra.escopo) ..
            '</td><td><code>' .. util.escapeHTML(regra.valor) ..
            '</code></td><td>' .. decisão .. '</td><td>' ..
            '<form action="/carteiro/triagem/regras/remover" method="POST">' ..
            '<input type="hidden" name="csrf" value="' ..
            util.escapeHTML(usuário.csrf) .. '"><input type="hidden" ' ..
            'name="escopo" value="' .. util.escapeHTML(regra.escopo) ..
            '"><input type="hidden" name="valor" value="' ..
            util.escapeHTML(regra.valor) .. '"><button class="btn-flat red-text" ' ..
            'type="submit">Remover</button></form></td></tr>'
    fim
    se #linhas == 0 então
        linhas[1] = '<tr><td colspan="4" class="carteiro-triagem-vazia">' ..
            'Você ainda não criou regras pessoais.</td></tr>'
    fim
