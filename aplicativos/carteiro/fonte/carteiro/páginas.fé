local função íconeDoAnexo(tipo, nome)
    local breve = tipoBreveDoAnexo(tipo, nome)
    se breve == "PDF" então retorne ÍCONE_PDF fim
    se breve == "SVG" então retorne ÍCONE_SVG fim
    se breve == "PNG" então retorne ÍCONE_PNG fim
    se breve == "JPG" ou breve == "JPEG" então retorne ÍCONE_JPG fim
    retorne '<b class="carteiro-anexo-tipo">' ..
        util.escapeHTML(breve) .. '.</b>'
fim

local função caminhoDoAnexo(mensagemId, anexoId, visualizar)
    retorne "/carteiro/mensagens/" .. mensagemId .. "/anexos/" ..
        anexoId .. (visualizar e "/visualizar" ou "")
fim

local função anexoDaLista(anexo)
    local nome = util.escapeHTML(anexo.nome ou "anexo")
    local ícone = íconeDoAnexo(anexo.tipo, anexo.nome)
    local classe = util.anexoExibível(anexo.tipo) e
        "carteiro-item-anexo visualizável" ou "carteiro-item-anexo"
    se util.anexoExibível(anexo.tipo) então
        retorne '<button class="' .. classe .. '" type="button" ' ..
            'data-visualizar-anexo data-anexo-nome="' .. nome ..
            '" data-anexo-tipo="' .. util.escapeHTML(anexo.tipo) ..
            '" data-anexo-url="' .. caminhoDoAnexo(
                anexo.mensagemId, anexo.id, verdadeiro) ..
            '" data-anexo-baixar="' .. caminhoDoAnexo(
                anexo.mensagemId, anexo.id, falso) .. '" title="' .. nome ..
            '">' .. ícone .. '<span>' .. nome .. '</span></button>'
    fim
    retorne '<a class="' .. classe .. '" href="' .. caminhoDoAnexo(
        anexo.mensagemId, anexo.id, falso) .. '" title="Baixar ' .. nome ..
        '">' .. ícone .. '<span>' .. nome .. '</span></a>'
fim

local função anexosResumidosDaConversa(mensagem)
    local anexos = mensagem.anexosNaConversa ou {}
    se #anexos == 0 então retorne "" fim
    local partes = {}
    local limite = mat.mínimo(2, #anexos)
    para índice = 1, limite início
        partes[#partes + 1] = anexoDaLista(anexos[índice])
    fim
    se #anexos > limite então
        partes[#partes + 1] = '<span class="carteiro-item-anexo mais">Mais ' ..
            (#anexos - limite) .. '…</span>'
    fim
    retorne '<span class="carteiro-item-anexos">' ..
        tabela.concatene(partes) .. '</span>'
fim

local função anexoDaCarta(mensagemId, anexo)
    local nome = util.escapeHTML(anexo.nome ou "anexo")
    local tipo = util.escapeHTML(anexo.tipo ou "application/octet-stream")
    local ícone = íconeDoAnexo(anexo.tipo, anexo.nome)
    local baixar = caminhoDoAnexo(mensagemId, anexo.id, falso)
    local exibível = util.anexoExibível(anexo.tipo)
    local abertura
    se exibível então
        abertura = '<button class="carteiro-anexo-abertura" type="button" ' ..
            'data-visualizar-anexo data-anexo-nome="' .. nome ..
            '" data-anexo-tipo="' .. tipo .. '" data-anexo-url="' ..
            caminhoDoAnexo(mensagemId, anexo.id, verdadeiro) ..
            '" data-anexo-baixar="' .. baixar .. '" title="Visualizar ' ..
            nome .. '">' .. ícone .. '<span><strong>' .. nome ..
            '</strong><small>' ..
            tamanhoLegível(anexo.tamanho) .. ' · ' .. tipo ..
            '</small></span></button>'
    senão
        abertura = '<a class="carteiro-anexo-abertura" href="' .. baixar ..
            '" title="Baixar ' .. nome .. '">' .. ícone ..
            '<span><strong>' .. nome ..
            '</strong><small>' .. tamanhoLegível(anexo.tamanho) ..
            ' · ' .. tipo .. '</small></span></a>'
    fim
    local visualizar = exibível e
        ('<button class="carteiro-botão-ícone" type="button" ' ..
            'data-visualizar-anexo data-anexo-nome="' .. nome ..
            '" data-anexo-tipo="' .. tipo .. '" data-anexo-url="' ..
            caminhoDoAnexo(mensagemId, anexo.id, verdadeiro) ..
            '" data-anexo-baixar="' .. baixar .. '" title="Visualizar" ' ..
            'aria-label="Visualizar ' .. nome .. '"><i class="material-icons" ' ..
            'aria-hidden="true">visibility</i></button><button ' ..
            'class="carteiro-botão-ícone" type="button" data-imprimir-anexo ' ..
            'data-anexo-url="' .. caminhoDoAnexo(
                mensagemId, anexo.id, verdadeiro) .. '" title="Imprimir" ' ..
            'aria-label="Imprimir ' .. nome .. '"><i class="material-icons" ' ..
            'aria-hidden="true">print</i></button>') ou ""
    retorne '<article class="carteiro-anexo-item">' .. abertura ..
        '<span class="carteiro-anexo-ações">' .. visualizar ..
        '<a class="carteiro-botão-ícone" href="' .. baixar ..
        '" title="Baixar" aria-label="Baixar ' .. nome .. '"><i ' ..
        'class="material-icons" aria-hidden="true">download</i></a></span></article>'
fim

local função etiquetaDaTriagem(mensagem)
    se mensagem.decisãoDoUsuário == "indesejada" então
        retorne '<span class="carteiro-triagem-etiqueta indesejada">' ..
            'sua regra · indesejada</span>'
    fim
    se mensagem.decisãoDoUsuário == "regular" então
        retorne '<span class="carteiro-triagem-etiqueta pessoal-regular">' ..
            'sua regra · regular</span>'
    fim
    local classificação = mensagem.classificaçãoDaTriagem ou "regular"
    se classificação == "regular" então retorne "" fim
    retorne '<span class="carteiro-triagem-etiqueta ' ..
        util.escapeHTML(classificação) .. '">' ..
        util.escapeHTML(classificação) .. ' · ' ..
        util.escapeHTML(mensagem.pontuaçãoDeSuspeita ou 0) .. '</span>'
fim

local função detalhesDaTriagem(mensagem)
    local classificação = mensagem.classificaçãoDaTriagem ou "regular"
    local itens = {}
    para _, motivo em ipares(mensagem.motivosDaTriagem ou {}) início
        itens[#itens + 1] = '<li><strong>+' ..
            util.escapeHTML(motivo.pontos ou 0) .. '</strong> ' ..
            util.escapeHTML(motivo.descrição ou motivo.regra ou "sinal") .. '</li>'
    fim
    local lista = #itens > 0 e '<ul>' .. tabela.concatene(itens) .. '</ul>' ou
        '<p>Nenhum sinal de suspeita foi encontrado.</p>'
    local decisãoPessoal = ""
    se mensagem.decisãoDoUsuário e
       mensagem.decisãoDoUsuário ~= "nenhuma" então
        local regra = mensagem.regraDaTriagem ou "regra pessoal"
        se regra:corte(1, 9) == "endereco:" então
            regra = "endereço: " .. regra:corte(10)
        senão se regra:corte(1, 8) == "dominio:" então
            regra = "domínio: " .. regra:corte(9)
        fim fim
        decisãoPessoal = '<div class="carteiro-triagem-pessoal"><strong>' ..
            'Sua decisão:</strong> ' ..
            util.escapeHTML(mensagem.decisãoDoUsuário) .. ' por ' ..
            util.escapeHTML(regra) .. '. A avaliação automática abaixo ' ..
            'foi preservada.</div>'
    fim
    retorne '<details class="carteiro-triagem"><summary>Avaliação automática: <strong>' ..
        util.escapeHTML(classificação) .. '</strong> · pontuação ' ..
        util.escapeHTML(mensagem.pontuaçãoDeSuspeita ou 0) ..
        '</summary>' .. decisãoPessoal .. lista .. '</details>'
fim

local nomesDaAutenticação = {
    passa = "passou", falha = "falhou", falhaSuave = "falha suave",
    neutro = "neutro", nenhum = "não informado",
    erroTemporário = "erro temporário", erroPermanente = "erro permanente",
    temporário = "erro temporário"
}

local nomesDasAçõesDMARC = {
    aceitar = "aceitar", quarentena = "separar como indesejada",
    rejeitar = "rejeitar", adiar = "adiar temporariamente"
}

local função detalhesDaAutenticação(mensagem)
    se mensagem.direção ~= "entrada" ou não mensagem.resultadoDMARC então
        retorne ""
    fim
    local função nome(valor)
        retorne util.escapeHTML(nomesDaAutenticação[valor] ou valor ou
            "não informado")
    fim
    local política = mensagem.políticaDMARC e
        '<span>Política: <strong>' ..
            util.escapeHTML(mensagem.políticaDMARC) .. '</strong></span>' ou ""
    local ação = mensagem.açãoDMARC e
        '<span>Ação: <strong>' .. util.escapeHTML(
            nomesDasAçõesDMARC[mensagem.açãoDMARC] ou
            mensagem.açãoDMARC) .. '</strong></span>' ou ""
    retorne '<section class="carteiro-autenticação" aria-label="Autenticação postal">' ..
        '<h2>Autenticação postal</h2><div>' ..
        '<span>SPF: <strong>' .. nome(mensagem.resultadoSPF) .. '</strong></span>' ..
        '<span>DKIM: <strong>' .. nome(mensagem.resultadoDKIM) .. '</strong></span>' ..
        '<span>DMARC: <strong>' .. nome(mensagem.resultadoDMARC) .. '</strong></span>' ..
        política .. ação .. '</div></section>'
fim

local função navegaçãoDaCaixa(pastaAtual)
    local itens = {}
    para _, pasta em ipares({ "entrada", "enviadas", "rascunhos",
                              "indesejadas", "lixeira", "todas" }) início
        local classe = pasta == pastaAtual e " ativo" ou ""
        itens[#itens + 1] = '<a class="carteiro-pasta' .. classe .. '" href="/carteiro/' ..
            pasta .. '"><i class="material-icons" aria-hidden="true">' ..
            íconesDasPastas[pasta] .. '</i><span>' .. nomesDasPastas[pasta] .. '</span></a>'
    fim
    local classeDaTriagem = pastaAtual == "triagem" e " ativo" ou ""
    itens[#itens + 1] = '<a class="carteiro-pasta' .. classeDaTriagem ..
        '" href="/carteiro/triagem"><i class="material-icons" ' ..
        'aria-hidden="true">filter_list</i><span>Triagem</span></a>'
    local classeDoConfigurador = pastaAtual == "configurar" e " ativo" ou ""
    itens[#itens + 1] = '<a class="carteiro-pasta' .. classeDoConfigurador ..
        '" href="/carteiro/configurar"><i class="material-icons" ' ..
        'aria-hidden="true">phonelink_setup</i><span>Configurar</span></a>'
    retorne tabela.concatene(itens)
fim

local função opçõesDePastas(mensagem)
    local opções = {}
    local destinos = { "arquivadas", "indesejadas", "lixeira" }
    se mensagem.pasta == "arquivadas" ou mensagem.pasta == "indesejadas" ou
       mensagem.pasta == "lixeira" então
        se mensagem.direção == "entrada" então
            tabela.insira(destinos, 1, "entrada")
        senão se mensagem.direção == "saída" ou mensagem.direção == "saida" então
            tabela.insira(destinos, 1, "enviadas")
        fim fim
    fim
    para _, pasta em ipares(destinos) início
        se pasta ~= mensagem.pasta então
            opções[#opções + 1] = '<option value="' .. pasta .. '">' ..
                nomesDasPastas[pasta] .. '</option>'
        fim
    fim
    retorne tabela.concatene(opções)
fim

