    rascunhos = "Rascunhos",
    arquivadas = "Arquivadas",
    indesejadas = "Indesejadas",
    lixeira = "Lixeira"
}

local íconesDasPastas = {
    entrada = "inbox",
    todas = "mail_outline",
    enviadas = "send",
    rascunhos = "drafts",
    arquivadas = "archive",
    indesejadas = "report",
