    identidade.destino = configuração.inícioCarteiro ou "/"
    identidade.estilo = configuração.estiloCarteiro
    identidade.ícone = configuração.íconeCarteiro
    identidade.corDoTema = configuração.corDoTemaCarteiro ou "#00695c"
