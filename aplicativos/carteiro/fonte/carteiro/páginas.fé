local função controlesDoHTML(usuário, mensagem)
    se mensagem.direção ~= "entrada" então retorne "" fim
    local id = paraColar(mensagem.id)
    local csrf = util.escapeHTML(usuário.csrf)
    se mensagem.falhaDaConfiança então
        retorne '<div class="carteiro-aviso">Não foi possível consultar suas ' ..
            'preferências de confiança. A mensagem formatada permanece bloqueada.</div>'
    fim
    se não mensagem.remetenteConfiável então
        retorne '<div class="carteiro-confiança"><div><strong>Mensagem HTML ' ..
            'protegida</strong><span>Somente a versão em texto inerte é exibida. ' ..
            'Confiar não abre ligações, imagens nem a mensagem formatada.</span></div>' ..
            '<form action="/carteiro/mensagens/' .. id ..
            '/remetente/confiar" method="POST"><input type="hidden" name="csrf" value="' ..
            csrf .. '"><button class="btn-flat teal-text" type="submit">' ..
            'Confiar no remetente</button></form></div>'
    fim
    local exibição
    se mensagem.mostrarConteúdoExterno então
        exibição = '<span class="carteiro-conteúdo-exibido">Conteúdo externo ' ..
            'visível somente nesta abertura.</span>'
    senão se mensagem.mostrarHTML então
        exibição = '<a class="btn amber darken-3" href="/carteiro/mensagens/' ..
            id .. '?mostrarHTML=1&amp;mostrarExterno=1"><i class="material-icons left" ' ..
            'aria-hidden="true">image</i>Mostrar imagens externas</a>'
    senão
        exibição = '<a class="btn amber darken-3" href="/carteiro/mensagens/' ..
            id .. '?mostrarHTML=1"><i class="material-icons left" ' ..
            'aria-hidden="true">visibility</i>Mostrar mensagem formatada</a>'
    fim fim
    retorne '<div class="carteiro-confiança confiável"><div><strong>Remetente ' ..
        'confiável</strong><span>A mensagem continua fechada até sua confirmação. ' ..
        'Imagens externas exigem uma segunda autorização e podem informar ao ' ..
        'remetente que a carta foi aberta.</span></div>' ..
        '<div class="carteiro-confiança-ações">' .. exibição ..
        '<form action="/carteiro/mensagens/' .. id ..
        '/remetente/deixar-de-confiar" method="POST"><input type="hidden" ' ..
        'name="csrf" value="' .. csrf .. '"><button class="btn-flat red-text" ' ..
        'type="submit">Deixar de confiar</button></form></div></div>'
fim

função páginas.mensagem(usuário, caixa, mensagem)
    local anexos = {}
    local imagens = {}
    para _, anexo em ipares(mensagem.anexos ou {}) início
        anexos[#anexos + 1] = '<a class="carteiro-anexo-item" href="/carteiro/mensagens/' ..
            mensagem.id .. '/anexos/' .. anexo.id .. '"><i class="material-icons">attachment</i>' ..
            '<span>' .. util.escapeHTML(anexo.nome) .. '<small>' .. anexo.tamanho ..
            ' tacos · ' .. util.escapeHTML(anexo.tipo) .. '</small></span></a>'
        se util.imagemExibível(anexo.tipo) então
            imagens[#imagens + 1] = '<figure class="carteiro-imagem-no-corpo">' ..
                '<img loading="lazy" src="/carteiro/mensagens/' .. mensagem.id ..
                '/anexos/' .. anexo.id .. '/visualizar" alt="' ..
                util.escapeHTML(anexo.nome) .. '"><figcaption>' ..
                util.escapeHTML(anexo.nome) .. '</figcaption></figure>'
        fim
    fim
    local corpo
    se mensagem.html e mensagem.html ~= "" então
        local alternativa
        se mensagem.texto e mensagem.texto ~= "" então
            alternativa = '<div class="carteiro-texto carteiro-texto-inerte">' ..
                util.escapeHTML(mensagem.texto) .. '</div>'
        senão
            alternativa = '<div class="carteiro-vazio"><p>A carta não possui uma ' ..
                'versão em texto. Confie no remetente e confirme a abertura para ' ..
                'ver a mensagem formatada.</p></div>'
        fim
        corpo = '<section class="carteiro-html-recebido">' ..
            controlesDoHTML(usuário, mensagem)
        se mensagem.mostrarHTML então
            local parâmetros = mensagem.mostrarConteúdoExterno e
                "?mostrar=1&amp;externo=1" ou "?mostrar=1"
            local avisoDoIsolamento = mensagem.mostrarConteúdoExterno e
                'HTML isolado: imagens externas liberadas nesta abertura; programas ' ..
                    'e formulários continuam bloqueados.' ou
                'HTML isolado: ligações podem ser abertas por escolha do usuário; ' ..
                    'imagens externas, programas e formulários permanecem bloqueados.'
            corpo = corpo .. '<div class="carteiro-informação"><i ' ..
                'class="material-icons" aria-hidden="true">verified_user</i><span>' ..
                avisoDoIsolamento .. '</span></div>' ..
                '<iframe class="carteiro-quadro-html" title="Corpo HTML da carta" ' ..
                'sandbox="allow-popups allow-popups-to-escape-sandbox" ' ..
                'referrerpolicy="no-referrer" loading="lazy" ' ..
                'src="/carteiro/mensagens/' .. mensagem.id ..
                '/corpo-html' .. parâmetros .. '"></iframe>' ..
                '<details class="carteiro-texto-alternativo"><summary>Versão em ' ..
                'texto</summary>' .. alternativa .. '</details>'
        senão
            corpo = corpo .. '<div class="carteiro-informação"><i ' ..
                'class="material-icons" aria-hidden="true">link_off</i><span>' ..
                'Ligações e botões da versão HTML permanecem ocultos.</span></div>' ..
                alternativa
        fim
        corpo = corpo .. '</section>'
    senão se mensagem.texto e mensagem.texto ~= "" então
        corpo = '<div class="carteiro-texto">' .. util.escapeHTML(mensagem.texto) .. '</div>'
    senão
        corpo = '<div class="carteiro-vazio"><p>Mensagem sem corpo textual.</p></div>'
    fim fim
    local açõesDaMensagem = '<form action="/carteiro/mensagens/' .. mensagem.id ..
        '/mover" method="POST"><input type="hidden" name="csrf" value="' ..
        util.escapeHTML(usuário.csrf) .. '"><select name="pasta" aria-label="Mover para">' ..
        opçõesDePastas(mensagem) .. '</select>' ..
        '<button class="btn-flat teal-text" type="submit">Mover</button></form>'
    se mensagem.direção == "entrada" então
        local decisão = (mensagem.pasta == "indesejadas" ou
            mensagem.decisãoDoUsuário == "indesejada") e
            "regular" ou "indesejada"
        local rótulo = decisão == "regular" e
            "Não é indesejada" ou "Marcar como indesejada"
        local classe = decisão == "regular" e "teal-text" ou "red-text"
        local açãoDaTriagem = '<form class="carteiro-ação-triagem" ' ..
            'action="/carteiro/mensagens/' .. mensagem.id ..
            '/triagem" method="POST"><input type="hidden" name="csrf" value="' ..
            util.escapeHTML(usuário.csrf) .. '"><input type="hidden" ' ..
            'name="decisão" value="' .. decisão .. '"><button class="btn-flat ' ..
            classe .. '" type="submit"><i class="material-icons left">' ..
            (decisão == "regular" e "mark_email_read" ou "report") ..
            '</i>' .. rótulo .. '</button></form>'
        açõesDaMensagem = '<a class="btn teal" href="/carteiro/mensagens/' ..
            mensagem.id .. '/responder"><i class="material-icons left">reply</i>Responder</a>' ..
            açãoDaTriagem .. açõesDaMensagem
    fim
    açõesDaMensagem = '<a class="btn-flat teal-text" href="/carteiro/mensagens/' ..
        mensagem.id .. '/encaminhar"><i class="material-icons left">forward</i>Encaminhar</a>' ..
        açõesDaMensagem
    local conteúdo = '<article class="carteiro-painel carteiro-mensagem">' ..
        '<div class="carteiro-painel-título"><a href="/carteiro/' .. mensagem.pasta ..
        '"><i class="material-icons">arrow_back</i>Voltar</a>' ..
        '<div class="carteiro-painel-opções">' .. açõesDaMensagem .. '</div></div>' ..
        '<header><h1>' .. util.escapeHTML(mensagem.assunto ~= "" e mensagem.assunto ou "(sem assunto)") ..
        '</h1><p><strong>De:</strong> ' ..
        util.escapeHTML(util.endereçoLegível(mensagem.remetente)) .. '</p>' ..
        '<p><strong>Para:</strong> ' .. util.escapeHTML(junteEndereços(mensagem.destinatários)) .. '</p>' ..
        '<p><strong>Data:</strong> ' .. dataLegível(mensagem.criadaEm) .. '</p>' ..
        '<p><strong>Entrega:</strong> ' .. util.escapeHTML(mensagem.estadoDaEntrega) ..
        '</p>' .. detalhesDaAutenticação(mensagem) ..
        detalhesDaTriagem(mensagem) .. '</header>' ..
        corpo .. (#imagens > 0 e '<section class="carteiro-imagens-no-corpo">' ..
        tabela.concatene(imagens) .. '</section>' ou '') ..
        (#anexos > 0 e '<section class="carteiro-anexos"><h2>Anexos</h2>' ..
        tabela.concatene(anexos) .. '</section>' ou '') .. '</article>'
    retorne páginas.base(usuário, caixa, mensagem.assunto, conteúdo, mensagem.pasta)
fim

-- Leitor 1.4: a interface abaixo substitui a apresentação técnica de uma
-- carta isolada por uma conversa. Os dados de autenticação e Triagem seguem
-- preservados no banco e no PULSO, mas não ocupam o corpo destinado ao leitor.
local função nomeBreveDoRemetente(remetente)
    local valor = util.endereçoLegível(remetente)
    local nome = valor:separe('^%s*"?([^"<]+)"?%s*<')
    se nome e nome:apare() ~= "" então retorne nome:apare() fim
    local arroba = valor:procure("@", 1, verdadeiro)
    se arroba e arroba > 1 então retorne valor:corte(1, arroba - 1) fim
    retorne valor
fim

local função caminhoDaConversa(mensagem, parâmetro, valor)
    local pasta = mensagem.pastaDaConversa ou mensagem.pasta
    local id = mensagem.identificaçãoDaConversa ou mensagem.id
    local caminho = "/carteiro/mensagens/" .. id .. "?pasta=" .. pasta
    se mensagem.posiçãoDaLista e mensagem.totalDaLista então
        caminho = caminho .. "&amp;posicao=" .. mensagem.posiçãoDaLista ..
            "&amp;total=" .. mensagem.totalDaLista
    fim
    se parâmetro então
        caminho = caminho .. "&amp;" .. parâmetro .. "=" ..
            (valor ou mensagem.id)
    fim
    retorne caminho
fim

local função controleCompactoDoHTML(usuário, mensagem)
    se não mensagem.html ou mensagem.html == "" então retorne "" fim
    se mensagem.falhaDaConfiança então
        retorne '<div class="carteiro-html-controle">A formatação não pôde ser verificada.</div>'
    fim
    se não mensagem.remetenteConfiável então
        retorne '<div class="carteiro-html-controle"><span>Formatação bloqueada.</span>' ..
            '<form action="/carteiro/mensagens/' .. mensagem.id ..
            '/remetente/confiar" method="POST"><input type="hidden" name="csrf" value="' ..
            util.escapeHTML(usuário.csrf) .. '"><input type="hidden" name="pasta" value="' ..
            util.escapeHTML(mensagem.pastaDaConversa ou mensagem.pasta) ..
            '"><button class="btn-flat teal-text" type="submit">Confiar no remetente</button></form></div>'
    fim
    se não mensagem.mostrarHTML então
        retorne '<div class="carteiro-html-controle"><span>Formatação oculta.</span>' ..
            '<a href="' .. caminhoDaConversa(mensagem, "mostrarHTML") ..
            '">Mostrar formatação</a></div>'
    fim
    se não mensagem.mostrarConteúdoExterno então
        retorne '<div class="carteiro-html-controle"><span>Imagens externas ocultas.</span>' ..
            '<a href="' .. caminhoDaConversa(mensagem, "mostrarExterno") ..
            '">Mostrar imagens</a></div>'
    fim
    retorne ""
fim

local função corpoCompactoDaCarta(usuário, mensagem)
    local partes = { controleCompactoDoHTML(usuário, mensagem) }
    se mensagem.html e mensagem.html ~= "" e mensagem.mostrarHTML então
        local parâmetros = mensagem.mostrarConteúdoExterno e
            "?mostrar=1&amp;externo=1" ou "?mostrar=1"
        partes[#partes + 1] = '<iframe class="carteiro-quadro-html" ' ..
            'title="Corpo HTML da carta" sandbox="allow-popups ' ..
            'allow-popups-to-escape-sandbox" referrerpolicy="no-referrer" ' ..
            'loading="lazy" src="/carteiro/mensagens/' .. mensagem.id ..
            '/corpo-html' .. parâmetros .. '"></iframe>'
    senão se mensagem.texto e mensagem.texto ~= "" então
        partes[#partes + 1] = '<div class="carteiro-texto">' ..
            util.escapeHTML(mensagem.texto) .. '</div>'
    senão
        partes[#partes + 1] = '<div class="carteiro-vazio carteiro-corpo-vazio">' ..
            '<p>Esta carta não possui texto simples.</p></div>'
    fim fim

    local anexos = {}
    para _, anexo em ipares(mensagem.anexos ou {}) início
        anexos[#anexos + 1] = anexoDaCarta(mensagem.id, anexo)
    fim
    se #anexos > 0 então
        partes[#partes + 1] = '<section class="carteiro-anexos carteiro-anexos-compactos">' ..
            tabela.concatene(anexos) .. '</section>'
    fim
    retorne tabela.concatene(partes)
fim

local função camposDaAção(usuário, mensagem, ação)
    retorne '<input type="hidden" name="csrf" value="' ..
        util.escapeHTML(usuário.csrf) .. '"><input type="hidden" ' ..
        'name="pasta" value="' .. util.escapeHTML(
            mensagem.pastaDaConversa ou mensagem.pasta) ..
        '"><input type="hidden" name="acao" value="' .. ação .. '">'
fim

local função endereçoPuro(valor)
    local legível = util.endereçoLegível(valor):apare()
    local interno = legível:separe("<([^>]+)>")
    retorne (interno ou legível):apare()
fim

local função domínioDoEndereço(valor)
    local endereço = endereçoPuro(valor)
    local arroba = endereço:procure("@", 1, verdadeiro)
    se não arroba então retorne "" fim
    retorne endereço:corte(arroba + 1)
fim

local função dadosDoRemetente(mensagem)
    local endereço = endereçoPuro(mensagem.remetente)
    local nome = util.endereçoLegível(mensagem.remetente)
        :separe('^%s*"?([^"<]+)"?%s*<') ou ""
    nome = nome:apare()
    local nomeDistinto = nome ~= "" e nome:minúscula() ~= endereço:minúscula()
    retorne nome, endereço, nomeDistinto
fim

local função seloDoRemetente(mensagem)
    retorne (mensagem.resultadoDKIM == "passa" ou
        mensagem.resultadoDMARC == "passa") e
        '<i class="material-icons carteiro-remetente-verificado" ' ..
        'title="Identidade postal verificada" aria-label="Identidade ' ..
        'postal verificada">new_releases</i>' ou ""
fim

local função remetenteApresentado(mensagem)
    local nome, endereço, nomeDistinto = dadosDoRemetente(mensagem)
    retorne (nomeDistinto e ('<strong>' .. util.escapeHTML(nome) ..
        '</strong> ') ou '') .. seloDoRemetente(mensagem) .. '<span>&lt;' ..
        util.escapeHTML(endereço) .. '&gt;</span>'
fim

local função remetenteRecolhido(mensagem)
    local nome, endereço, nomeDistinto = dadosDoRemetente(mensagem)
    local principal = nomeDistinto e nome ou endereço
    retorne '<strong>' .. util.escapeHTML(principal) .. '</strong>' ..
        seloDoRemetente(mensagem)
fim

local função resumoDosDestinatários(caixa, mensagem)
    local endereçoDaCaixa = endereçoPuro(caixa.endereço):minúscula()
    local recebeu = falso
    local outros = {}
    para _, chave em ipares({ "para", "cópia", "cópiaOculta" }) início
        para _, valor em ipares((mensagem.destinatários ou {})[chave] ou {}) início
            local endereço = endereçoPuro(valor)
            se endereço:minúscula() == endereçoDaCaixa então
                recebeu = verdadeiro
            senão
                outros[#outros + 1] = nomeBreveDoRemetente(valor)
            fim
        fim
    fim
    se recebeu então
        retorne "para mim" .. (#outros > 0 e
            (", " .. tabela.concatene(outros, ", ")) ou "")
    fim
    local todos = junteEndereços(mensagem.destinatários)
    retorne todos ~= "" e ("para " .. todos) ou "destinatários não informados"
fim

local função linhaDosDetalhes(rótulo, valor)
    valor = paraColar(valor ou ""):apare()
    se valor == "" então retorne "" fim
    retorne '<div><dt>' .. util.escapeHTML(rótulo) .. '</dt><dd>' ..
        util.escapeHTML(valor) .. '</dd></div>'
fim

local função nomeDaAutenticação(valor)
    retorne nomesDaAutenticação[valor] ou valor ou "não informado"
fim

local função detalhesDaCarta(caixa, mensagem)
    local enviadoPor = domínioDoEndereço(mensagem.remetenteEnvelope)
    local assinadoPor = mensagem.resultadoDKIM == "passa" e
        (mensagem.domínioDoAutor ou domínioDoEndereço(mensagem.remetente)) ou ""
    local autenticação = "SPF: " .. nomeDaAutenticação(
        mensagem.resultadoSPF) .. "; DKIM: " .. nomeDaAutenticação(
        mensagem.resultadoDKIM) .. "; DMARC: " .. nomeDaAutenticação(
        mensagem.resultadoDMARC)
    se mensagem.açãoDMARC então
        autenticação = autenticação .. "; ação: " ..
            (nomesDasAçõesDMARC[mensagem.açãoDMARC] ou
                mensagem.açãoDMARC)
    fim
    local triagem = (mensagem.classificaçãoDaTriagem ou "regular") ..
        "; pontuação " .. paraColar(mensagem.pontuaçãoDeSuspeita ou 0)
    se mensagem.decisãoDoUsuário e
       mensagem.decisãoDoUsuário ~= "nenhuma" então
        triagem = triagem .. "; decisão pessoal: " ..
            mensagem.decisãoDoUsuário
    fim
    retorne '<details class="carteiro-carta-detalhes" data-não-alternar>' ..
        '<summary>' .. util.escapeHTML(resumoDosDestinatários(caixa, mensagem)) ..
        '<i class="material-icons" aria-hidden="true">arrow_drop_down</i>' ..
        '</summary><dl>' ..
        linhaDosDetalhes("de:", util.endereçoLegível(mensagem.remetente)) ..
        linhaDosDetalhes("a:", junteEndereços(mensagem.destinatários)) ..
        linhaDosDetalhes("data:", dataLegível(mensagem.criadaEm)) ..
        linhaDosDetalhes("assunto:", mensagem.assunto) ..
        linhaDosDetalhes("Message-ID:", mensagem.identificação) ..
        linhaDosDetalhes("envelope SMTP:",
            util.endereçoLegível(mensagem.remetenteEnvelope)) ..
        linhaDosDetalhes("enviado por:", enviadoPor) ..
        linhaDosDetalhes("assinado por:", assinadoPor) ..
        linhaDosDetalhes("autenticação:", autenticação) ..
        linhaDosDetalhes("política DMARC:", mensagem.políticaDMARC) ..
        linhaDosDetalhes("Triagem:", triagem) ..
        '</dl></details>'
fim

local função ferramentasDaCarta(usuário, mensagem)
    local id = mensagem.id
    local itens = {
        '<a href="/carteiro/mensagens/' .. id .. '/responder">Responder</a>',
        '<a href="/carteiro/mensagens/' .. id .. '/encaminhar">Encaminhar</a>',
        '<form action="/carteiro/mensagens/' .. id ..
            '/acao" method="POST">' .. camposDaAção(
                usuário, mensagem, "excluir") ..
            '<button type="submit">Excluir</button></form>',
        '<form action="/carteiro/mensagens/' .. id ..
            '/acao" method="POST">' .. camposDaAção(
                usuário, mensagem, "não-lida-daqui") ..
            '<button type="submit">Marcar como não lidas a partir daqui</button></form>'
    }
    se mensagem.direção == "entrada" então
        local nome = util.escapeHTML(nomeBreveDoRemetente(mensagem.remetente))
        itens[#itens + 1] = '<form action="/carteiro/mensagens/' .. id ..
            '/acao" method="POST">' .. camposDaAção(
                usuário, mensagem, "bloquear") ..
            '<button type="submit">Bloquear &ldquo;' .. nome .. '&rdquo;</button></form>'
        itens[#itens + 1] = '<form action="/carteiro/mensagens/' .. id ..
            '/acao" method="POST">' .. camposDaAção(
                usuário, mensagem, "indesejada") ..
            '<button type="submit">Denunciar Indesejada</button></form>'
        itens[#itens + 1] = '<form action="/carteiro/mensagens/' .. id ..
            '/acao" method="POST">' .. camposDaAção(
                usuário, mensagem, "fisgada") ..
            '<button type="submit">Denunciar Fisgada</button></form>'
        itens[#itens + 1] = '<a href="/carteiro/todas?busca=' ..
            util.codifiquePercentual(mensagem.remetente) ..
            '">Filtrar as mensagens assim</a>'
    fim
    itens[#itens + 1] = '<a href="/carteiro/mensagens/' .. id ..
        '/imprimir" target="_blank" rel="noopener" data-imprimir-carta>' ..
        'Imprimir</a>'
    itens[#itens + 1] = '<a href="/carteiro/mensagens/' .. id ..
        '/baixar">Baixar mensagem</a>'
    itens[#itens + 1] = '<a href="/carteiro/mensagens/' .. id ..
        '/original" target="_blank" rel="noopener noreferrer">Mostrar original</a>'
    retorne '<div class="carteiro-carta-ferramentas" data-não-alternar>' ..
        '<a class="carteiro-botão-ícone" href="/carteiro/mensagens/' .. id ..
        '/responder" title="Responder" aria-label="Responder"><i ' ..
        'class="material-icons">reply</i></a><a class="carteiro-botão-ícone" ' ..
        'href="/carteiro/mensagens/' .. id .. '/encaminhar" title="Encaminhar" ' ..
        'aria-label="Encaminhar"><i class="material-icons">forward</i></a>' ..
        '<details class="carteiro-menu carteiro-menu-carta"><summary ' ..
        'class="carteiro-botão-ícone" title="Mais" aria-label="Mais ações">' ..
        '<i class="material-icons">more_vert</i></summary><div ' ..
        'class="carteiro-menu-conteúdo">' .. tabela.concatene(itens) ..
        '</div></details></div>'
fim

local função cartãoDaConversa(usuário, caixa, mensagem)
    local fixa = mensagem.últimaDaConversa == verdadeiro
    local aberta = fixa ou mensagem.aberta == verdadeiro
    local classeDaIdentidade = fixa e "carteiro-carta-identidade" ou
        "carteiro-carta-alternador"
    local atributosDaIdentidade = fixa e "" ou
        (' role="button" tabindex="0" data-alternar-carta aria-expanded="' ..
            (aberta e "true" ou "false") .. '"')
    retorne '<article class="carteiro-carta-conversa' ..
        (aberta e ' aberta' ou '') .. '" data-carta-conversa="' ..
        mensagem.id .. '"' .. (fixa e ' data-carta-fixa' ou '') ..
        '><header><div class="' .. classeDaIdentidade .. '"' ..
        atributosDaIdentidade .. '><span class="carteiro-avatar" ' ..
        'aria-hidden="true">' .. util.escapeHTML(
            nomeBreveDoRemetente(mensagem.remetente):corte(1, 1):maiúscula()) ..
        '</span><span class="carteiro-carta-resumo"><span ' ..
        'class="carteiro-remetente carteiro-remetente-aberto">' ..
        remetenteApresentado(mensagem) .. '</span><span ' ..
        'class="carteiro-remetente carteiro-remetente-recolhido">' ..
        remetenteRecolhido(mensagem) .. '</span><span ' ..
        'class="carteiro-carta-data carteiro-carta-data-aberta">' ..
        dataDetalhada(mensagem.criadaEm) .. '</span><span ' ..
        'class="carteiro-carta-data carteiro-carta-data-recolhida">' ..
        dataResumida(mensagem.criadaEm) .. '</span>' ..
        detalhesDaCarta(caixa, mensagem) .. '<small ' ..
        'class="carteiro-carta-prévia">' ..
        util.escapeHTML(mensagem.resumo ou "") .. '</small></span></div>' ..
        ferramentasDaCarta(usuário, mensagem) ..
        '</header><div class="carteiro-carta-corpo" data-corpo-carta' ..
        (aberta e '' ou ' hidden') .. '>' ..
        corpoCompactoDaCarta(usuário, mensagem) ..
        '</div></article>'
fim

local função botãoDaConversa(usuário, id, pasta, ação, ícone, rótulo)
    retorne '<form action="/carteiro/conversas/' .. id ..
        '/acao" method="POST"><input type="hidden" name="csrf" value="' ..
        util.escapeHTML(usuário.csrf) .. '"><input type="hidden" name="pasta" value="' ..
        pasta .. '"><input type="hidden" name="acao" value="' .. ação ..
        '"><button class="carteiro-botão-ícone" type="submit" title="' ..
        rótulo .. '" aria-label="' .. rótulo .. '"><i class="material-icons">' ..
        ícone .. '</i></button></form>'
fim

local função itemDaConversa(usuário, id, pasta, ação, rótulo)
    retorne '<form action="/carteiro/conversas/' .. id ..
        '/acao" method="POST"><input type="hidden" name="csrf" value="' ..
        util.escapeHTML(usuário.csrf) .. '"><input type="hidden" name="pasta" value="' ..
        pasta .. '"><input type="hidden" name="acao" value="' .. ação ..
        '"><button type="submit">' .. rótulo .. '</button></form>'
fim

local função menuMoverDaConversa(usuário, id, pasta)
    local itens = {}
    se pasta ~= "arquivadas" então
        itens[#itens + 1] = itemDaConversa(usuário, id, pasta,
            "mover:arquivadas", "Todas (arquivar)")
    fim
    se pasta ~= "indesejadas" então
        itens[#itens + 1] = itemDaConversa(usuário, id, pasta,
            "mover:indesejadas", "Indesejadas")
    fim
    se pasta ~= "lixeira" então
        itens[#itens + 1] = itemDaConversa(usuário, id, pasta,
            "mover:lixeira", "Lixeira")
    fim
    se pasta == "lixeira" então
        itens[#itens + 1] = itemDaConversa(usuário, id, pasta,
            "restaurar", "Restaurar na caixa principal")
    fim
    retorne '<details class="carteiro-menu carteiro-menu-conversa" ' ..
        'data-não-alternar><summary class="carteiro-botão-ícone" ' ..
        'title="Mover para" aria-label="Mover a conversa para"><i ' ..
        'class="material-icons">move_to_inbox</i></summary><div ' ..
        'class="carteiro-menu-conteúdo">' .. tabela.concatene(itens) ..
        '</div></details>'
fim

função páginas.conversa(usuário, caixa, mensagens, pasta, identificação,
                           posição, total)
    mensagens = mensagens ou {}
    local última = mensagens[#mensagens] ou {}
    local assunto = assuntoLegívelDaConversa(última.assunto)
    local cartões = {}
    local algumaAnteriorAberta, algumaAnteriorFechada = falso, falso
    para índice, mensagem em ipares(mensagens) início
        mensagem.últimaDaConversa = índice == #mensagens
        se não mensagem.últimaDaConversa então
            se mensagem.aberta então
                algumaAnteriorAberta = verdadeiro
            senão
                algumaAnteriorFechada = verdadeiro
            fim
        fim
        cartões[#cartões + 1] = cartãoDaConversa(usuário, caixa, mensagem)
    fim

    local ações
    se pasta == "lixeira" então
        ações = botãoDaConversa(usuário, identificação, pasta,
            "restaurar", "restore_from_trash", "Restaurar em Todas")
    senão
        ações = botãoDaConversa(usuário, identificação, pasta,
            "arquivar", "archive", "Arquivar") ..
            botãoDaConversa(usuário, identificação, pasta,
                "indesejada", "report", "Indesejada") ..
            botãoDaConversa(usuário, identificação, pasta,
                "excluir", "delete", "Descartar") ..
            botãoDaConversa(usuário, identificação, pasta,
                "não-lida", "markunread", "Marcar como não lida")
    fim

    local mover = menuMoverDaConversa(usuário, identificação, pasta)
    local itensDoMenu =
        itemDaConversa(usuário, identificação, pasta,
            "arquivar", "Arquivar") ..
        itemDaConversa(usuário, identificação, pasta,
            "indesejada", "Indesejada") ..
        itemDaConversa(usuário, identificação, pasta,
            "excluir", "Descartar") ..
        itemDaConversa(usuário, identificação, pasta,
            "não-lida", "Marcar como não lida") ..
        '<a href="/carteiro/todas?busca=' ..
            util.codifiquePercentual(assunto) .. '">Filtrar mensagens assim</a>' ..
        '<a href="/carteiro/conversas/' .. identificação ..
            '/encaminhar?pasta=' .. pasta .. '">Encaminhar tudo</a>'
    local menu = '<details class="carteiro-menu carteiro-menu-conversa" ' ..
        'data-não-alternar><summary class="carteiro-botão-ícone" title="Mais" ' ..
        'aria-label="Mais ações da conversa"><i class="material-icons">' ..
        'more_vert</i></summary><div class="carteiro-menu-conteúdo">' ..
        itensDoMenu .. '</div></details>'

    local controlesDeExpansão = ""
    se #mensagens > 1 então
        controlesDeExpansão = '<button class="carteiro-botão-ícone" ' ..
            'type="button" data-expandir-conversa' ..
            (algumaAnteriorFechada e '' ou ' hidden') ..
            ' title="Expandir anteriores" ' ..
            'aria-label="Expandir todas as cartas anteriores"><i ' ..
            'class="material-icons">unfold_more</i></button><button ' ..
            'class="carteiro-botão-ícone" type="button" ' ..
            'data-recolher-conversa' ..
            (algumaAnteriorAberta e '' ou ' hidden') ..
            ' title="Recolher anteriores" ' ..
            'aria-label="Recolher todas as cartas anteriores"><i ' ..
            'class="material-icons">unfold_less</i></button>'
    fim

    local paginação = ""
    posição, total = paraNúmero(posição), paraNúmero(total)
    se posição e total e posição > 0 e total > 0 e posição <= total então
        paginação = '<span class="carteiro-conversa-paginação">' ..
            númeroLegível(posição) .. ' de ' .. númeroLegível(total) .. '</span>'
    fim

    local rodapé = ""
    se última.id então
        rodapé = '<footer class="carteiro-conversa-rodapé" ' ..
            'aria-label="Ações ao final da conversa"><a class="btn-flat ' ..
            'carteiro-conversa-rodapé-botão" href="/carteiro/mensagens/' ..
            última.id .. '/responder"><i class="material-icons">reply</i>' ..
            'Responder</a><a class="btn-flat ' ..
            'carteiro-conversa-rodapé-botão" href="/carteiro/mensagens/' ..
            última.id .. '/encaminhar"><i class="material-icons">forward</i>' ..
            'Encaminhar</a></footer>'
    fim

    local conteúdo = '<section class="carteiro-painel carteiro-conversa">' ..
        '<div class="carteiro-painel-título carteiro-conversa-ferramentas">' ..
        '<div class="carteiro-conversa-ações"><a class="carteiro-botão-ícone" ' ..
        'href="/carteiro/' .. pasta .. '" title="Voltar" aria-label="Voltar">' ..
        '<i class="material-icons">arrow_back</i></a>' .. ações .. mover ..
        menu .. '</div>' .. paginação .. '</div><header ' ..
        'class="carteiro-conversa-título"><div><h1>' ..
        util.escapeHTML(assunto) .. '</h1><span>' .. #mensagens ..
        (#mensagens == 1 e ' carta' ou ' cartas') .. '</span></div><div ' ..
        'class="carteiro-conversa-controles" ' ..
        'aria-label="Controles da conversa">' .. controlesDeExpansão ..
        '<a class="carteiro-botão-ícone" href="/carteiro/conversas/' ..
        identificação .. '/imprimir?pasta=' .. pasta .. '" target="_blank" ' ..
        'rel="noopener" data-imprimir-carta title="Imprimir tudo" ' ..
        'aria-label="Imprimir toda a conversa"><i class="material-icons">' ..
        'print</i></a></div></header>' ..
        '<div class="carteiro-conversa-cartas">' .. tabela.concatene(cartões) ..
        '</div>' .. rodapé .. '</section>'
    retorne páginas.base(usuário, caixa, assunto, conteúdo, pasta)
fim

local função textoParaImpressão(mensagem)
    local texto = paraColar(mensagem.texto ou "")
    se texto ~= "" então retorne texto fim
    texto = paraColar(mensagem.html ou "")
        :troque("<[Bb][Rr]%s*/?>", "\n")
        :troque("</[Pp]%s*>", "\n\n")
        :troque("</[Dd][Ii][Vv]%s*>", "\n")
        :troque("<[^>]+>", "")
        :troque("&nbsp;", " ")
        :troque("&lt;", "<")
        :troque("&gt;", ">")
        :troque("&quot;", '"')
        :troque("&#39;", "'")
        :troque("&amp;", "&")
    retorne texto:apare()
fim

função páginas.impressão(mensagens, título)
    se tipo(mensagens) ~= "tabela" ou mensagens.id então
        mensagens = { mensagens }
    fim
    mensagens = mensagens ou {}
    título = assuntoLegívelDaConversa(título ou
        ((mensagens[#mensagens] ou {}).assunto))
    local cartas = {}
    para _, mensagem em ipares(mensagens) início
        local anexos = {}
        para _, anexo em ipares(mensagem.anexos ou {}) início
            anexos[#anexos + 1] = '<li>' .. util.escapeHTML(anexo.nome) ..
                ' <small>(' .. tamanhoLegível(anexo.tamanho) .. '; ' ..
                util.escapeHTML(anexo.tipo) .. ')</small></li>'
        fim
        local listaDeAnexos = #anexos > 0 e
            ('<section><h3>Anexos</h3><ul>' .. tabela.concatene(anexos) ..
                '</ul></section>') ou ""
        cartas[#cartas + 1] = '<article><header><strong>' ..
            util.escapeHTML(util.endereçoLegível(mensagem.remetente)) ..
            '</strong><time>' .. util.escapeHTML(dataLegível(
                mensagem.criadaEm)) .. '</time><p><b>Para:</b> ' ..
            util.escapeHTML(junteEndereços(mensagem.destinatários)) ..
            '</p></header><pre>' .. util.escapeHTML(
                textoParaImpressão(mensagem)) .. '</pre>' ..
            listaDeAnexos .. '</article>'
    fim
    retorne '<!doctype html><html lang="pt-BR"><head><meta charset="utf-8">' ..
        '<meta name="viewport" content="width=device-width,initial-scale=1">' ..
        '<title>' .. util.escapeHTML(título) .. '</title><style>' ..
        '@page{margin:18mm}*{box-sizing:border-box}body{margin:0;color:#202124;' ..
        'font:14px/1.55 Arial,sans-serif}main{max-width:900px;margin:auto}' ..
        'h1{font-size:24px;margin:0 0 24px}article{border-top:1px solid #dadce0;' ..
        'padding:18px 0}article header{position:relative;padding-right:180px}' ..
        'article header strong{font-size:15px}article header time{position:absolute;' ..
        'right:0;top:0;color:#5f6368}article header p{margin:3px 0;color:#5f6368}' ..
        'pre{margin:20px 0 0;white-space:pre-wrap;overflow-wrap:anywhere;' ..
        'font:14px/1.6 Arial,sans-serif}h3{font-size:14px;margin-bottom:4px}' ..
        'ul{margin-top:4px;padding-left:20px}small{color:#5f6368}' ..
        '@media(max-width:560px){article header{padding-right:0}article header time{' ..
        'position:static;display:block;margin-top:3px}}@media print{main{max-width:none}}' ..
        '</style></head><body><main><h1>' .. util.escapeHTML(título) ..
        '</h1>' .. tabela.concatene(cartas) .. '</main></body></html>'
fim

-- Mantém o contrato de quem ainda chama o leitor com uma carta única.
função páginas.mensagem(usuário, caixa, mensagem)
    mensagem.aberta = verdadeiro
    mensagem.pastaDaConversa = mensagem.pasta
    mensagem.identificaçãoDaConversa = mensagem.id
    retorne páginas.conversa(usuário, caixa, { mensagem },
        mensagem.pasta, mensagem.id)
fim

função páginas.erro(usuário, caixa, título, mensagem, código)
    local conteúdo = '<section class="carteiro-painel carteiro-erro"><i class="material-icons">error_outline</i>' ..
        '<h1>' .. util.escapeHTML(título) .. '</h1><p>' .. util.escapeHTML(mensagem) ..
        '</p><a href="/carteiro/entrada">Voltar à caixa de entrada</a></section>'
    retorne páginas.base(usuário, caixa, título, conteúdo), código
fim

