local função dataLegível(carimbo)
    se não carimbo ou carimbo == 0 então retorne "" fim
    retorne so.data("%d/%m/%Y %H:%M", carimbo)
fim

local meses = { "Janeiro", "Fevereiro", "Março", "Abril", "Maio",
    "Junho", "Julho", "Agosto", "Setembro", "Outubro", "Novembro",
    "Dezembro" }
local mesesCurtos = { "jan.", "fev.", "mar.", "abr.", "mai.", "jun.",
    "jul.", "ago.", "set.", "out.", "nov.", "dez." }
local diasCurtos = { "dom.", "seg.", "ter.", "qua.", "qui.", "sex.",
    "sáb." }

local função tempoRelativo(carimbo)
    local agora = so.tempo()
    local diferença = mat.máximo(0, agora - carimbo)
    local dias = mat.piso(diferença / 86400)
    se diferença < 60 então retorne "agora"
    senão se diferença < 3600 então
        local minutos = mat.máximo(1, mat.piso(diferença / 60))
        retorne "há " .. minutos .. (minutos == 1 e " minuto" ou " minutos")
    senão se diferença < 86400 então
        local horas = mat.máximo(1, mat.piso(diferença / 3600))
        retorne "há " .. horas .. (horas == 1 e " hora" ou " horas")
    fim fim fim
    retorne "há " .. dias .. (dias == 1 e " dia" ou " dias")
fim

local função dataRelativa(carimbo)
    se não carimbo ou carimbo == 0 então retorne "" fim
    local agora = so.tempo()
    local diferença = mat.máximo(0, agora - carimbo)
    local principal
    se diferença < 86400 então
        principal = so.data("%H:%M", carimbo)
    senão
        local mês = paraNúmero(so.data("%m", carimbo)) ou 1
        principal = paraNúmero(so.data("%d", carimbo)) .. "/" .. meses[mês]
        se so.data("%Y", carimbo) ~= so.data("%Y", agora) então
            principal = principal .. "/" .. so.data("%Y", carimbo)
        fim
    fim
    retorne '<time datetime="' .. so.data("%Y-%m-%dT%H:%M:%S", carimbo) ..
        '" title="' .. dataLegível(carimbo) .. '">' .. principal ..
        ' <small>(' .. tempoRelativo(carimbo) .. ')</small></time>'
fim

local função dataDetalhada(carimbo)
    se não carimbo ou carimbo == 0 então retorne "" fim
    local mês = paraNúmero(so.data("%m", carimbo)) ou 1
    local texto = paraNúmero(so.data("%d", carimbo)) .. " de " ..
        mesesCurtos[mês] .. " de " .. so.data("%Y, %H:%M", carimbo)
    retorne '<time datetime="' .. so.data("%Y-%m-%dT%H:%M:%S", carimbo) ..
        '" title="' .. dataLegível(carimbo) .. '">' .. texto ..
        ' <small>(' .. tempoRelativo(carimbo) .. ')</small></time>'
fim

local função dataResumida(carimbo)
    se não carimbo ou carimbo == 0 então retorne "" fim
    local agora = so.tempo()
    local mês = paraNúmero(so.data("%m", carimbo)) ou 1
    local diaDaSemana = (paraNúmero(so.data("%w", carimbo)) ou 0) + 1
    local texto = diasCurtos[diaDaSemana] .. ", " ..
        paraNúmero(so.data("%d", carimbo)) .. " de " ..
        mesesCurtos[mês]
    se so.data("%Y", carimbo) ~= so.data("%Y", agora) então
        texto = texto .. " de " .. so.data("%Y", carimbo)
    fim
    texto = texto .. ", " .. so.data("%H:%M", carimbo)
    retorne '<time datetime="' .. so.data("%Y-%m-%dT%H:%M:%S", carimbo) ..
        '" title="' .. dataLegível(carimbo) .. '">' .. texto ..
        ' <small>(' .. tempoRelativo(carimbo) .. ')</small></time>'
fim

local função tamanhoLegível(tamanho)
    tamanho = paraNúmero(tamanho) ou 0
    se tamanho >= 1048576 então
        retorne colar.formate("%.1f MB", tamanho / 1048576)
    fim
    se tamanho >= 1024 então
        retorne colar.formate("%.1f KB", tamanho / 1024)
    fim
    retorne tamanho .. " B"
fim

local função assuntoLegívelDaConversa(assunto)
    assunto = util.apare(assunto)
    local prefixos = { "resposta:", "encaminhada:", "re:", "fwd:",
        "fw:", "enc:" }
    enquanto assunto ~= "" início
        local minúsculo = assunto:minúscula()
        local retirou = falso
        para _, prefixo em ipares(prefixos) início
            se minúsculo:corte(1, #prefixo) == prefixo então
                assunto = assunto:corte(#prefixo + 1):apare()
                retirou = verdadeiro
                pare
            fim
        fim
        se não retirou então pare fim
    fim
    retorne assunto ~= "" e assunto ou "(sem assunto)"
fim

local função númeroLegível(valor)
    local texto = paraColar(mat.paraInteiro(valor) ou 0)
    local partes = {}
    enquanto #texto > 3 início
        tabela.insira(partes, 1, texto:corte(#texto - 2))
        texto = texto:corte(1, #texto - 3)
    fim
    tabela.insira(partes, 1, texto)
    retorne tabela.concatene(partes, ".")
fim

local função junteEndereços(valor)
    se tipo(valor) ~= "tabela" então retorne util.endereçoLegível(valor) fim
    local partes = {}
    para _, chave em ipares({ "para", "cópia", "cópiaOculta" }) início
        local lista = valor[chave]
        se tipo(lista) == "tabela" então
            para _, endereço em ipares(lista) início
                partes[#partes + 1] = util.endereçoLegível(endereço)
            fim
        fim
    fim
    retorne tabela.concatene(partes, ", ")
fim

local função participantesDaConversa(mensagem, interlocutor)
    local participantes = mensagem.remetentesNaConversa
    se tipo(participantes) ~= "tabela" ou #participantes == 0 então
        retorne interlocutor
    fim
    local legíveis = {}
    para _, participante em ipares(participantes) início
        legíveis[#legíveis + 1] = util.endereçoLegível(participante)
    fim
    retorne tabela.concatene(legíveis, ", ")
fim

local função tipoBreveDoAnexo(tipo, nome)
    tipo = paraColar(tipo ou ""):minúscula()
    se tipo == "application/pdf" então retorne "PDF" fim
    se tipo == "image/svg+xml" então retorne "SVG" fim
    se tipo == "image/png" então retorne "PNG" fim
    se tipo == "image/jpeg" então retorne "JPG" fim
    se tipo == "image/gif" então retorne "GIF" fim
    se tipo == "image/webp" então retorne "WEBP" fim
    local extensão = paraColar(nome ou ""):separe("%.([^%.]+)$")
    se extensão e #extensão <= 8 então retorne extensão:maiúscula() fim
    retorne "ARQUIVO"
fim

