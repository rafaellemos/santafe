    ap.rota("GET", "/carteiro/mensagens/:id", função(req, res)
        comCaixa(req, res, função(usuário, caixa)
            local id = util.idNatural(req.parâmetros.id)
            se não id então mostreErro(res, usuário, caixa, 404,
                "Mensagem não encontrada", "Identificação inválida."); retorne fim
            carteiro:obtenhaCarta(caixa, id, função(referência, falha)
                se falha então mostreErro(res, usuário, caixa, 503,
                    "Mensagem indisponível", falha); retorne fim
                se não referência então mostreErro(res, usuário, caixa, 404,
                    "Mensagem não encontrada", "Ela não existe nesta caixa."); retorne fim
                local consulta = req.consulta ou {}
                local pasta = pastas[consulta.pasta] e consulta.pasta ou
                    referência.pasta
                carteiro:listeCartasDaConversa(caixa, pasta, id,
                    função(mensagens, falhaDaConversa)
                        se falhaDaConversa então
                            mostreErro(res, usuário, caixa, 503,
                                "Conversa indisponível", falhaDaConversa)
                            retorne
                        fim
                        se #mensagens == 0 então
                            mostreErro(res, usuário, caixa, 404,
                                "Conversa não encontrada",
                                "Ela não pertence a esta pasta.")
                            retorne
                        fim
                        local mostrarHTML = paraColar(consulta.mostrarHTML ou "")
                        local mostrarExterno =
                            paraColar(consulta.mostrarExterno ou "")
                        local função apresente()
                            para índice, mensagem em ipares(mensagens) início
                                local identificador = paraColar(mensagem.id)
                                mensagem.aberta = índice == #mensagens ou
                                    mostrarHTML == identificador ou
                                    mostrarExterno == identificador
                                mensagem.pastaDaConversa = pasta
                                mensagem.identificaçãoDaConversa = id
                                mensagem.posiçãoDaLista = consulta.posicao
                                mensagem.totalDaLista = consulta.total
                            fim
                            enviePágina(res, 200,
                                páginas.conversa(usuário, caixa, mensagens,
                                    pasta, id, consulta.posicao, consulta.total))
                        fim
                        local função prepare(índice)
                            se índice > #mensagens então
                                local nãoLidas = {}
                                para _, mensagem em ipares(mensagens) início
                                    se não mensagem.lida então
                                        nãoLidas[#nãoLidas + 1] = mensagem.id
                                        mensagem.lida = verdadeiro
                                    fim
                                fim
                                se #nãoLidas == 0 então apresente(); retorne fim
                                carteiro:marqueCartasLidas(caixa, nãoLidas,
                                    função(_, falhaDaLeitura)
                                        se falhaDaLeitura então
                                            mostreErro(res, usuário, caixa, 503,
                                                "Conversa indisponível",
                                                falhaDaLeitura)
                                            retorne
                                        fim
                                        apresente()
                                    fim)
                                retorne
                            fim
                            local mensagem = mensagens[índice]
                            local identificador = paraColar(mensagem.id)
                            local pediuHTML = mostrarHTML == identificador ou
                                (mostrarHTML == "1" e mensagem.id == id)
                            local pediuExterno =
                                mostrarExterno == identificador ou
                                (mostrarExterno == "1" e mensagem.id == id)
                            se mensagem.direção ~= "entrada" então
                                mensagem.remetenteConfiável = verdadeiro
                                mensagem.mostrarHTML = pediuHTML ou pediuExterno
                                mensagem.mostrarConteúdoExterno =
                                    mensagem.mostrarHTML e pediuExterno
                                prepare(índice + 1)
                                retorne
                            fim
                            carteiro:remetenteConfiável(caixa,
                                mensagem.remetente,
                                função(confiável, falhaDaConfiança)
                                    mensagem.remetenteConfiável =
                                        confiável == verdadeiro
                                    mensagem.falhaDaConfiança = falhaDaConfiança
                                    mensagem.mostrarHTML =
                                        mensagem.remetenteConfiável e
                                        (pediuHTML ou pediuExterno)
                                    mensagem.mostrarConteúdoExterno =
                                        mensagem.mostrarHTML e pediuExterno
                                    prepare(índice + 1)
                                fim)
                        fim
                        prepare(1)
                    fim)
            fim)
        fim)
    fim)

