                se falha então
                    util.protejaCartaHTML(res)
                    res:código(503):html("<!doctype html><meta charset=\"utf-8\">" ..
                        "<p>Corpo HTML temporariamente indisponível.</p>")
                    retorne
                fim
                se não mensagem ou não mensagem.html ou mensagem.html == "" então
                    util.protejaCartaHTML(res)
                    res:código(404):html("<!doctype html><meta charset=\"utf-8\">" ..
                        "<p>Esta carta não possui uma versão HTML.</p>")
                    retorne
                fim
                local consulta = req.consulta ou {}
                local pediuExibição = consulta.mostrar == "1"
                local pediuConteúdoExterno =
                    pediuExibição e consulta.externo == "1"
                se não pediuExibição então
                    util.protejaCartaHTML(res)
                    res:código(403):html("<!doctype html><meta charset=\"utf-8\">" ..
                        "<p>A mensagem formatada permanece protegida.</p>")
                    retorne
                fim
                se mensagem.direção ~= "entrada" então
                    util.protejaCartaHTML(res, pediuConteúdoExterno)
                    res:código(200):html(util.prepareCartaHTML(mensagem.html))
                    retorne
                fim
                carteiro:remetenteConfiável(caixa, mensagem.remetente,
                    função(confiável)
