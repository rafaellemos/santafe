    ap.rota("POST", "/carteiro/enviar", função(req, res)
        comCaixa(req, res, função(usuário, caixa)
            se req.falhaDoForm então
                enviePágina(res, 400, páginas.compositor(
                    usuário, caixa, {}, req.falhaDoForm)); retorne
            fim
            local formulário = req.form ou {}
            se não util.confiraCSRF(usuário, formulário, segredo) então
                mostreErro(res, usuário, caixa, 403, "Pedido recusado",
                    "O formulário expirou ou não pertence a esta sessão.")
                retorne
            fim
            local destinatáriosPrincipais, falha = util.separeEndereços(
                formulário["para"], configuração.limiteDestinatários)
            local cópia, falhaDaCópia = util.separeEndereços(
                formulário.cópia, configuração.limiteDestinatários)
            local cópiaOculta, falhaDaCópiaOculta = util.separeEndereços(
                formulário.cópiaOculta, configuração.limiteDestinatários)
            falha = falha ou falhaDaCópia ou falhaDaCópiaOculta
            local valores = {
                ["para"] = formulário["para"], cópia = formulário.cópia,
                cópiaOculta = formulário.cópiaOculta,
                assunto = formulário.assunto, texto = formulário.texto,
                html = formulário.html,
                respostaA = formulário.respostaA,
                respondendo = util.apare(formulário.respostaA) ~= "",
                encaminharDe = formulário.encaminharDe,
                encaminhando = util.apare(formulário.encaminharDe) ~= ""
            }
            se falha ou não destinatáriosPrincipais ou #destinatáriosPrincipais == 0 então
                enviePágina(res, 400, páginas.compositor(
                    usuário, caixa, valores, falha ou "Informe ao menos um destinatário."))
                retorne
            fim
            se #destinatáriosPrincipais + #cópia + #cópiaOculta > configuração.limiteDestinatários então
                enviePágina(res, 400, páginas.compositor(
                    usuário, caixa, valores, "Destinatários demais.")); retorne
            fim
            local htmlInformado = paraColar(formulário.html ou "")
            se #htmlInformado > 2000000 então
                enviePágina(res, 413, páginas.compositor(
                    usuário, caixa, valores,
                    "A mensagem formatada excede o limite permitido.")); retorne
            fim
            local htmlSeguro = util.htmlSeguroDoCompositor(htmlInformado)
            local anexos = {}
            local arquivo = (req.arquivos ou {}).anexo
            se arquivo então
                se arquivo.tamanho > configuração.limiteAnexo então
                    enviePágina(res, 413, páginas.compositor(
                        usuário, caixa, valores, "O anexo excede o limite permitido.")); retorne
                fim
                anexos[1] = {
                    nome = util.nomeSeguroDoAnexo(arquivo.nome),
                    tipo = arquivo.tipo ou "application/octet-stream",
                    dados = arquivo.dados
                }
            fim
            local respostaA = util.apare(formulário.respostaA)
            se #respostaA > 800 ou respostaA:procure("\r", 1, verdadeiro) ou
               respostaA:procure("\n", 1, verdadeiro) então respostaA = "" fim
            local cabeçalhos = {}
            se respostaA ~= "" então
                cabeçalhos["In-Reply-To"] = respostaA
                cabeçalhos["References"] = respostaA
            fim
            local função envie(anexosDaCarta)
                local dadosDaCarta = {
                    remetente = caixa.endereço,
                    nomeDoRemetente = usuário.nome,
                    destinatários = destinatáriosPrincipais,
                    cópia = cópia, cópiaOculta = cópiaOculta,
                    assunto = util.apare(formulário.assunto),
                    texto = paraColar(formulário.texto ou ""),
                    html = htmlSeguro ~= "" e htmlSeguro ou nulo,
                    anexos = anexosDaCarta,
                    cabeçalhos = cabeçalhos,
                    domínio = configuração.domínio
                }
                carteiro:envieCarta(caixa, dadosDaCarta,
                função(resultado, falhaDaFila)
                    se falhaDaFila então
                        local mensagemDaFalha, tipoDaFalha =
                            descrevaFalha(falhaDaFila)
                        enviePágina(res, tipoDaFalha == "ameaça" e 422 ou 503,
                            páginas.compositor(
                                usuário, caixa, valores, mensagemDaFalha))
                        retorne
                    fim
                    util.redirecione(res, "/carteiro/enviadas")
                fim)
            fim

            local encaminharDe = util.idNatural(formulário.encaminharDe)
            se util.apare(formulário.encaminharDe) ~= "" e não encaminharDe então
                enviePágina(res, 400, páginas.compositor(
                    usuário, caixa, valores,
                    "A carta original do encaminhamento é inválida."))
                retorne
            fim
            se não encaminharDe então envie(anexos); retorne fim

            carteiro:obtenhaCarta(caixa, encaminharDe,
                função(original, falhaDaOriginal)
                    se falhaDaOriginal ou não original então
                        enviePágina(res, falhaDaOriginal e 503 ou 404,
                            páginas.compositor(usuário, caixa, valores,
                                falhaDaOriginal ou
                                "A carta original não está mais disponível."))
                        retorne
                    fim
                    obtenhaAnexosOriginais(caixa, original,
                        função(originais, falhaDosAnexos)
                            se falhaDosAnexos então
                                enviePágina(res, 503, páginas.compositor(
                                    usuário, caixa, valores, falhaDosAnexos))
                                retorne
                            fim
                            para _, anexoNovo em ipares(anexos) início
                                originais[#originais + 1] = anexoNovo
                            fim
                            envie(originais)
                        fim)
                fim)
        fim)
    fim)

