                                "<!doctype html><meta charset=\"utf-8\">" ..
                                "<p>Confie no remetente antes de abrir a " ..
                                "mensagem formatada.</p>")
                            retorne
                        fim
                        util.protejaCartaHTML(res, pediuConteúdoExterno)
                        res:código(200):html(util.prepareCartaHTML(mensagem.html))
                    fim)
            fim)
        fim)
