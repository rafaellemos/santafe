    ap.rota("POST", "/carteiro/conversas/:id/acao", função(req, res)
        comCaixa(req, res, função(usuário, caixa)
            local id = util.idNatural(req.parâmetros.id)
            local formulário = req.form ou {}
            local pasta = formulário.pasta
            local ação = formulário.acao
            se não id ou não pastas[pasta] ou
               não util.confiraCSRF(usuário, formulário, segredo) então
                mostreErro(res, usuário, caixa, 403, "Pedido recusado",
                    "A conversa, a pasta ou a proteção do formulário é inválida.")
                retorne
            fim
            local destino
            se ação == "arquivar" então destino = "arquivadas"
            senão se ação == "indesejada" então destino = "indesejadas"
            senão se ação == "excluir" então destino = "lixeira"
            senão se ação == "restaurar" e pasta == "lixeira" então
                destino = "arquivadas"
            senão se ação:corte(1, 6) == "mover:" então
                destino = ação:corte(7)
                se destino ~= "arquivadas" e destino ~= "indesejadas" e
                   destino ~= "lixeira" então
                    mostreErro(res, usuário, caixa, 422, "Destino inválido",
                        "Escolha uma pasta disponível para esta conversa.")
                    retorne
                fim
            senão se ação == "não-lida" então
                destino = nulo
            senão
                mostreErro(res, usuário, caixa, 422, "Ação inválida",
                    "Escolha uma ação disponível para esta conversa.")
                retorne
            fim fim fim fim fim fim
            carteiro:listeCartasDaConversa(caixa, pasta, id,
                função(mensagens, falhaDaConversa)
                    se falhaDaConversa então
                        mostreErro(res, usuário, caixa, 503,
                            "Conversa indisponível", falhaDaConversa)
                        retorne
                    fim
                    se #mensagens == 0 então
                        mostreErro(res, usuário, caixa, 404,
                            "Conversa não encontrada", "Nada foi alterado.")
                        retorne
                    fim
                    se ação == "não-lida" então
                        local ids = {}
                        para _, mensagem em ipares(mensagens) início
                            ids[#ids + 1] = mensagem.id
                        fim
                        carteiro:marqueCartasNãoLidas(caixa, ids,
                            função(resultado, falhaDaMarcação)
                                se falhaDaMarcação então
                                    mostreErro(res, usuário, caixa, 503,
                                        "Conversa não alterada", falhaDaMarcação)
                                    retorne
                                fim
                                emita("carteiro.conversaAlterada", {
                                    caixa = caixa.id, carta = id, ação = ação,
                                    quantidade = resultado.quantidade ou 0
                                })
                                util.redirecione(res, "/carteiro/" .. pasta, 303)
                            fim)
                        retorne
                    fim
                    carteiro:movaCartas(caixa, mensagens, destino,
                        função(resultado, falhaDaAção, tipoDaFalha)
                            se falhaDaAção então
                                mostreErro(res, usuário, caixa,
                                    tipoDaFalha == "pasta-incompatível" e 422 ou 503,
                                    "Conversa não alterada", falhaDaAção)
                                retorne
                            fim
                            emita("carteiro.conversaAlterada", {
                                caixa = caixa.id, carta = id, ação = ação,
                                quantidade = resultado.quantidade ou 0
                            })
                            util.redirecione(res, "/carteiro/" .. pasta, 303)
                        fim)
                fim)
        fim)
    fim)

    ap.rota("POST", "/carteiro/mensagens/:id/acao", função(req, res)
        comCaixa(req, res, função(usuário, caixa)
            local id = util.idNatural(req.parâmetros.id)
            local formulário = req.form ou {}
            local pasta = formulário.pasta
            local ação = formulário.acao
            se não id ou não pastas[pasta] ou
