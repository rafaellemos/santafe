                mostreErro(res, usuário, caixa, 403, "Pedido recusado",
                    "A carta, a pasta ou a proteção do formulário é inválida.")
                retorne
            fim
            se ação == "excluir" então
                carteiro:movaCarta(caixa, id, "lixeira",
                    função(moveu, falhaDaAção)
                        se falhaDaAção então
                            mostreErro(res, usuário, caixa, 503,
                                "Carta não descartada", falhaDaAção)
                            retorne
                        fim
                        se não moveu então
                            mostreErro(res, usuário, caixa, 404,
                                "Carta não encontrada", "Nada foi alterado.")
                            retorne
                        fim
                        util.redirecione(res, "/carteiro/" .. pasta, 303)
                    fim)
                retorne
            fim
            se ação == "não-lida-daqui" então
                carteiro:listeCartasDaConversa(caixa, pasta, id,
                    função(mensagens, falhaDaConversa)
                        se falhaDaConversa então
                            mostreErro(res, usuário, caixa, 503,
                                "Conversa indisponível", falhaDaConversa)
                            retorne
                        fim
                        local ids, encontrou = {}, falso
                        para _, mensagem em ipares(mensagens ou {}) início
                            se mensagem.id == id então encontrou = verdadeiro fim
                            se encontrou então ids[#ids + 1] = mensagem.id fim
                        fim
                        se #ids == 0 então
                            mostreErro(res, usuário, caixa, 404,
                                "Carta não encontrada", "Nada foi alterado.")
                            retorne
                        fim
                        carteiro:marqueCartasNãoLidas(caixa, ids,
                            função(_, falhaDaMarcação)
                                se falhaDaMarcação então
                                    mostreErro(res, usuário, caixa, 503,
                                        "Conversa não alterada", falhaDaMarcação)
                                    retorne
                                fim
                                -- Reabrir a conversa desfaria a marcação,
                                -- pois toda carta exibida passa a ser lida.
                                util.redirecione(res, "/carteiro/" .. pasta, 303)
                            fim)
                    fim)
                retorne
            fim
            se ação ~= "bloquear" e ação ~= "indesejada" e
               ação ~= "fisgada" então
                mostreErro(res, usuário, caixa, 422, "Ação inválida",
                    "Escolha uma ação disponível para esta carta.")
                retorne
            fim
            carteiro:decidaTriagemDaCarta(caixa, id, "indesejada",
                função(resultado, falhaDaTriagem)
                    se falhaDaTriagem ou não resultado então
                        mostreErro(res, usuário, caixa, 503,
                            "Triagem não alterada", falhaDaTriagem ou
                            "A decisão não foi salva.")
                        retorne
                    fim
                    emita("carteiro." .. ação, {
                        caixa = caixa.id, carta = id,
                        escopo = resultado.escopo
                    }, ação == "fisgada" e "alta" ou "normal")
                    util.redirecione(res, "/carteiro/indesejadas", 303)
                fim)
        fim)
    fim)

