NOMES_ZONAS_ARQUIVO=/etc/santafe-nomes/zonas.fé
NOMES_AUTORIDADE_ENDERECO=143.208.252.1
NOMES_AUTORIDADE_PORTA=53
NOMES_AUTORIDADE_POR_SEGUNDO=200
NOMES_AUTORIDADE_EXPLOSAO=400
NOMES_AUTORIDADE_MAXIMO_TCP=256

# O resolvedor deve escutar em endereço local ou interno. Publicá-lo no mesmo
# IP do autoritativo causaria conflito na porta 53.
NOMES_RESOLVEDOR_ENDERECO=127.0.0.1
NOMES_RESOLVEDOR_PORTA=53
NOMES_RESOLVEDOR_PREFIXOS=127.0.0.0/8,::1/128,143.208.252.0/22
NOMES_RESOLVEDOR_TEMPO_LIMITE=1800
NOMES_RESOLVEDOR_PENDENTES=2048
NOMES_RESOLVEDOR_MAXIMO_TCP=256
NOMES_RESOLVEDOR_MEMRAP=20000
NOMES_RESOLVEDOR_POR_SEGUNDO=100
NOMES_RESOLVEDOR_EXPLOSAO=200
NOMES_MAXIMO_UDP=1232
