-- Uma ameaça recebe recusa SMTP definitiva, e não entra no depósito.

módulo.caminho = "bibs/bibf/?.fé;bibs/bibf/?.fe;" .. módulo.caminho
módulo.caminhoC = "bibs/bibc/rede/?.so;" .. módulo.caminhoC

local correio = importe "correio"
local rede = importe "rede"

local servidor = garanta(correio.servidor {
    endereço = "127.0.0.1",
    porta = 18757,
    nome = "smtp.teste.local",
    domíniosLocais = { "teste.local" },
    receba = função(_, conclua)
        conclua(nulo, {
            tipo = "ameaça",
            mensagem = "conteúdo malicioso recusado pelo antivírus",
            ameaça = "Win.Teste-Santafe"
        })
    fim
})
garanta(servidor:inicie())

local carta = garanta(correio.novaMensagem {
    remetente = "a@fora.test",
    destinatários = { "b@teste.local" },
    texto = "conteúdo de teste"
})
local cliente = garanta(correio.cliente {
    endereço = "127.0.0.1", porta = 18757,
    segurança = "nenhuma", nome = "cliente.teste.local"
})
local terminou = falso
local bloqueou = falso
garanta(cliente:envieAssíncrono(carta, função(resultado, falha)
    terminou = verdadeiro
    bloqueou = não resultado e falha ~= nulo e
        falha:procure("554", 1, verdadeiro) ~= nulo
    cliente:feche()
    servidor:feche()
fim))

rede.laço()
garanta(terminou e bloqueou,
    "servidor SMTP não devolveu recusa definitiva 554")
mostre("Correio antivírus SMTP: ok")
