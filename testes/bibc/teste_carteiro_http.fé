local índice = 0
local executePróximo

executePróximo = função()
    índice = índice + 1
    local teste = testes[índice]
    se não teste então
        concluir(enviou e respondeu e encaminhou e marcou e marcouNãoLida e
            confiou e revogou e
            regraSalva e regraRemovida e decisãoDaTriagem == "regular" e
            pastaMovida == "arquivadas" e movimentosParaLixeira == 2 e
            restauraçãoOferecida e
            lixeiraEsvaziada,
            "efeitos esperados do Carteiro não ocorreram")
        retorne
    fim
    cliente:definaTempoLimite(3000)
    cliente:conecteAssíncrono("127.0.0.1", porta, função(_, conexão, falha)
        se falha então concluir(falso, teste.nome .. ": " .. falha); retorne fim
        conexãoCliente = conexão
        conexão:definaTempoLimite(3000)
        conexão:envieAssíncrono(teste.pedido, função(c, _, falhaDoEnvio)
            se falhaDoEnvio então
                concluir(falso, teste.nome .. ": " .. falhaDoEnvio); retorne
            fim
            -- TCP pode entregar a resposta em vários trechos. Validar só o
            -- primeiro produzia falhas aleatórias quando o HTML era dividido.
            local resposta = ""
            local leiaResposta
            leiaResposta = função()
            c:recebaDadosAssíncrono(4096, função(_, trecho, falhaDaLeitura)
                se falhaDaLeitura então
                    concluir(falso, teste.nome .. ": " .. falhaDaLeitura); retorne
                fim
                se trecho == nulo ou #trecho == 0 então
                    concluir(falso, teste.nome .. ": resposta HTTP incompleta"); retorne
                fim
                resposta = resposta .. trecho
                se #resposta > 4 * 1024 * 1024 então
                    concluir(falso, teste.nome .. ": resposta HTTP excessiva"); retorne
                fim
                local _, fimDoCabeçalho = resposta:procure("\r\n\r\n", 1, verdadeiro)
                se não fimDoCabeçalho então leiaResposta(); retorne fim
                local comprimento = paraNúmero(resposta:corte(1, fimDoCabeçalho)
                    :minúscula():separe("\r\ncontent%-length:[ \t]*([0-9]+)"))
                se comprimento == nulo então
                    concluir(falso, teste.nome .. ": Content-Length ausente"); retorne
                fim
                se #resposta - fimDoCabeçalho < comprimento então leiaResposta(); retorne fim
                local passou = verdadeiro
                se teste.verificar então
                    passou = não não teste.verificar(resposta)
                senão
                    para _, trecho em ipares(teste.trechos) início
                        se não resposta:procure(trecho, 1, verdadeiro) então
                            passou = falso; pare
                        fim
                    fim
                fim
                se não passou então
                    concluir(falso, teste.nome .. ": " .. resposta); retorne
                fim
                conexãoCliente:feche()
                conexãoCliente = nulo
                executePróximo()
            fim)
            fim
            leiaResposta()
        fim)
    fim)
fim

