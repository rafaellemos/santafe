função repositório.adicioneSaída(_, caixaRecebida, mensagem, _, tratador)
    garanta(caixaRecebida.id == caixa.id)
    local mime, falha = mensagem:forme()
    garanta(mime, falha)
    local lida
    lida, falha = correio.leiaMensagem(mime)
    garanta(lida, falha)
    se lida.cabeçalhos["in-reply-to"] então
        garanta(lida.texto == "Obrigado",
            "corpo da resposta não entrou no MIME")
        garanta(lida.cabeçalhos["in-reply-to"] == "<original@exemplo.org>")
        garanta(lida.cabeçalhos.references == "<original@exemplo.org>")
        respondeu = verdadeiro
    senão se lida.assunto == "Encaminhada: Mensagem de integração" então
        garanta(lida.texto == "Segue a carta encaminhada",
            "corpo editado do encaminhamento não entrou no MIME")
        garanta(#lida.anexos == 3,
            "anexos originais não acompanharam o encaminhamento")
        garanta(lida.anexos[1].nome == "ação.bin" e
            lida.anexos[1].dados == "ABC\0DEF")
        garanta(lida.anexos[2].nome == "imagem.png" e
            lida.anexos[2].tipo == "image/png")
        garanta(lida.anexos[3].nome == "relatório final.pdf" e
            lida.anexos[3].tipo == "application/pdf")
        encaminhou = verdadeiro
    senão se lida.assunto == "HTML seguro" então
        garanta(lida.texto == "Mensagem formatada")
        garanta(lida.html:procure("<strong>Formatada</strong>", 1, verdadeiro))
        garanta(não lida.html:procure("<script>", 1, verdadeiro))
        garanta(lida.html:procure("&lt;script&gt;", 1, verdadeiro))
        enviouHTML = verdadeiro
    senão
        garanta(lida.texto == "Mensagem enviada pelo teste",
            "corpo não entrou no MIME")
    fim fim fim
    enviou = verdadeiro
    tratador({ mensagem = 42, fila = 3 }, nulo)
fim

