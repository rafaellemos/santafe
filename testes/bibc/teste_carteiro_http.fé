local função pedido(método, caminho, corpo, tipoDoConteúdo, autenticado)
    corpo = corpo ou ""
    local cabeçalhos = método .. " " .. caminho .. " HTTP/1.1\r\n" ..
        "Host: local\r\nConnection: close\r\n"
    se autenticado então
        cabeçalhos = cabeçalhos .. "Cookie: sf_sessao=" .. bilhete .. "\r\n"
    fim
    se tipoDoConteúdo então
        cabeçalhos = cabeçalhos .. "Content-Type: " .. tipoDoConteúdo .. "\r\n"
    fim
    se #corpo > 0 então
        cabeçalhos = cabeçalhos .. "Content-Length: " .. #corpo .. "\r\n"
    fim
    retorne cabeçalhos .. "\r\n" .. corpo
fim

