local moveu = falso
repositório:movaMensagensEmLote(7, { 103, 102, 102 }, "arquivadas",
    função(resultado, falha)
        garanta(não falha, falha)
        garanta(resultado.quantidade == 2)
        garanta(piscina.últimoSQL:procure("CASE id", 1, verdadeiro))
        garanta(piscina.últimoSQL:procure("id IN (?,?)", 1, verdadeiro))
        garanta(piscina.últimosParâmetros[1] == "arquivadas")
        garanta(piscina.últimosParâmetros[2] == 103)
        garanta(piscina.últimosParâmetros[3] == 500)
        moveu = verdadeiro
    fim)
garanta(moveu e piscina.confirmou == 1 e piscina.desfez == 0,
    "o movimento transacional em lote não terminou")

local marcou = falso
repositório:marqueMensagensLidasEmLote(7, { 103, 102 },
    função(resultado, falha)
        garanta(não falha, falha)
        garanta(resultado.quantidade == 2)
        garanta(piscina.últimoSQL:procure("SET lida=?", 1, verdadeiro))
        garanta(piscina.últimoSQL:procure("id IN (?,?)", 1, verdadeiro))
        garanta(piscina.últimosParâmetros[1] == verdadeiro)
        garanta(piscina.últimosParâmetros[3] == 7)
        marcou = verdadeiro
    fim)
garanta(marcou e piscina.confirmou == 2 e piscina.desfez == 0,
