repositório:marqueMensagensNãoLidasEmLote(7, { 103, 102 },
    função(resultado, falha)
        garanta(não falha, falha)
        garanta(resultado.quantidade == 2)
        garanta(piscina.últimoSQL:procure("SET lida=?", 1, verdadeiro))
        garanta(piscina.últimosParâmetros[1] == falso)
        garanta(piscina.últimosParâmetros[3] == 7)
        desmarcou = verdadeiro
