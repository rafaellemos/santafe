        garanta(não falha e total == 18733)
        garanta(piscina.últimoSQL:procure(
            "pasta NOT IN ('indesejadas','lixeira')", 1, verdadeiro))
        garanta(piscina.últimoSQL:procure("COUNT(DISTINCT", 1, verdadeiro))
        garanta(#piscina.últimosParâmetros == 5 e
            piscina.últimosParâmetros[1] == 7 e
            piscina.últimosParâmetros[2] == "teste")
        contou = verdadeiro
    fim)
garanta(contou, "a contagem da visão Todas não terminou")

