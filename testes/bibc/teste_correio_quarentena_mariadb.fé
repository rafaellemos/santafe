local endereço = so.obterVariável("SANTAFE_MARIADB_HOST")
local usuário = so.obterVariável("SANTAFE_MARIADB_USUARIO")
local senha = so.obterVariável("SANTAFE_MARIADB_SENHA")
local banco = so.obterVariável("SANTAFE_MARIADB_BANCO")
se não (endereço e usuário e senha e banco) então
    mostre("IGNORADO: defina as variáveis SANTAFE_MARIADB_* para testar")
    retorne
fim

local mariadb = importe "mariadb"
local correio = importe "correio"
local rede = importe "rede"
local piscina

local função falhe(mensagem)
    se piscina então piscina:feche() fim
    mostre("FALHOU:", mensagem)
    so.saia(1)
fim

mariadb.criePiscinaAssíncrona({
    endereço = endereço, usuário = usuário, senha = senha,
    banco = banco,
    porta = paraNúmero(so.obterVariável("SANTAFE_MARIADB_PORTA")) ou 3306,
    mínimo = 1, máximo = 2, máximoDaFila = 8, tempoDeEspera = 3000
}, função(novaPiscina, falhaDaPiscina)
    se falhaDaPiscina então falhe(falhaDaPiscina); retorne fim
    piscina = novaPiscina
    local fila = garanta(correio.filaMariaDB(piscina, {
        tabela = "correio_fila"
    }))
    fila:listeQuarentenaAssíncrono(100, função(itens, falhaDaLista)
        se falhaDaLista então falhe(falhaDaLista); retorne fim
        local alvo
        para _, item em ipares(itens) início
            se item.remetente == "quarentena@teste.local" então alvo = item fim
        fim
        se não alvo então
            falhe("item esperado não apareceu na quarentena"); retorne
        fim
        garanta(alvo.falhasInternas == 3)
        fila:reprocesseQuarentenaAssíncrono(alvo.identificação,
            função(reprocessou, falhaDoReprocessamento)
                se não reprocessou então
                    falhe(falhaDoReprocessamento ou
                        "item não foi liberado da quarentena")
                    retorne
                fim
                piscina:feche()
                mostre("correio quarentena MariaDB: ok")
                rede.pareLaço()
            fim)
    fim)
fim)

rede.laço()
