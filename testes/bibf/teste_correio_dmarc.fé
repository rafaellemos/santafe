módulo.caminho = "bibs/bibf/?.fé;bibs/bibf/?/?.fé;" .. módulo.caminho
módulo.caminhoC = "bibs/bibc/rede/?.so;" .. módulo.caminhoC

local dmarc = importe "correio.dmarc"

local registros = {
    ["_dmarc.embratel.com.br"] = { "v=DMARC1; p=reject; pct=100" },
    ["_dmarc.quarentena.example"] = { "v=DMARC1; p=quarantine" },
    ["_dmarc.teste.example"] = { "v=DMARC1; p=reject; t=y" },
    ["_dmarc.empresa.example"] = { "v=DMARC1; p=reject; sp=quarantine" },
    ["_dmarc.sub.organizacao.example"] = { "v=DMARC1; p=reject" },
    ["_dmarc.organizacao.example"] = { "v=DMARC1; p=none; psd=n" },
    ["_dmarc.monitorada.example"] = {
        "v=DMARC1; rua=mailto:dmarc@monitorada.example"
    },
    ["_dmarc.inválida.example"] = { "v=DMARC1; p=talvez" }
}

local função consulte(nome, tratador)
    local saída = {}
    para _, valor em ipares(registros[nome] ou {}) início
        saída[#saída + 1] = { valor = valor }
    fim
    tratador(saída)
    retorne verdadeiro
fim

local função avalie(opções)
    local resultado
    opções.consulteTXT = opções.consulteTXT ou consulte
    garanta(dmarc.avalieAssíncrono(opções,
        função(avaliação) resultado = avaliação fim))
    garanta(resultado, "DMARC não concluiu")
    retorne resultado
fim

local falsoEmbratel = avalie({
    domínioDoAutor = "embratel.com.br",
    spf = { resultado = "falha", domínio = "embratel.com.br" },
    dkim = { resultado = "nenhum", domínios = {} }
})
garanta(falsoEmbratel.resultado == "falha" e
    falsoEmbratel.ação == "rejeitar")

