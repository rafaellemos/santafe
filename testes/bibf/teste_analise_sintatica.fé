-- Intervalos reais do léxico; não deduzir colunas pelo texto do erro.
local função confira(texto, trecho, último)
    local ok, diagnóstico = depure.analise(texto, "@uri:12: com espaços.fé")
    garanta(ok == falso e diagnóstico["código"] == "sintaxe")
    local começo = diagnóstico["início"]
    local final = diagnóstico["fim"]
    garanta(tipo(começo) == "número" e começo >= 0 e começo <= final e final <= #texto)
    garanta(texto:corte(começo + 1, final) == trecho, json.cod(diagnóstico))
    se último então garanta(final == #texto, json.cod(diagnóstico)) fim
fim

