  <circle cx="35" cy="40" r="20" fill="#ffc500"/>
  <path d="M65 60 Q90 5 112 60 Z" fill="#ff6461"/>
</svg>]]
local vetor = imagem.leia(svg, verdadeiro)
garanta(vetor.formato == "svg" e vetor.largura == 120 e #vetor.elementos == 3)
mostre("Imagem PNG/JPEG/SVG:", figura.largura, figura.altura, vetor.largura, vetor.altura)
