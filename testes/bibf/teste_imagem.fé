módulo.caminho = "bibs/bibf/?.fé;" .. módulo.caminho
local imagem = importe "imagem"
local caminhoJPEG = "testes/recursos/mat-santafe.jpg"

imagem.salve("/tmp/santafe-png-rgba.png", "png", 64, 48, função(x, y)
    retorne x * 4, y * 5, 180, (x + y) * 255 // 112
fim)

local figura = imagem.leia("/tmp/santafe-png-rgba.png")
garanta(figura.formato == "png" e figura.largura == 64 e figura.altura == 48)
garanta(figura.alfa[1] < 255 e figura.alfa[#figura.alfa] == 255)
garanta(imagem.identifique("/tmp/santafe-png-rgba.png") == "png")
garanta(imagem.identifique(caminhoJPEG) == "jpeg")

local pngPDF = imagem.paraPDF("/tmp/santafe-png-rgba.png")
garanta(pngPDF.bitsPorComponente == 8)
garanta(pngPDF.ticosPorComponente == pngPDF.bitsPorComponente)

local jpegPDF = imagem.paraPDF(caminhoJPEG)
garanta(jpegPDF.bitsPorComponente == jpegPDF.ticosPorComponente)

local svg = [[<svg width="120" height="80" viewBox="0 0 120 80">
