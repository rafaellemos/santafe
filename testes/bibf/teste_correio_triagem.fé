local Triagem = importe "correio.triagem"

local selecionador = Triagem.nova {
    limiteSuspeita = 4,
    limiteIndesejada = 8,
    bloqueados = { "fraude@hostil.test", "@bloqueado.test" }
}

local função mensagem(opções)
    opções = opções ou {}
    retorne {
        cabeçalhos = opções.cabeçalhos ou {
            from = opções.remetente ou "Pessoa <pessoa@exemplo.org>"
        },
        remetente = opções.remetente ou "Pessoa <pessoa@exemplo.org>",
        responderPara = opções.responderPara ou "pessoa@exemplo.org",
        assunto = opções.assunto ou "Relatório",
        data = opções.data ou "Fri, 28 Aug 2026 13:00:00 -0300",
        identificação = opções.identificação ou "<1@exemplo.org>",
        texto = opções.texto ou "Olá",
        html = opções.html,
        anexos = opções.anexos ou {}
    }
fim

local envelope = {
    remetente = "pessoa@exemplo.org",
    destinatários = { "rafael@santafé.dev.br" }
}

local função possuiMotivo(resultado, regra)
    para _, motivo em ipares(resultado.motivos ou {}) início
        se motivo.regra == regra então retorne verdadeiro fim
    fim
    retorne falso
fim

local regular = selecionador:avalie(envelope, mensagem())
garanta(regular.classificação == "regular")
garanta(regular.pontuaçãoDeSuspeita == 0)
garanta(regular.pasta == "entrada")

local ligaçãoLegítima = selecionador:avalie(envelope, mensagem {
