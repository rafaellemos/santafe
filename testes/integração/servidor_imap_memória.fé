local próximos = {
    entrada = 15, enviadas = 1, rascunhos = 1, arquivadas = 1,
    indesejadas = 1, lixeira = 1
}
local repositório = {}

função repositório.autentiqueCaixa(_, usuário, senha, _, tratador)
    se (usuário == "teste@santafé.dev.br" ou
        usuário == "tésté@santafé.dev.br" ou
        usuário == "teste@xn--santaf-gva.dev.br") e senha == "segredo" então
        tratador({
            usuário = "teste", endereço = "teste@santafé.dev.br",
            caixa = { id = 7, endereço = "teste@santafé.dev.br", estado = "ativa" }
        }, nulo)
    senão tratador(nulo, nulo) fim
fim

função repositório.listeMensagensIMAP(_, _, pasta, tratador)
    local itens, nãoLidas = {}, 0
    para _, mensagem em ipares(mensagens) início
        se mensagem.pasta == pasta então
            itens[#itens + 1] = mensagem
            se não mensagem.lida então nãoLidas = nãoLidas + 1 fim
        fim
    fim
    tabela.ordene(itens, função(a, b) retorne a.uid < b.uid fim)
    tratador({
        validadeUID = 1788130000, próximoUID = próximos[pasta],
        quantidade = #itens, nãoLidas = nãoLidas, mensagens = itens
    }, nulo)
fim

função repositório.obtenhaMensagemIMAP(_, _, id, tratador)
    para _, mensagem em ipares(mensagens) início
        se mensagem.id == id então tratador(mensagem, nulo); retorne fim
    fim
    tratador(nulo, nulo)
fim

função repositório.obtenhaAnexo(_, _, _, _, tratador)
    tratador(nulo, "anexo de ensaio inexistente")
fim

função repositório.atualizeSinalizadoresIMAP(_, _, id, sinalizadores,
                                                        tratador)
    para _, mensagem em ipares(mensagens) início
        se mensagem.id == id então
            mensagem.lida = sinalizadores.lida
            mensagem.importante = sinalizadores.importante
            mensagem.apagadaNoIMAP = sinalizadores.apagada
            tratador(verdadeiro, nulo); retorne
        fim
    fim
    tratador(falso, nulo)
fim

função repositório.movaMensagemIMAP(_, _, id, pasta, tratador)
    para _, mensagem em ipares(mensagens) início
        se mensagem.id == id então
            mensagem.pasta = pasta
            mensagem.uid = próximos[pasta]
            mensagem.apagadaNoIMAP = falso
            próximos[pasta] = próximos[pasta] + 1
            tratador({ uid = mensagem.uid }, nulo); retorne
        fim
    fim
    tratador(nulo, "carta inexistente")
fim

função repositório.copieMensagensIMAP(_, _, ids, pasta, tratador)
    local cópias = {}
    para _, id em ipares(ids ou {}) início
        local original
        para _, mensagem em ipares(mensagens) início
            se mensagem.id == id então original = mensagem; pare fim
        fim
        se não original então tratador(nulo, "carta inexistente"); retorne fim
        local nova = {}
        para nome, valor em pares(original) início nova[nome] = valor fim
        local maiorId = 0
        para _, mensagem em ipares(mensagens) início
            maiorId = mat.máximo(maiorId, mensagem.id)
        fim
        nova.id = maiorId + 1
        nova.pasta = pasta
        nova.uid = próximos[pasta]
        próximos[pasta] = próximos[pasta] + 1
        mensagens[#mensagens + 1] = nova
        cópias[#cópias + 1] = {
            origem = id, id = nova.id, uid = nova.uid
        }
    fim
    tratador({ validadeUID = 1788130000, cópias = cópias }, nulo)
fim

função repositório.removaMensagemIMAP(_, _, id, tratador)
    para índice, mensagem em ipares(mensagens) início
        se mensagem.id == id então
            se mensagem.pasta ~= "lixeira" então
                tratador(nulo,
                    "somente cartas da lixeira podem ser removidas definitivamente")
                retorne
            fim
            tabela.remova(mensagens, índice)
            tratador({ id = id, tacosLiberados = mensagem.tamanho }, nulo)
            retorne
        fim
    fim
    tratador(nulo, "carta inexistente")
fim

função repositório.adicioneMensagemIMAP(_, caixa, pasta, mime, opções,
                                                    tratador)
    local lida, falha = correio.leiaMensagem(mime)
    se não lida então tratador(nulo, falha); retorne fim
    se pasta == "enviadas" então
        para _, mensagem em ipares(mensagens) início
            se mensagem.pasta == pasta e
               mensagem.identificação == lida.identificação e
               mensagem.mime == mime então
                tratador({
                    id = mensagem.id, uid = mensagem.uid,
                    validadeUID = 1788130000, duplicada = verdadeiro
                }, nulo)
                retorne
            fim
        fim
    fim
    local maiorId = 0
    para _, mensagem em ipares(mensagens) início
        maiorId = mat.máximo(maiorId, mensagem.id)
    fim
    local mensagem = {
        id = maiorId + 1, uid = próximos[pasta], pasta = pasta,
        direção = "saida", remetente = caixa.endereço,
        destinatários = { ["para"] = { lida.destinatários } },
        assunto = lida.assunto, resumo = lida.texto ou lida.html ou "",
        texto = lida.texto, html = lida.html, anexos = lida.anexos,
        tamanho = #mime, lida = opções.lida == verdadeiro,
        importante = opções.importante == verdadeiro,
        apagadaNoIMAP = falso,
        criadaEm = opções.criadaEm, identificação = lida.identificação,
        mime = mime
    }
    próximos[pasta] = próximos[pasta] + 1
    mensagens[#mensagens + 1] = mensagem
    tratador({
        id = mensagem.id, uid = mensagem.uid,
        validadeUID = 1788130000, duplicada = falso
    }, nulo)
fim

