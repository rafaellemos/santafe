    local função executeAPPEND(sessão, pedido, mime)
        sessão.aguardando = verdadeiro
        local inspeção, falhaDaInspeção =
            correio.inspecioneCabeçalhos(mime)
        se não inspeção então
            conclua(sessão, pedido.etiqueta, "NO", "[CANNOT] " ..
                paraColar(falhaDaInspeção))
            retorne
        fim
        se inspeção.internacionais e não pedido.internacional então
            emita(configuração.pulso, "leitura",
                "correio.imapUnicodeCompatibilidade", {
                    endereço = sessão.endereço,
                    comando = "APPEND"
                })
        fim
        repositório:adicioneMensagemIMAP(sessão.caixa, pedido.pasta, mime, {
            lida = pedido.lida, importante = pedido.importante,
            criadaEm = pedido.criadaEm
        }, função(resultado, falhaDaInclusão)
            se sessão.fechada então retorne fim
            se não resultado então
                conclua(sessão, pedido.etiqueta, "NO", "[CANNOT] " ..
                    paraColar(falhaDaInclusão ou "carta não foi anexada"))
                retorne
            fim
            emita(configuração.pulso, "leitura", "correio.imapCartaAnexada", {
                endereço = sessão.endereço, pasta = pedido.pasta,
                tamanho = #mime, duplicada = resultado.duplicada == verdadeiro
            })
            local texto = "[APPENDUID " .. resultado.validadeUID .. " " ..
                resultado.uid .. "] APPEND concluído"
            se sessão.estado ~= "selecionada" ou
               sessão.pasta ~= pedido.pasta ou resultado.duplicada então
                conclua(sessão, pedido.etiqueta, "OK", texto)
                retorne
            fim
            local quantidadeAnterior = sessão.pastaEstado.quantidade ou 0
            recarregue(sessão, função(estado)
                local antes = ""
                se estado e estado.quantidade > quantidadeAnterior então
                    antes = "* " .. estado.quantidade .. " EXISTS" .. CRLF
                fim
                conclua(sessão, pedido.etiqueta, "OK", texto, antes)
            fim)
        fim)
    fim

    local função expurgueUID(sessão, etiqueta, conjunto)
        se sessão.pasta == "lixeira" então
            removaItensDaLixeira(sessão, etiqueta, conjunto, verdadeiro,
                falso)
            retorne
        fim
        local maiorUID = 0
        para _, mensagem em ipares(sessão.pastaEstado.mensagens ou {}) início
            maiorUID = mat.máximo(maiorUID, mensagem.uid ou 0)
        fim
        local uids = {}
        para _, mensagem em ipares(sessão.pastaEstado.mensagens ou {}) início
            se mensagem.apagadaNoIMAP e
               pertenceAoConjunto(mensagem.uid, conjunto, maiorUID) então
                uids[#uids + 1] = paraColar(mensagem.uid)
            fim
        fim
        se #uids == 0 então
            conclua(sessão, etiqueta, "OK", "UID EXPUNGE concluído")
            retorne
        fim
        movaItens(sessão, etiqueta, tabela.concatene(uids, ","),
            "Lixeira", verdadeiro, verdadeiro)
    fim

    local função trateComando(sessão, linha)
        sessão.comandos = sessão.comandos + 1
        se sessão.comandos > configuração.limiteComandos então
            envie(sessão, "* BYE limite de comandos atingido" .. CRLF,
                função() encerre(sessão) fim)
            retorne
        fim
        local etiqueta, comando, restante = linha:separe(
            "^([^ \t]+)[ \t]+([^ \t]+)[ \t]*(.*)$")
        se não etiqueta então
            envie(sessão, "* BAD comando IMAP inválido" .. CRLF,
                função() prossiga(sessão) fim)
            retorne
        fim
        comando = comando:maiúscula()
        se #sessão.rastro < 64 então
            sessão.rastro[#sessão.rastro + 1] = comando
        fim

        se comando == "CAPABILITY" então
            local capacidades = sessão.estado == "nãoAutenticada" e
                capacidadesComAutenticação ou capacidadesAutenticadas
            conclua(sessão, etiqueta, "OK", "CAPABILITY concluído",
                "* CAPABILITY " .. capacidades .. CRLF); retorne
        fim
        se comando == "NOOP" ou comando == "CHECK" então
            conclua(sessão, etiqueta, "OK", comando .. " concluído"); retorne
        fim
        se comando == "LOGOUT" então
            envie(sessão, "* BYE ate logo" .. CRLF .. etiqueta ..
                " OK LOGOUT concluído" .. CRLF,
                função() encerre(sessão) fim); retorne
        fim
        se comando == "ID" então
            conclua(sessão, etiqueta, "OK", "ID concluído",
                "* ID (\"name\" \"Correio Santafe\" \"version\" " ..
                aspe(imap.versão) .. ")" .. CRLF); retorne
        fim

        se sessão.estado == "nãoAutenticada" então
            se comando == "LOGIN" então
                local itens, falhaDasPalavras = palavras(restante)
                se não itens ou #itens ~= 2 então
                    conclua(sessão, etiqueta, "BAD",
                        falhaDasPalavras ou "LOGIN exige usuário e senha")
                    retorne
                fim
                se possuiNãoASCII(itens[1]) ou possuiNãoASCII(itens[2]) então
                    conclua(sessão, etiqueta, "NO",
                        "[CANNOT] credenciais Unicode exigem AUTHENTICATE")
                    retorne
                fim
                autentique(sessão, etiqueta, itens[1], itens[2]); retorne
            fim
            se comando == "AUTHENTICATE" então
                local itens = palavras(restante) ou {}
                se não itens[1] ou itens[1]:maiúscula() ~= "PLAIN" então
                    conclua(sessão, etiqueta, "NO",
                        "[AUTHENTICATIONFAILED] mecanismo não aceito")
                    retorne
                fim
                se itens[2] então
                    local usuário, senha = decodifiquePLAIN(itens[2])
                    se não usuário então
                        conclua(sessão, etiqueta, "NO",
                            "[AUTHENTICATIONFAILED] credencial inválida")
                    senão autentique(sessão, etiqueta, usuário, senha) fim
                senão
                    sessão.autenticaçãoPendente = etiqueta
                    envie(sessão, "+ " .. CRLF,
                        função() prossiga(sessão) fim)
                fim
                retorne
            fim
            conclua(sessão, etiqueta, "NO", "autenticação obrigatória")
            retorne
        fim

        se comando == "ENABLE" então
            se sessão.estado ~= "autenticada" então
                conclua(sessão, etiqueta, "NO",
                    "[CANNOT] ENABLE exige estado autenticado")
                retorne
            fim
            local itens, falhaDosItens = palavras(restante)
            se não itens então
                conclua(sessão, etiqueta, "BAD", falhaDosItens); retorne
            fim
            local habilitadas = {}
            para _, item em ipares(itens) início
                se item:maiúscula() == "UTF8=ACCEPT" e
                   não sessão.utf8Aceito então
                    sessão.utf8Aceito = verdadeiro
                    habilitadas[#habilitadas + 1] = "UTF8=ACCEPT"
                fim
            fim
            local antes = ""
            se #habilitadas > 0 então
                antes = "* ENABLED " ..
                    tabela.concatene(habilitadas, " ") .. CRLF
                emita(configuração.pulso, "leitura",
                    "correio.imapUnicodeAtivado", {
                        endereço = sessão.endereço,
                        capacidades = habilitadas
                    })
            fim
            conclua(sessão, etiqueta, "OK", "ENABLE concluido", antes)
            retorne
        fim

        se comando == "NAMESPACE" então
            conclua(sessão, etiqueta, "OK", "NAMESPACE concluído",
                "* NAMESPACE ((\"\" \"/\")) NIL NIL" .. CRLF); retorne
        fim
        se comando == "LIST" ou comando == "LSUB" então
            local pedido, falhaDaLista = analiseLISTA(restante)
            se não pedido então
                conclua(sessão, etiqueta, "BAD", falhaDaLista); retorne
            fim
            conclua(sessão, etiqueta, "OK", comando .. " concluído",
                respostaLISTA(comando, pedido))
            retorne
        fim
        se comando == "SUBSCRIBE" ou comando == "UNSUBSCRIBE" então
            conclua(sessão, etiqueta, "OK", comando .. " concluído"); retorne
        fim
        se comando == "APPEND" então
            local pedido, falhaDoPedido = analiseAPPEND(
                restante, configuração.limiteMensagem)
            se não pedido então
                conclua(sessão, etiqueta, "BAD", falhaDoPedido); retorne
            fim
            se não pedido.pasta então
                conclua(sessão, etiqueta, "NO",
                    "[TRYCREATE] pasta inexistente"); retorne
            fim
            se pedido.pasta ~= "rascunhos" e pedido.pasta ~= "enviadas" então
                conclua(sessão, etiqueta, "NO",
                    "[CANNOT] APPEND aceita somente Rascunhos ou Enviadas")
                retorne
            fim
            se pedido.internacional e não sessão.utf8Aceito então
                conclua(sessão, etiqueta, "NO",
                    "[NOTENABLED] execute ENABLE UTF8=ACCEPT")
                retorne
            fim
            pedido.etiqueta = etiqueta
            sessão.literalPendente = pedido
            envie(sessão, "+ pronto para " .. pedido.tamanho .. " tacos" ..
                CRLF, função() prossiga(sessão) fim)
            retorne
        fim
        se comando == "STATUS" então
            local caixa, itens = restante:separe(
                "^([^ \t]+)[ \t]+%((.-)%)$")
            local pasta = caixa e pastaInterna(caixa) ou nulo
            se não pasta então
                conclua(sessão, etiqueta, "NO", "pasta inexistente"); retorne
            fim
            sessão.aguardando = verdadeiro
            repositório:listeMensagensIMAP(sessão.caixa.id, pasta,
                função(estado, falhaDoEstado)
                    se não estado então
                        conclua(sessão, etiqueta, "NO", "[UNAVAILABLE] " ..
                            paraColar(falhaDoEstado)); retorne
                    fim
                    local valores = {}
                    para item em (itens ou ""):maiúscula():capture("[^ ]+") início
                        se item == "MESSAGES" então
                            valores[#valores + 1] = "MESSAGES " .. estado.quantidade
                        senão se item == "UNSEEN" então
                            valores[#valores + 1] = "UNSEEN " .. estado.nãoLidas
                        senão se item == "UIDNEXT" então
                            valores[#valores + 1] = "UIDNEXT " .. estado.próximoUID
                        senão se item == "UIDVALIDITY" então
                            valores[#valores + 1] = "UIDVALIDITY " .. estado.validadeUID
                        fim fim fim fim
                    fim
                    conclua(sessão, etiqueta, "OK", "STATUS concluído",
                        "* STATUS " .. aspe(nomeDaPasta(pasta)) .. " (" ..
                        tabela.concatene(valores, " ") .. ")" .. CRLF)
                fim)
            retorne
        fim
        se comando == "SELECT" ou comando == "EXAMINE" então
            se não sessão.utf8Aceito então
                emita(configuração.pulso, "leitura",
                    "correio.imapUnicodeCompatibilidade", {
                        endereço = sessão.endereço,
                        comando = comando
                    })
            fim
            local pasta = pastaInterna(restante)
            se não pasta então
                conclua(sessão, etiqueta, "NO", "pasta inexistente"); retorne
            fim
            sessão.aguardando = verdadeiro
            repositório:listeMensagensIMAP(sessão.caixa.id, pasta,
                função(estado, falhaDoEstado)
                    se não estado então
                        conclua(sessão, etiqueta, "NO", "[UNAVAILABLE] " ..
                            paraColar(falhaDoEstado)); retorne
                    fim
                    sessão.pasta, sessão.pastaEstado = pasta, estado
                    sessão.estado = "selecionada"
                    sessão.somenteLeitura = comando == "EXAMINE"
                    local primeiraNãoLida = 0
                    para índice, mensagem em ipares(estado.mensagens) início
                        se não mensagem.lida então primeiraNãoLida = índice; pare fim
                    fim
                    local resposta =
                        "* FLAGS (\\Seen \\Flagged \\Deleted)" .. CRLF ..
                        "* " .. estado.quantidade .. " EXISTS" .. CRLF ..
                        "* 0 RECENT" .. CRLF ..
                        "* OK [UIDVALIDITY " .. estado.validadeUID .. "] UIDs validos" .. CRLF ..
                        "* OK [UIDNEXT " .. estado.próximoUID .. "] proximo UID" .. CRLF ..
                        "* OK [UNSEEN " .. primeiraNãoLida .. "] primeira nao lida" .. CRLF ..
                        "* OK [PERMANENTFLAGS (\\Seen \\Flagged \\Deleted)] sinalizadores" .. CRLF
                    conclua(sessão, etiqueta, "OK",
                        comando == "EXAMINE" e "[READ-ONLY] pasta selecionada" ou
                            "[READ-WRITE] pasta selecionada", resposta)
                fim)
            retorne
        fim

        se sessão.estado ~= "selecionada" então
            conclua(sessão, etiqueta, "NO", "selecione uma pasta primeiro")
            retorne
        fim
        se comando == "UNSELECT" então
            sessão.estado, sessão.pasta, sessão.pastaEstado =
                "autenticada", nulo, nulo
            conclua(sessão, etiqueta, "OK", "UNSELECT concluído"); retorne
        fim
        se comando == "CLOSE" então
            local uids = {}
            para _, mensagem em ipares(sessão.pastaEstado.mensagens ou {}) início
                se mensagem.apagadaNoIMAP então
                    uids[#uids + 1] = paraColar(mensagem.uid)
                fim
            fim
            local função encerrePasta()
                sessão.estado, sessão.pasta, sessão.pastaEstado =
                    "autenticada", nulo, nulo
                conclua(sessão, etiqueta, "OK", "CLOSE concluído")
            fim
            se #uids == 0 então encerrePasta(); retorne fim
            se sessão.pasta == "lixeira" então
                removaItensDaLixeira(sessão, etiqueta,
                    tabela.concatene(uids, ","), verdadeiro, verdadeiro,
                    encerrePasta)
            senão
                movaItens(sessão, etiqueta, tabela.concatene(uids, ","),
                    "Lixeira", verdadeiro, verdadeiro, verdadeiro,
                    encerrePasta)
            fim
            retorne
        fim
        se comando == "IDLE" então
            sessão.ociosa = etiqueta
            sessão.estadoOcioso = copieEstadoOcioso(sessão.pastaEstado)
            envie(sessão, "+ aguardando" .. CRLF,
                função()
                    armeOcioso(sessão)
                    prossiga(sessão)
                fim); retorne
        fim
        se comando == "FETCH" então
            local conjunto, atributos = restante:separe(
                "^([^ \t]+)[ \t]+(.+)$")
            se não conjunto então
                conclua(sessão, etiqueta, "BAD", "FETCH inválido")
            senão executeFETCH(sessão, etiqueta, conjunto, atributos, falso) fim
            retorne
        fim
        se comando == "SEARCH" então
            executeSEARCH(sessão, etiqueta, restante, falso); retorne
        fim
        se comando == "STORE" então
            local conjunto, alteração = restante:separe(
                "^([^ \t]+)[ \t]+(.+)$")
            se não conjunto então conclua(sessão, etiqueta, "BAD", "STORE inválido")
            senão executeSTORE(sessão, etiqueta, conjunto, alteração, falso) fim
            retorne
        fim
        se comando == "COPY" então
            local conjunto, destino = restante:separe(
                "^([^ \t]+)[ \t]+(.+)$")
            se não conjunto então conclua(sessão, etiqueta, "BAD", "COPY inválido")
            senão copieItens(sessão, etiqueta, conjunto, destino, falso) fim
            retorne
        fim
        se comando == "MOVE" então
            local conjunto, destino = restante:separe(
                "^([^ \t]+)[ \t]+(.+)$")
            se não conjunto então conclua(sessão, etiqueta, "BAD", "MOVE inválido")
            senão movaItens(sessão, etiqueta, conjunto, destino, falso, falso) fim
            retorne
        fim
        se comando == "EXPUNGE" então
            local uids = {}
            para _, mensagem em ipares(sessão.pastaEstado.mensagens ou {}) início
                se mensagem.apagadaNoIMAP então
                    uids[#uids + 1] = paraColar(mensagem.uid)
                fim
            fim
            se #uids == 0 então
                conclua(sessão, etiqueta, "OK", "EXPUNGE concluído")
            senão se sessão.pasta == "lixeira" então
                removaItensDaLixeira(sessão, etiqueta,
                    tabela.concatene(uids, ","), verdadeiro, falso)
            senão
                movaItens(sessão, etiqueta, tabela.concatene(uids, ","),
                    "Lixeira", verdadeiro, verdadeiro)
            fim fim
            retorne
        fim
        se comando == "UID" então
            local subcomando, argumentos = restante:separe(
                "^([^ \t]+)[ \t]+(.+)$")
            subcomando = subcomando e subcomando:maiúscula() ou ""
            se #sessão.rastro > 0 então
                sessão.rastro[#sessão.rastro] = "UID " .. subcomando
            fim
            se subcomando == "FETCH" então
                local conjunto, atributos = argumentos:separe(
                    "^([^ \t]+)[ \t]+(.+)$")
                se conjunto então executeFETCH(sessão, etiqueta, conjunto, atributos, verdadeiro)
                senão conclua(sessão, etiqueta, "BAD", "UID FETCH inválido") fim
            senão se subcomando == "SEARCH" então
                executeSEARCH(sessão, etiqueta, argumentos, verdadeiro)
            senão se subcomando == "STORE" então
                local conjunto, alteração = argumentos:separe(
                    "^([^ \t]+)[ \t]+(.+)$")
                se conjunto então executeSTORE(sessão, etiqueta, conjunto, alteração, verdadeiro)
                senão conclua(sessão, etiqueta, "BAD", "UID STORE inválido") fim
            senão se subcomando == "COPY" então
                local conjunto, destino = argumentos:separe(
                    "^([^ \t]+)[ \t]+(.+)$")
                se conjunto então copieItens(sessão, etiqueta, conjunto, destino, verdadeiro)
                senão conclua(sessão, etiqueta, "BAD", "UID COPY inválido") fim
            senão se subcomando == "MOVE" então
                local conjunto, destino = argumentos:separe(
                    "^([^ \t]+)[ \t]+(.+)$")
                se conjunto então movaItens(sessão, etiqueta, conjunto, destino, verdadeiro, falso)
                senão conclua(sessão, etiqueta, "BAD", "UID MOVE inválido") fim
            senão se subcomando == "EXPUNGE" então
                se argumentos e apare(argumentos) ~= "" então
                    expurgueUID(sessão, etiqueta, apare(argumentos))
                senão
                    conclua(sessão, etiqueta, "BAD", "UID EXPUNGE inválido")
                fim
            senão
                emita(configuração.pulso, "sinal",
                    "correio.imapComandoNãoImplementado", {
                        endereço = sessão.endereço,
                        comando = "UID " .. subcomando
                    })
                conclua(sessão, etiqueta, "BAD", "subcomando UID não implementado")
            fim fim fim fim fim fim
            retorne
        fim
        se comando == "CREATE" ou comando == "DELETE" ou comando == "RENAME" então
            conclua(sessão, etiqueta, "NO",
                "[CANNOT] operação não disponível nesta versão")
            retorne
        fim
        emita(configuração.pulso, "sinal",
            "correio.imapComandoNãoImplementado", {
                endereço = sessão.endereço, comando = comando
            })
        conclua(sessão, etiqueta, "BAD", "comando não implementado")
    fim

    processeEntrada = função(sessão)
        se sessão.fechada ou sessão.aguardando então retorne fim
        se sessão.literalPendente então
            local pedido = sessão.literalPendente
            local terminador = pedido.terminador ou CRLF
            se #sessão.acumulado < pedido.tamanho + #terminador então
                leiaMais(sessão); retorne
            fim
            local mime = sessão.acumulado:corte(1, pedido.tamanho)
            local término = sessão.acumulado:corte(
                pedido.tamanho + 1, pedido.tamanho + #terminador)
            se término ~= terminador então
                envie(sessão, pedido.etiqueta ..
                    " BAD literal APPEND com fechamento inválido" .. CRLF ..
                    "* BYE fluxo IMAP nao pode ser retomado" .. CRLF,
                    função() encerre(sessão) fim)
                retorne
            fim
            sessão.acumulado = sessão.acumulado:corte(
                pedido.tamanho + #terminador + 1)
            sessão.literalPendente = nulo
            sessão.aguardando = verdadeiro
            executeAPPEND(sessão, pedido, mime)
            retorne
        fim
        local fimDaLinha = sessão.acumulado:procure(CRLF, 1, verdadeiro)
        se não fimDaLinha então
            se #sessão.acumulado > configuração.limiteLinha então
                envie(sessão, "* BYE linha IMAP grande demais" .. CRLF,
                    função() encerre(sessão) fim)
            senão leiaMais(sessão) fim
            retorne
        fim
        local linha = sessão.acumulado:corte(1, fimDaLinha - 1)
        sessão.acumulado = sessão.acumulado:corte(fimDaLinha + 2)
        sessão.aguardando = verdadeiro
        se sessão.ociosa então
            local etiqueta = sessão.ociosa
            sessão.ociosa = nulo
            sessão.estadoOcioso = nulo
            canceleOcioso(sessão)
            se linha:maiúscula() == "DONE" então
                conclua(sessão, etiqueta, "OK", "IDLE concluído")
            senão conclua(sessão, etiqueta, "BAD", "esperado DONE") fim
            retorne
        fim
        se sessão.autenticaçãoPendente então
            local etiqueta = sessão.autenticaçãoPendente
            sessão.autenticaçãoPendente = nulo
            se linha == "*" então
                conclua(sessão, etiqueta, "BAD", "autenticação cancelada")
                retorne
            fim
            local usuário, senha = decodifiquePLAIN(linha)
            se não usuário então
                conclua(sessão, etiqueta, "NO",
                    "[AUTHENTICATIONFAILED] credencial inválida")
            senão autentique(sessão, etiqueta, usuário, senha) fim
            retorne
        fim
        trateComando(sessão, linha)
    fim

    local função novaSessão(conexão)
        local par = conexão:parRemoto()
        local endereçoRemoto = par e par.endereço ou "desconhecido"
        local admitida, decisão = servidor.vigia:admita(endereçoRemoto)
        se não admitida então
            conexão:feche()
            emita(configuração.pulso, "sinal", "correio.imapConexãoLimitada",
                { endereço = endereçoRemoto,
                  motivo = decisão e decisão.motivo ou "limite local" }, "alta")
            retorne
        fim
        local sessão = {
            conexão = conexão, endereço = endereçoRemoto,
            acumulado = "", estado = "nãoAutenticada", aguardando = verdadeiro,
            fechada = falso, comandos = 0, tentativas = 0,
            saídas = {}, enviando = falso, rastro = [], utf8Aceito = falso
        }
        conexão:definaTempoLimite(configuração.tempoLimite)
        servidor.conexões[sessão] = verdadeiro
        servidor.total = servidor.total + 1
        conexão:aceiteTLSAssíncrono(servidor.certificado,
            função(_, falhaTLS)
                se falhaTLS então encerre(sessão); retorne fim
                emita(configuração.pulso, "leitura",
                    "correio.imapConexãoAceita", { endereço = endereçoRemoto })
                envie(sessão, "* OK [CAPABILITY " ..
                    capacidadesComAutenticação .. "] " ..
                    textoDeProtocolo(configuração.nome) ..
                    " Correio Santafe" .. CRLF,
                    função() prossiga(sessão) fim)
            fim)
    fim

    local função armeAceite()
        se servidor.fechado então retorne fim
        servidor.receptor:aceiteAssíncrono(
            função(_, conexão, falhaDoAceite)
                se servidor.fechado então
                    se conexão então conexão:feche() fim
                    retorne
                fim
                armeAceite()
                se falhaDoAceite então
                    emita(configuração.pulso, "sinal",
                        "correio.imapAceiteFalhou", { falha = falhaDoAceite }, "alta")
                    retorne
                fim
                novaSessão(conexão)
            fim)
    fim

    função servidor.inicie(este)
        se este.fechado então retorne nulo, "servidor IMAP fechado" fim
        se este.iniciado então retorne este fim
        local amarrou, falhaDoEnlace = este.receptor:amarre(endereço, porta)
        se não amarrou então retorne nulo, falhaDoEnlace fim
        este.iniciado = verdadeiro
        armeAceite()
        emita(configuração.pulso, "sinal", "correio.imapIniciado", {
            endereço = endereço, porta = porta, segurança = "TLS"
        })
        retorne este
    fim

    função servidor.escute(este)
        local iniciou, falhaDoInício = este:inicie()
        se não iniciou então retorne nulo, falhaDoInício fim
        rede.laço()
        retorne verdadeiro
    fim

    função servidor.feche(este)
        se este.fechado então retorne verdadeiro fim
        este.fechado = verdadeiro
        este.receptor:feche()
        local ativas = {}
        para sessão em pares(este.conexões) início ativas[#ativas + 1] = sessão fim
        para _, sessão em ipares(ativas) início encerre(sessão) fim
        rede.pareLaço()
        retorne verdadeiro
    fim

    retorne servidor
fim

retorne imap
