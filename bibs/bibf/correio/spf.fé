local função apliqueMecanismo(contexto, domínio, termo, tratador)
    local nome, valor, qualificador = analiseAtributo(termo)
    local resposta = qualificadores[qualificador]
    local função conclua(confere, falha, natureza)
        se falha então
            tratador(resultado(natureza == "temporário" e "erroTemporário" ou
                "erroPermanente", domínio, termo, falha))
        senão se confere então
            tratador(resultado(resposta, domínio, termo))
        senão
            tratador(nulo)
        fim fim
    fim

    se nome == "all" então conclua(verdadeiro); retorne fim
    se nome == "ip4" ou nome == "ip6" então
        local família = nome == "ip6" e 6 ou 4
        local redeInformada, ticos, falha = prefixoDoMecanismo(valor, família)
        se não redeInformada então conclua(nulo, falha, "permanente"); retorne fim
        local confere, falhaDaRede = acesso.pertence(contexto.endereço,
            redeInformada .. "/" .. ticos)
        se confere == nulo então conclua(nulo, falhaDaRede, "permanente")
        senão conclua(confere) fim
        retorne
    fim
    se nome == "a" então
        local alvo, prefixo4, prefixo6, falhaDoPrefixo =
            separeAlvoEPrefixos(valor)
        se não alvo então
            conclua(nulo, falhaDoPrefixo, "permanente"); retorne
        fim
        local expandido, falha = expandaDomínio(alvo ~= "" e alvo ou domínio,
            contexto, domínio)
        se não expandido então
            conclua(nulo, falha, "permanente"); retorne
        fim
        algumEndereço(contexto, expandido, prefixo4, prefixo6, conclua)
        retorne
    fim
    se nome == "mx" então
        local alvo, prefixo4, prefixo6, falhaDoPrefixo =
            separeAlvoEPrefixos(valor)
        se não alvo então
            conclua(nulo, falhaDoPrefixo, "permanente"); retorne
        fim
        alvo = alvo ~= "" e alvo ou domínio
        local expandido, falha = expandaDomínio(alvo, contexto, domínio)
        se não expandido então conclua(nulo, falha, "permanente"); retorne fim
        consulta(contexto, contexto.consulteMX, expandido,
            função(registros, falhaMX, natureza)
                se não registros então conclua(nulo, falhaMX, natureza); retorne fim
                se #registros > 10 então
                    conclua(nulo, "mecanismo mx excedeu dez destinos", "permanente")
                    retorne
                fim
                local função próximo(índice)
                    se índice > #registros então conclua(falso); retorne fim
                    local endereço = registros[índice].endereço ou registros[índice]
                    algumEndereço(contexto, endereço, prefixo4, prefixo6,
                        função(confere, falhaDoEndereço, naturezaDoErro)
                            se falhaDoEndereço então
                                conclua(nulo, falhaDoEndereço, naturezaDoErro)
                            senão se confere então conclua(verdadeiro)
                            senão próximo(índice + 1) fim fim
                        fim, falso, 10)
                fim
                próximo(1)
            fim)
        retorne
    fim
    se nome == "include" então
        local expandido, falha = expandaDomínio(valor, contexto, domínio)
        se não expandido então conclua(nulo, falha, "permanente"); retorne fim
        local pode, falhaDoLimite = conteConsulta(contexto)
        se não pode então
            conclua(nulo, falhaDoLimite, "permanente"); retorne
        fim
        avalieDomínio(contexto, expandido, função(incluído)
            se incluído.resultado == "passa" então conclua(verdadeiro)
            senão se incluído.resultado == "erroTemporário" então
                conclua(nulo, incluído.explicação, "temporário")
            senão se incluído.resultado == "erroPermanente" ou
                     incluído.resultado == "nenhum" então
                conclua(nulo, incluído.explicação ou
                    "include sem política SPF", "permanente")
            senão conclua(falso) fim fim fim
        fim)
        retorne
    fim
    se nome == "exists" então
        local expandido, falha = expandaDomínio(valor, contexto, domínio)
        se não expandido então conclua(nulo, falha, "permanente"); retorne fim
        consulta(contexto, contexto.resolvaEndereços, expandido,
            função(endereços, falhaDNS, natureza)
                se não endereços então conclua(nulo, falhaDNS, natureza)
                senão conclua(#endereços > 0) fim
            fim)
        retorne
    fim
    se nome == "ptr" então
        conclua(nulo, "mecanismo ptr é desaconselhado pela RFC 7208 e não é aceito",
            "permanente")
        retorne
    fim
    conclua(nulo, "mecanismo SPF desconhecido: " .. paraColar(nome), "permanente")
fim

avalieDomínio = função(contexto, domínio, tratador)
    domínio = domínioCanônico(domínio)
    se não domínio então
        tratador(resultado("nenhum", domínio, nulo, "domínio SPF inválido")); retorne
    fim
    contexto.profundidade = contexto.profundidade + 1
    se contexto.profundidade > 20 ou contexto.visitados[domínio] então
        contexto.profundidade = contexto.profundidade - 1
        tratador(resultado("erroPermanente", domínio, nulo,
            "ciclo ou profundidade excessiva na política SPF"))
        retorne
    fim
    contexto.visitados[domínio] = verdadeiro
    consulta(contexto, contexto.consulteTXT, domínio,
        função(registros, falhaDNS, natureza)
            local função finalize(valor)
                contexto.visitados[domínio] = nulo
                contexto.profundidade = contexto.profundidade - 1
                tratador(valor)
            fim
            se não registros então
                finalize(resultado(natureza == "temporário" e "erroTemporário" ou
                    "erroPermanente", domínio, nulo, falhaDNS)); retorne
            fim
            local políticas = {}
            para _, registro em ipares(registros) início
                local texto = tipo(registro) == "tabela" e registro.valor ou registro
                local baixo = texto e texto:minúscula() ou ""
                se baixo:corte(1, 6) == "v=spf1" e
                   (baixo:corte(7, 7) == "" ou baixo:corte(7, 7) == " ") então
                    políticas[#políticas + 1] = texto
                fim
            fim
            se #políticas == 0 então
                finalize(resultado("nenhum", domínio, nulo, "domínio sem SPF")); retorne
            fim
            se #políticas > 1 então
                finalize(resultado("erroPermanente", domínio, nulo,
                    "domínio publica mais de uma política SPF")); retorne
            fim
            local termos = {}
            para termo em políticas[1]:capture("[^ ]+") início
                se termo:minúscula() ~= "v=spf1" então termos[#termos + 1] = termo fim
            fim
            local redireção
            local mecanismos = {}
            para _, termo em ipares(termos) início
                local nome, valor = analiseAtributo(termo)
                se nome == "redirect" então
                    se redireção então
                        finalize(resultado("erroPermanente", domínio, termo,
                            "política SPF possui mais de um redirect")); retorne
                    fim
                    redireção = valor
                senão se nome ~= "exp" então
                    mecanismos[#mecanismos + 1] = termo
                fim fim
            fim
            local função próximo(índice)
                se índice > #mecanismos então
                    se redireção então
                        local destino, falha = expandaDomínio(redireção, contexto, domínio)
                        se não destino então
                            finalize(resultado("erroPermanente", domínio,
                                "redirect", falha)); retorne
                        fim
                        local pode, falhaDoLimite = conteConsulta(contexto)
                        se não pode então
                            finalize(resultado("erroPermanente", domínio,
                                "redirect", falhaDoLimite))
                            retorne
                        fim
                        avalieDomínio(contexto, destino, finalize)
                    senão
                        finalize(resultado("neutro", domínio))
                    fim
                    retorne
                fim
                apliqueMecanismo(contexto, domínio, mecanismos[índice],
                    função(avaliação)
                        se avaliação então finalize(avaliação)
                        senão próximo(índice + 1) fim
                    fim)
            fim
            próximo(1)
        fim, falso)
fim

função spf.verifiqueAssíncrono(opções, tratador)
    se tipo(tratador) ~= "função" então
        retorne nulo, "tratador SPF deve ser uma função"
    fim
    opções = opções ou {}
    local contexto = novoContexto(opções)
    local domínio = domínioDoEndereço(opções.remetente)
    se não domínio ou domínio == "" então
        domínio = opções.nomeDoCliente
        contexto.remetente = "postmaster@" .. paraColar(domínio ou "")
    fim
    domínio = domínioCanônico(domínio)
    se não domínio então
        tratador(resultado("nenhum", nulo, nulo, "identidade SPF inválida"))
        retorne verdadeiro
    fim
    avalieDomínio(contexto, domínio, tratador)
    retorne verdadeiro
fim

retorne spf
