-- SPF assíncrono para a identidade MAIL FROM, conforme a RFC 7208.
-- O módulo conserva os limites de consultas entre inclusões e redireções;
-- uma política maliciosa não consegue provocar resolução DNS ilimitada.

local rede = importe "rede"
local acesso = importe "nomes.acesso"

local spf = { nome = "SPF do Correio Santafé", versão = "1.0.0" }

local qualificadores = {
    ["+"] = "passa", ["-"] = "falha",
    ["~"] = "falhaSuave", ["?"] = "neutro"
}

local função domínioDoEndereço(endereço)
    endereço = paraColar(endereço ou ""):apare()
    local arroba = endereço:procure("@", 1, verdadeiro)
    se não arroba então retorne nulo fim
    retorne endereço:corte(arroba + 1)
fim

local função parteLocal(endereço)
    endereço = paraColar(endereço ou ""):apare()
    local arroba = endereço:procure("@", 1, verdadeiro)
    retorne arroba e endereço:corte(1, arroba - 1) ou endereço
fim

local função domínioCanônico(domínio)
    local resultado = rede.domínioASCII((domínio ou ""):apare())
    se não resultado ou resultado == "" ou #resultado > 253 então retorne nulo fim
    retorne resultado:minúscula()
fim

local função resultado(nome, domínio, mecanismo, explicação)
    retorne { resultado = nome, domínio = domínio,
        mecanismo = mecanismo, explicação = explicação }
fim

local função novoContexto(opções)
    opções = opções ou {}
    local contexto = {
        endereço = opções.endereço,
        remetente = opções.remetente,
        nomeDoCliente = opções.nomeDoCliente ou "desconhecido",
        nomeDoServidor = opções.nomeDoServidor ou "localhost",
        limiteDNS = opções.limiteDNS ou 10,
        limiteVazio = opções.limiteVazio ou 2,
        consultas = 0, vazias = 0, visitados = {}, profundidade = 0,
        tempoLimite = opções.tempoLimite ou 5000
    }
    contexto.consulteTXT = opções.consulteTXT ou função(nome, tratador)
        rede.consulteDNSAssíncrono(nome, "TXT",
            { tempoLimite = contexto.tempoLimite }, tratador)
        retorne verdadeiro
    fim
    contexto.consulteMX = opções.consulteMX ou função(nome, tratador)
        rede.consulteDNSAssíncrono(nome, "MX",
            { tempoLimite = contexto.tempoLimite }, tratador)
        retorne verdadeiro
    fim
    contexto.resolvaEndereços = opções.resolvaEndereços ou função(nome, tratador)
        rede.resolvaEndereçosAssíncrono(nome,
            { tempoLimite = contexto.tempoLimite }, tratador)
        retorne verdadeiro
    fim
    retorne contexto
fim

local função conteConsulta(contexto)
    contexto.consultas = contexto.consultas + 1
    se contexto.consultas > contexto.limiteDNS então
        retorne nulo, "política SPF excedeu o limite de consultas DNS"
    fim
    retorne verdadeiro
fim

local função consulta(contexto, funçãoDNS, nome, tratador, conteTermo)
    se conteTermo ~= falso então
        local pode, falha = conteConsulta(contexto)
        se não pode então tratador(nulo, falha, "permanente"); retorne fim
    fim
    local iniciou, falhaImediata = funçãoDNS(nome,
        função(registros, falhaDNS)
            se falhaDNS então tratador(nulo, falhaDNS, "temporário"); retorne fim
            registros = registros ou {}
            se #registros == 0 então
                contexto.vazias = contexto.vazias + 1
                se contexto.vazias > contexto.limiteVazio então
                    tratador(nulo, "política SPF excedeu consultas DNS vazias",
                        "permanente")
                    retorne
                fim
            fim
            tratador(registros)
        fim)
    se iniciou == nulo e falhaImediata então
        tratador(nulo, falhaImediata, "temporário")
    fim
fim

local função expandaDomínio(texto, contexto, domínio)
    texto = texto ou domínio
    local saída = {}
    local posição = 1
    enquanto posição <= #texto início
        local porcento = texto:procure("%", posição, verdadeiro)
        se não porcento então saída[#saída + 1] = texto:corte(posição); pare fim
        saída[#saída + 1] = texto:corte(posição, porcento - 1)
        local próximo = texto:corte(porcento + 1, porcento + 1)
        se próximo == "%" então saída[#saída + 1] = "%"; posição = porcento + 2
        senão se próximo == "_" então saída[#saída + 1] = " "; posição = porcento + 2
        senão se próximo == "-" então saída[#saída + 1] = "%20"; posição = porcento + 2
        senão se próximo == "{" então
            local fecha = texto:procure("}", porcento + 2, verdadeiro)
            se não fecha então retorne nulo, "macro SPF sem fechamento" fim
            local expressão = texto:corte(porcento + 2, fecha - 1)
            -- Os transformadores completos de macros não são necessários
            -- para a autorização comum. Recusar explicitamente evita que
            -- uma construção desconhecida produza autorização falsa.
            se #expressão ~= 1 então
                retorne nulo, "transformador de macro SPF ainda não aceito"
            fim
            local letra = expressão:minúscula()
            local valores = {
                s = contexto.remetente, l = parteLocal(contexto.remetente),
                o = domínioDoEndereço(contexto.remetente), d = domínio,
                i = contexto.endereço, h = contexto.nomeDoCliente,
                v = contexto.endereço:procure(":", 1, verdadeiro) e "ip6" ou "em-addr",
                r = contexto.nomeDoServidor
            }
            se não valores[letra] então retorne nulo, "macro SPF não aceita: " .. expressão fim
            saída[#saída + 1] = valores[letra]
            posição = fecha + 1
        senão
            retorne nulo, "escape de macro SPF inválido"
        fim fim fim fim
    fim
    local expandido = domínioCanônico(tabela.concatene(saída))
    se não expandido então retorne nulo, "macro SPF produziu domínio inválido" fim
    retorne expandido
fim

local função prefixoDoMecanismo(valor, família)
    local padrão = família == 6 e "/([0-9]+)$" ou "/([0-9]+)$"
    local tamanho = valor:separe(padrão)
    se tamanho então
        valor = valor:troque("/[0-9]+$", "")
        tamanho = mat.paraInteiro(paraNúmero(tamanho))
    fim
    local máximo = família == 6 e 128 ou 32
    se tamanho == nulo então tamanho = máximo fim
    se tamanho < 0 ou tamanho > máximo então
        retorne nulo, nulo, "prefixo SPF fora do intervalo"
    fim
    retorne valor, tamanho
fim

local função algumEndereço(contexto, nome, prefixo4, prefixo6, tratador,
                                  conteTermo, limiteDeEndereços)
    consulta(contexto, contexto.resolvaEndereços, nome,
        função(endereços, falha, natureza)
            se não endereços então tratador(nulo, falha, natureza); retorne fim
            se limiteDeEndereços e #endereços > limiteDeEndereços então
                tratador(nulo, "mecanismo mx excedeu dez endereços",
                    "permanente")
                retorne
            fim
            para _, endereço em ipares(endereços) início
                local ticos = endereço:procure(":", 1, verdadeiro) e prefixo6 ou prefixo4
                local pertence = acesso.pertence(contexto.endereço,
                    endereço .. "/" .. ticos)
                se pertence então tratador(verdadeiro); retorne fim
            fim
            tratador(falso)
        fim, conteTermo)
fim

local função analiseAtributo(termo)
    local qualificador = qualificadores[termo:corte(1, 1)] e
        termo:corte(1, 1) ou "+"
    se qualificador ~= "+" então termo = termo:corte(2) fim
    local nome, restante = termo:separe("^([^:=/]+)(.*)$")
    se não nome então retorne nulo, "", qualificador fim
    local primeiro = restante:corte(1, 1)
    local valor = (primeiro == ":" ou primeiro == "=") e
        restante:corte(2) ou restante
    retorne nome:minúscula(), valor, qualificador
fim

local função separeAlvoEPrefixos(valor)
    local alvo = valor ou ""
    local prefixo4, prefixo6 = 32, 128
    local barraDupla = alvo:procure("//", 1, verdadeiro)
    se barraDupla então
        local informado6 = alvo:corte(barraDupla + 2)
        se informado6 == "" ou informado6:separe("^[0-9]+$") == nulo então
            retorne nulo, nulo, nulo, "prefixo IPv6 inválido"
        fim
        prefixo6 = paraNúmero(informado6) ou -1
        alvo = alvo:corte(1, barraDupla - 1)
    fim
    local base, informado4 = alvo:separe("^(.-)/([0-9]+)$")
    se base então
        alvo = base
        prefixo4 = paraNúmero(informado4) ou -1
    senão se alvo:procure("/", 1, verdadeiro) então
        retorne nulo, nulo, nulo, "prefixo IPv4 inválido"
    fim fim
    se prefixo4 < 0 ou prefixo4 > 32 ou
       prefixo6 < 0 ou prefixo6 > 128 então
        retorne nulo, nulo, nulo, "prefixo de endereço fora do intervalo"
    fim
    retorne alvo, prefixo4, prefixo6
fim

