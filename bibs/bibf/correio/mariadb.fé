    função este.decidaTriagemDaCarta(_, caixaId, cartaId, decisão, tratador)
        decisão = paraColar(decisão ou ""):minúscula():apare()
        se decisão ~= "regular" e decisão ~= "indesejada" então
            tratador(nulo, "decisão deve ser regular ou indesejada"); retorne
        fim
        piscina:inicieTransaçãoAssíncrona(
            função(_, transação, falhaDaTransação)
                se falhaDaTransação então tratador(nulo, falhaDaTransação); retorne fim
                execute(transação, [=[SELECT remetente,direcao
FROM correio_cartas WHERE caixa_id=? AND id=? FOR UPDATE]=],
                    { caixaId, cartaId }, função(consulta, falhaDaConsulta)
                        se falhaDaConsulta então
                            feche(consulta); desfaça(transação, tratador,
                                falhaDaConsulta); retorne
                        fim
                        local linha = consulta:obterLinha()
                        feche(consulta)
                        se não linha ou linha[2] ~= "entrada" então
                            desfaça(transação, tratador,
                                "carta de entrada não encontrada"); retorne
                        fim
                        local endereço = normalizeRemetente(linha[1])
                        se não endereço então
                            desfaça(transação, tratador,
                                "remetente da carta é inválido"); retorne
                        fim
                        local regra = decisão == "regular" e
                            "permitir" ou "separar"
                        execute(transação, [=[INSERT INTO correio_regras_triagem
(caixa_id,escopo,valor,decisao) VALUES (?,'endereco',?,?)
ON DUPLICATE KEY UPDATE decisao=VALUES(decisao),
atualizada_em=CURRENT_TIMESTAMP]=],
                            { caixaId, endereço, regra },
                            função(inclusão, falhaDaRegra)
                                feche(inclusão)
                                se falhaDaRegra então
                                    desfaça(transação, tratador,
                                        falhaDaRegra); retorne
                                fim
                                local pasta = decisão == "regular" e
                                    "entrada" ou "indesejadas"
                                execute(transação, [=[UPDATE correio_cartas
SET pasta=?,decisao_usuario=?,regra_triagem=?,decidida_em=?,atualizada_em=?
WHERE caixa_id=? AND id=?]=], {
                                    pasta, decisão, "endereco:" .. endereço,
                                    so.tempo(), so.tempo(), caixaId, cartaId
                                }, função(atualização, falhaDaAtualização)
                                    feche(atualização)
                                    se falhaDaAtualização então
                                        desfaça(transação, tratador,
                                            falhaDaAtualização); retorne
                                    fim
                                    local ação = decisão == "regular" e
                                        "marcou_regular" ou "marcou_indesejada"
                                    execute(transação, [=[INSERT INTO correio_historico_triagem
(caixa_id,carta_id,acao,escopo,valor) VALUES (?,? ,?,'endereco',?)]=],
                                        { caixaId, cartaId, ação, endereço },
                                        função(histórico, falhaDoHistórico)
                                            feche(histórico)
                                            se falhaDoHistórico então
                                                desfaça(transação, tratador,
                                                    falhaDoHistórico); retorne
                                            fim
                                            confirme(transação, tratador, {
                                                pasta = pasta, decisão = decisão,
                                                escopo = "endereço", valor = endereço
                                            })
                                        fim)
                                fim)
                            fim)
                    fim)
            fim)
    fim

    função este.adicioneSaída(_, caixa, mensagem, fila, tratador)
        local mime, falhaDaFormação = mensagem:forme()
        se não mime então tratador(nulo, falhaDaFormação); retorne fim
        local dadosDaMensagem = {
            direção = "saída", pasta = "enviadas",
            identificação = mensagem.identificação,
            remetente = mensagem.remetenteDaCópia ou mensagem.remetente,
            remetenteEnvelope = mensagem.remetente,
            destinatários = {
                ["para"] = mensagem.destinatáriosPrincipais,
                cópia = mensagem.cópia,
                cópiaOculta = mensagem.cópiaOculta
            },
            assunto = mensagem.assunto,
            resumo = util.resumo(mensagem.texto ou mensagem.html, 280),
            texto = mensagem.texto, html = mensagem.html, mime = mime,
            anexos = mensagem.anexos, lida = verdadeiro,
            responderPara = mensagem.remetente,
            estadoDaEntrega = "pendente", criadaEm = so.tempo()
        }
        retorne prepareConteúdos(dadosDaMensagem,
            função(_, falhaDoDepósito)
                se falhaDoDepósito então
                    tratador(nulo, falhaDoDepósito); retorne
                fim
                local iniciou, falha = piscina:inicieTransaçãoAssíncrona(
                    função(_, transação, falhaDaTransação)
                        se falhaDaTransação então
                            tratador(nulo, falhaDaTransação); retorne
                        fim
                        local filaDaTransação = correio.filaMariaDB(
                            transação,
                            { tabela = fila.tabela, depósito = objetos })
                        filaDaTransação:adicioneFormadaAssíncrono(
                            mensagem, mime, {
                                resumo = dadosDaMensagem.mimeObjeto,
                                tamanho = #mime
                            },
                            função(idDaFila, falhaDaFila)
                                se falhaDaFila então
                                    desfaça(transação, tratador, falhaDaFila)
                                    retorne
                                fim
                                dadosDaMensagem.referênciaFila = idDaFila
                                reserveCota(transação, caixa.id,
                                    dadosDaMensagem, função(_, falhaDaCota)
                                        se falhaDaCota então
                                            desfaça(transação, tratador,
                                                falhaDaCota)
                                            retorne
                                        fim
                                        insiraMensagem(transação, caixa.id,
                                            dadosDaMensagem,
                                            função(idDaMensagem,
                                                   falhaDaMensagem)
                                                se falhaDaMensagem então
                                                    desfaça(transação, tratador,
                                                        falhaDaMensagem)
                                                    retorne
                                                fim
                                                confirme(transação, tratador, {
                                                    mensagem = idDaMensagem,
                                                    fila = idDaFila
                                                })
                                            fim)
                                    fim)
                            fim)
                    fim)
                se falha então tratador(nulo, falha) fim
                retorne iniciou
            fim)
    fim

    função este.atualizeEntrega(_, idDaFila, estado, falhaDaEntrega, tratador)
        execute(piscina, [=[UPDATE correio_cartas
SET estado_entrega=?,falha_entrega=?,atualizada_em=? WHERE referencia_fila=?]=],
            { estado, falhaDaEntrega, so.tempo(), idDaFila },
            função(resultado, falha)
                local alteradas = resultado e resultado:linhasAfetadas() ou 0
                feche(resultado); se tratador então tratador(alteradas, falha) fim
            fim)
    fim

    função este.entregueAvisoDaFila(_, aviso, tratador)
        se tipo(aviso) ~= "tabela" ou
           mat.paraInteiro(aviso.fila) == nulo ou
           (aviso.tipo ~= "atraso" e aviso.tipo ~= "falha") ou
           tipo(aviso.detalhes) ~= "tabela" então
            tratador(nulo, "aviso de entrega inválido"); retorne
        fim
        execute(piscina, [=[SELECT c.caixa_id,c.identificacao,c.remetente,
c.assunto,c.mime,c.mime_objeto,c.tamanho,f.criada_em
FROM correio_cartas c
JOIN correio_fila f ON f.id=c.referencia_fila
WHERE c.referencia_fila=? AND c.direcao='saida'
ORDER BY c.id LIMIT 1]=], { aviso.fila }, função(resultado, falha)
            se falha então feche(resultado); tratador(nulo, falha); retorne fim
            local linha = resultado:obterLinha()
            feche(resultado)
            se não linha então
                tratador(nulo, "carta de origem do aviso não foi encontrada")
                retorne
            fim

            local função prepareAviso(mimeOriginal)
                local detalhes = aviso.detalhes
                local formado, falhaDaFormação = Entrega.formeAviso({
                    tipo = aviso.tipo,
                    destinatário = linha[3],
                    destinatários = detalhes.destinatários ou {},
                    domínio = configuração.domínioASCII,
                    nomeDoServidor = configuração.envios e
                        configuração.envios.nome ou configuração.domínioASCII,
                    servidorRemoto = detalhes.servidorRemoto,
                    assuntoOriginal = linha[4],
                    identificaçãoOriginal = linha[2],
                    falha = detalhes.falha,
                    criadaEm = paraNúmero(linha[8]),
                    últimaTentativa = detalhes.últimaTentativa,
                    tentarAté = detalhes.tentarAté,
                    mimeOriginal = mimeOriginal
                })
                se não formado então
                    tratador(nulo, falhaDaFormação); retorne
                fim
                local agora = so.tempo()
                local dados = {
                    direção = "entrada", pasta = "entrada",
                    identificação = formado.identificação,
                    remetente = formado.remetente,
                    remetenteEnvelope = formado.remetente,
                    responderPara = formado.remetente,
                    destinatários = { ["para"] = { linha[3] } },
                    assunto = formado.assunto,
                    resumo = util.resumo(formado.texto, 280),
                    texto = formado.texto, html = nulo,
                    mime = formado.mime, anexos = {}, lida = falso,
                    estadoDaEntrega = "recebida", criadaEm = agora,
                    classificaçãoDaTriagem = "regular",
                    pontuaçãoDeSuspeita = 0,
                    motivosDaTriagem = {}
                }
                prepareConteúdos(dados, função(_, falhaDoDepósito)
                    se falhaDoDepósito então
                        tratador(nulo, falhaDoDepósito); retorne
                    fim
                    piscina:inicieTransaçãoAssíncrona(
                        função(_, transação, falhaDaTransação)
                            se falhaDaTransação então
                                tratador(nulo, falhaDaTransação); retorne
                            fim
                            execute(transação, [=[SELECT estado,carta_id
FROM correio_avisos_entrega
WHERE fila_id=? AND tipo=? FOR UPDATE]=],
                                { aviso.fila, aviso.tipo },
                                função(consulta, falhaDaConsulta)
                                    se falhaDaConsulta então
                                        feche(consulta)
                                        desfaça(transação, tratador,
                                            falhaDaConsulta)
                                        retorne
                                    fim
                                    local linhaDoAviso = consulta:obterLinha()
                                    feche(consulta)
                                    se não linhaDoAviso então
                                        desfaça(transação, tratador,
                                            "reserva do aviso não foi encontrada")
                                        retorne
                                    fim
                                    se linhaDoAviso[1] == "entregue" então
                                        confirme(transação, tratador, {
                                            carta = paraNúmero(linhaDoAviso[2]),
                                            repetido = verdadeiro
                                        })
                                        retorne
                                    fim
                                    se linhaDoAviso[1] ~= "processando" então
                                        desfaça(transação, tratador,
                                            "aviso não está reservado")
                                        retorne
                                    fim
                                    reserveCota(transação,
                                        paraNúmero(linha[1]), dados,
                                        função(_, falhaDaCota)
                                            se falhaDaCota então
                                                desfaça(transação,
                                                    tratador, falhaDaCota)
                                                retorne
                                            fim
                                            insiraMensagem(transação,
                                                paraNúmero(linha[1]), dados,
                                                função(cartaId, falhaDaMensagem)
                                                    se falhaDaMensagem então
                                                        desfaça(transação,
                                                            tratador,
                                                            falhaDaMensagem)
                                                        retorne
                                                    fim
                                                    execute(transação, [=[UPDATE correio_avisos_entrega
SET estado='entregue',carta_id=?,bilhete=NULL,arrendada_ate=NULL,
    atualizada_em=?
WHERE fila_id=? AND tipo=? AND estado='processando']=],
                                                        { cartaId, so.tempo(),
                                                          aviso.fila, aviso.tipo },
                                                        função(atualização,
                                                               falhaDaAtualização)
                                                            local alteradas =
                                                                atualização e
                                                                atualização:linhasAfetadas() ou 0
                                                            feche(atualização)
                                                            se falhaDaAtualização ou
                                                               alteradas ~= 1 então
                                                                desfaça(transação,
                                                                    tratador,
                                                                    falhaDaAtualização ou
                                                                    "aviso perdeu a reserva")
                                                                retorne
                                                            fim
                                                            confirme(transação,
                                                                tratador,
                                                                { carta = cartaId })
                                                        fim)
                                                fim)
                                        fim)
                                fim)
                        fim)
                fim)
            fim

            se linha[6] então
                objetos:leiaAssíncrono(linha[6], paraNúmero(linha[7]),
                    função(mime, falhaDoObjeto)
                        se não mime então
                            tratador(nulo, falhaDoObjeto); retorne
                        fim
                        prepareAviso(mime)
                    fim)
                retorne
            fim
            se linha[5] então prepareAviso(linha[5]); retorne fim
            tratador(nulo, "carta original não possui MIME armazenado")
        fim)
    fim

    função este.existeDestinatárioLocal(_, endereço, tratador)
        local arroba = endereço:procure("@", 1, verdadeiro)
        se não arroba então tratador(falso); retorne fim
        local parte = endereço:corte(1, arroba - 1):minúscula()
        local domínio = rede.domínioASCII(endereço:corte(arroba + 1))
        se não domínio então tratador(falso); retorne fim

        local função confiraCaixa()
            execute(piscina, [=[SELECT id FROM correio_caixas
WHERE parte_local=? AND dominio_ascii=? AND estado='ativa' LIMIT 1]=],
                { parte, domínio }, função(resultado, falha)
                    se falha então
                        feche(resultado); tratador(nulo, falha); retorne
                    fim
                    local existe = resultado:obterLinha() ~= nulo
                    feche(resultado)
                    se existe ou domínio ~= configuração.domínioASCII então
                        tratador(existe, nulo)
                        retorne
                    fim

                    -- Um usuário ativo deve receber cartas mesmo antes de abrir
                    -- o Carteiro pela primeira vez. A restrição única torna o
                    -- provisionamento seguro sob pedidos simultâneos.
                    execute(piscina, [=[INSERT INTO correio_caixas
(usuario_id,parte_local,dominio_ascii,endereco_exibido,nome_exibido)
SELECT u.id,?,?,?,u.nome FROM usuarios u
WHERE u.usuario=? AND u.estado='ativo' LIMIT 1
ON DUPLICATE KEY UPDATE nome_exibido=VALUES(nome_exibido),
endereco_exibido=VALUES(endereco_exibido)]=], {
                        parte, domínio,
                        parte .. "@" .. (configuração.domínio ou domínio),
                        parte
                    }, função(inclusão, falhaDaInclusão)
                        feche(inclusão)
                        se falhaDaInclusão então
                            tratador(nulo, falhaDaInclusão)
                            retorne
                        fim
                        execute(piscina, [=[SELECT id FROM correio_caixas
WHERE parte_local=? AND dominio_ascii=? AND estado='ativa' LIMIT 1]=],
                            { parte, domínio },
                            função(confirmação, falhaDaConfirmação)
                                se falhaDaConfirmação então
                                    feche(confirmação)
                                    tratador(nulo, falhaDaConfirmação)
                                    retorne
                                fim
                                local criou = confirmação:obterLinha() ~= nulo
                                feche(confirmação)
                                tratador(criou, nulo)
                            fim)
                    fim)
                fim)
        fim

        confiraCaixa()
    fim

    local função caixaDoDestinatário(escopo, endereço, tratador)
        local arroba = endereço:procure("@", 1, verdadeiro)
        se não arroba então tratador(nulo, "destinatário inválido"); retorne fim
        local parte = endereço:corte(1, arroba - 1):minúscula()
        local domínio, falha = rede.domínioASCII(endereço:corte(arroba + 1))
        se não domínio então tratador(nulo, falha); retorne fim
        execute(escopo, [=[SELECT id FROM correio_caixas
WHERE parte_local=? AND dominio_ascii=? AND estado='ativa' LIMIT 1]=],
            { parte, domínio }, função(resultado, falhaSQL)
                se falhaSQL então feche(resultado); tratador(nulo, falhaSQL); retorne fim
                local linha = resultado:obterLinha(); feche(resultado)
                tratador(linha e paraNúmero(linha[1]) ou nulo, nulo)
            fim)
    fim

    função este.recebaSMTP(_, envelope, tratador)
        local lida = envelope.mensagemLida
        local falha
        se não lida então
            lida, falha = correio.leiaMensagem(envelope.conteúdo)
        fim
        se não lida então tratador(nulo, falha); retorne fim
        se não lida.identificação ou lida.identificação == "" então
            lida.identificação = "<recebida." .. so.tempo() .. "." ..
                so.aleatório() .. "@" .. configuração.domínioASCII .. ">"
        fim
        local avaliação = envelope.triagem ou {
            classificação = "regular", pontuaçãoDeSuspeita = 0,
            pasta = "entrada", motivos = {}
        }
        local postal = envelope.autenticação ou {}
        local resultadoDoDMARC = postal.dmarc ou {}
        local dadosDaMensagem = {
            direção = "entrada", pasta = avaliação.pasta ou "entrada",
            identificação = lida.identificação,
            remetente = lida.remetente ou envelope.remetente,
            remetenteEnvelope = envelope.remetente,
            responderPara = lida.responderPara ou lida.remetente ou
                envelope.remetente,
            destinatários = { ["para"] = envelope.destinatários },
            assunto = lida.assunto,
            resumo = util.resumo(lida.texto ou lida.html, 280),
            texto = lida.texto, html = lida.html,
            mime = envelope.conteúdo, anexos = lida.anexos,
            lida = falso, estadoDaEntrega = "recebida",
            classificaçãoDaTriagem = avaliação.classificação,
            pontuaçãoDeSuspeita = avaliação.pontuaçãoDeSuspeita,
            motivosDaTriagem = avaliação.motivos,
            resultadoSPF = postal.spf e postal.spf.resultado,
            resultadoDKIM = postal.dkim e postal.dkim.resultado,
            resultadoDMARC = resultadoDoDMARC.resultado,
            domínioDoAutor = resultadoDoDMARC.domínioDoAutor,
            políticaDMARC = resultadoDoDMARC.política,
            açãoDMARC = resultadoDoDMARC.ação,
            criadaEm = envelope.recebidaEm ou so.tempo()
        }
        retorne prepareConteúdos(dadosDaMensagem,
            função(_, falhaDoDepósito)
                se falhaDoDepósito então
                    tratador(nulo, falhaDoDepósito); retorne
                fim
                piscina:inicieTransaçãoAssíncrona(
                    função(_, transação, falhaDaTransação)
                        se falhaDaTransação então
                            tratador(nulo, falhaDaTransação); retorne
                        fim
                        local inseridas = 0
                        local caixasInseridas = {}
                        local função insiraPróxima(índice)
                            se índice > #envelope.destinatários então
                                confirme(transação, tratador, inseridas)
                                retorne
                            fim
                            caixaDoDestinatário(
                                transação, envelope.destinatários[índice],
                                função(caixaId, falhaDaCaixa)
                                    se falhaDaCaixa ou não caixaId então
                                        desfaça(transação, tratador,
                                            falhaDaCaixa ou
                                            "caixa postal destinatária não existe")
                                        retorne
                                    fim
                                    -- RCPT TO repetido não duplica a carta.
                                    se caixasInseridas[caixaId] então
                                        insiraPróxima(índice + 1)
                                        retorne
                                    fim
                                    caixasInseridas[caixaId] = verdadeiro
                                    apliqueRegraPessoal(transação, caixaId,
                                        dadosDaMensagem,
                                        função(dadosDaCaixa, falhaDaRegra)
                                            se falhaDaRegra então
                                                desfaça(transação, tratador,
                                                    falhaDaRegra)
                                                retorne
                                            fim
                                            reserveCota(transação, caixaId,
                                                dadosDaCaixa,
                                                função(_, falhaDaCota)
                                                    se falhaDaCota então
                                                        desfaça(transação,
                                                            tratador, falhaDaCota)
                                                        retorne
                                                    fim
                                                    insiraMensagem(transação,
                                                        caixaId, dadosDaCaixa,
                                                        função(_, falhaDaMensagem)
                                                            se falhaDaMensagem então
                                                                desfaça(transação,
                                                                    tratador,
                                                                    falhaDaMensagem)
                                                                retorne
                                                            fim
                                                            inseridas = inseridas + 1
                                                            insiraPróxima(índice + 1)
                                                        fim)
                                                fim)
                                        fim)
                                fim)
                        fim
                        insiraPróxima(1)
                    fim)
            fim)
    fim

    retorne este
fim

retorne adaptador
