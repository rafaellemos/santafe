    função este.obtenhaAnexo(_, caixaId, mensagemId, anexoId, tratador)
        execute(piscina, [=[SELECT a.nome,a.tipo,a.tamanho,a.dados,a.dados_objeto
FROM correio_anexos a JOIN correio_cartas m ON m.id=a.carta_id
WHERE m.caixa_id=? AND m.id=? AND a.id=? LIMIT 1]=],
            { caixaId, mensagemId, anexoId }, função(resultado, falha)
                se falha então feche(resultado); tratador(nulo, falha); retorne fim
                local linha = resultado:obterLinha()
                feche(resultado)
                se não linha então tratador(nulo, nulo); retorne fim
                local anexo = {
                    nome = linha[1], tipo = linha[2],
                    tamanho = paraNúmero(linha[3]) ou 0
                }
                se linha[5] então
                    objetos:leiaAssíncrono(linha[5], anexo.tamanho,
                        função(dados, falhaDaLeitura)
                            se não dados então
                                tratador(nulo, falhaDaLeitura)
                                retorne
                            fim
                            anexo.dados = dados
                            tratador(anexo, nulo)
                        fim)
                    retorne
                fim
                se linha[4] == nulo então
                    tratador(nulo, "anexo sem conteúdo armazenado")
                    retorne
                fim
                anexo.dados = linha[4]
                tratador(anexo, nulo)
            fim)
    fim

