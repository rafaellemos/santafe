    -- Visão ordenada e estável consumida pelo protocolo IMAP. O UID é
    -- persistente dentro da pasta; o id continua sendo somente a chave interna.
    função este.listeMensagensIMAP(_, caixaId, pasta, tratador)
        garantaPastaIMAP(caixaId, pasta, função(estado, falhaDoEstado)
            se falhaDoEstado então tratador(nulo, falhaDoEstado); retorne fim
            execute(piscina, [=[SELECT id,direcao,pasta,identificacao,remetente,destinatarios,assunto,resumo,
texto,html,tamanho,lida,importante,estado_entrega,falha_entrega,criada_em,
atualizada_em,responder_para,classificacao_triagem,pontuacao_suspeita,
motivos_triagem,resultado_spf,resultado_dkim,resultado_dmarc,dominio_autor,
politica_dmarc,acao_dmarc,decisao_usuario,regra_triagem,decidida_em,
remetente_envelope,uid_imap,apagada_imap
FROM correio_cartas WHERE caixa_id=? AND pasta=? ORDER BY uid_imap]=],
                { caixaId, pasta }, função(resultado, falha)
                    se falha então feche(resultado); tratador(nulo, falha); retorne fim
                    local mensagens = {}
                    local nãoLidas = 0
                    enquanto verdadeiro início
                        local linha = resultado:obterLinha()
                        se não linha então pare fim
                        local mensagem = linhaDaMensagem(linha)
                        mensagem.uid = paraNúmero(linha[32])
                        mensagem.apagadaNoIMAP = paraNúmero(linha[33]) == 1
                        mensagens[#mensagens + 1] = mensagem
                        se não mensagem.lida então nãoLidas = nãoLidas + 1 fim
                    fim
                    feche(resultado)
                    estado.mensagens = mensagens
                    estado.quantidade = #mensagens
                    estado.nãoLidas = nãoLidas
                    tratador(estado, nulo)
                fim)
        fim)
    fim

    função este.obtenhaMensagem(_, caixaId, id, tratador)
        execute(piscina, [=[SELECT id,direcao,pasta,identificacao,remetente,destinatarios,assunto,resumo,
texto,html,tamanho,lida,importante,estado_entrega,falha_entrega,criada_em,
atualizada_em,responder_para,classificacao_triagem,pontuacao_suspeita,
motivos_triagem,resultado_spf,resultado_dkim,resultado_dmarc,dominio_autor,
politica_dmarc,acao_dmarc,decisao_usuario,regra_triagem,decidida_em,
remetente_envelope
FROM correio_cartas WHERE caixa_id=? AND id=? LIMIT 1]=],
            { caixaId, id }, função(resultado, falha)
                se falha então feche(resultado); tratador(nulo, falha); retorne fim
                local mensagem = linhaDaMensagem(resultado:obterLinha())
                feche(resultado)
                se não mensagem então tratador(nulo, nulo); retorne fim
                execute(piscina, [=[SELECT id,nome,tipo,tamanho FROM correio_anexos
WHERE carta_id=? ORDER BY id]=], { id }, função(anexos, falhaDosAnexos)
                    se falhaDosAnexos então
                        feche(anexos); tratador(nulo, falhaDosAnexos); retorne
                    fim
                    mensagem.anexos = {}
                    enquanto verdadeiro início
                        local linha = anexos:obterLinha()
                        se não linha então pare fim
                        mensagem.anexos[#mensagem.anexos + 1] = {
                            id = paraNúmero(linha[1]), nome = linha[2], tipo = linha[3],
                            tamanho = paraNúmero(linha[4]) ou 0
                        }
                    fim
                    feche(anexos)
                    tratador(mensagem, nulo)
                fim)
            fim)
    fim

    função este.obtenhaMensagemIMAP(esta, caixaId, id, tratador)
        esta:obtenhaMensagem(caixaId, id, função(mensagem, falha)
            se falha ou não mensagem então tratador(mensagem, falha); retorne fim
            execute(piscina, [=[SELECT mime,mime_objeto,tamanho,uid_imap,
apagada_imap
FROM correio_cartas WHERE caixa_id=? AND id=? LIMIT 1]=],
                { caixaId, id }, função(resultado, falhaDoMIME)
                    se falhaDoMIME então
                        feche(resultado); tratador(nulo, falhaDoMIME); retorne
                    fim
                    local linha = resultado:obterLinha()
                    feche(resultado)
                    se não linha então tratador(nulo, nulo); retorne fim
                    mensagem.uid = paraNúmero(linha[4])
                    mensagem.apagadaNoIMAP = paraNúmero(linha[5]) == 1
                    local função conclua(mime, falhaDaLeitura)
                        se não mime então
                            tratador(nulo, falhaDaLeitura ou
                                "carta sem MIME armazenado")
                            retorne
                        fim
                        mensagem.mime = mime
                        mensagem.tamanho = #mime
                        tratador(mensagem, nulo)
                    fim
                    se linha[2] então
                        objetos:leiaAssíncrono(linha[2],
                            paraNúmero(linha[3]), conclua)
                    senão
                        conclua(linha[1], nulo)
                    fim
                fim)
        fim)
    fim

    -- Recupera nomes que leitores antigos substituíram por anexo-N quando o
    -- cabeçalho usava continuações RFC 2231. O MIME imutável é relido, os
    -- anexos são correlacionados por ordem/tamanho e somente nomes provisórios
    -- são atualizados. Conteúdo e objetos nunca são regravados.
    função este.recupereNomesOriginaisDosAnexos(_, tratador)
        local estatísticas = {
            cartas = 0, candidatos = 0, corrigidos = 0, ignorados = 0
        }
        execute(piscina, [=[SELECT DISTINCT c.id,c.mime,c.mime_objeto,c.tamanho
FROM correio_cartas c
JOIN correio_anexos a ON a.carta_id=c.id
WHERE a.nome REGEXP '^anexo-[0-9]+$'
ORDER BY c.id]=], {}, função(resultado, falhaDaLista)
            se falhaDaLista então
                feche(resultado); tratador(nulo, falhaDaLista); retorne
            fim
            local cartas = {}
            enquanto verdadeiro início
                local linha = resultado:obterLinha()
                se não linha então pare fim
                cartas[#cartas + 1] = {
                    id = paraNúmero(linha[1]), mime = linha[2],
                    objeto = linha[3], tamanho = paraNúmero(linha[4])
                }
            fim
            feche(resultado)
            estatísticas.cartas = #cartas
            local correções = {}

            local função apliqueCorreções()
                estatísticas.candidatos = #correções
                se #correções == 0 então
                    tratador(estatísticas, nulo); retorne
                fim
                local iniciou, falhaImediata =
                    piscina:inicieTransaçãoAssíncrona(
                    função(_, transação, falhaDaTransação)
                        se falhaDaTransação então
                            tratador(nulo, falhaDaTransação); retorne
                        fim
                        local função atualize(índice)
                            se índice > #correções então
                                confirme(transação, tratador, estatísticas)
                                retorne
                            fim
                            local correção = correções[índice]
                            execute(transação, [=[UPDATE correio_anexos
SET nome=? WHERE id=? AND carta_id=? AND nome=?]=], {
                                correção.novo, correção.id,
                                correção.cartaId, correção.anterior
                            }, função(atualização, falhaDaAtualização)
                                local alteradas = atualização e
                                    atualização:linhasAfetadas() ou 0
                                feche(atualização)
                                se falhaDaAtualização então
                                    desfaça(transação, tratador,
                                        falhaDaAtualização)
                                    retorne
                                fim
                                estatísticas.corrigidos =
                                    estatísticas.corrigidos + alteradas
                                atualize(índice + 1)
                            fim)
                        fim
                        atualize(1)
                    fim)
                se falhaImediata então tratador(nulo, falhaImediata) fim
                retorne iniciou
            fim

            local função examineCarta(índice)
                se índice > #cartas então apliqueCorreções(); retorne fim
                local carta = cartas[índice]
                local função examineMIME(mime, falhaDaLeitura)
                    se não mime então
                        estatísticas.ignorados = estatísticas.ignorados + 1
                        examineCarta(índice + 1); retorne
                    fim
                    local lida = correio.leiaMensagem(mime)
                    se não lida então
                        estatísticas.ignorados = estatísticas.ignorados + 1
                        examineCarta(índice + 1); retorne
                    fim
                    execute(piscina, [=[SELECT id,nome,tipo,tamanho
FROM correio_anexos WHERE carta_id=? ORDER BY id]=], { carta.id },
                        função(anexos, falhaDosAnexos)
                            se falhaDosAnexos então
                                feche(anexos); tratador(nulo, falhaDosAnexos); retorne
                            fim
                            local armazenados = {}
                            enquanto verdadeiro início
                                local linha = anexos:obterLinha()
                                se não linha então pare fim
                                armazenados[#armazenados + 1] = {
                                    id = paraNúmero(linha[1]), nome = linha[2],
                                    tipo = linha[3],
                                    tamanho = paraNúmero(linha[4]) ou 0
                                }
                            fim
                            feche(anexos)
                            se #armazenados ~= #(lida.anexos ou {}) então
                                estatísticas.ignorados =
                                    estatísticas.ignorados + 1
                                examineCarta(índice + 1); retorne
                            fim
                            para posição, armazenado em ipares(armazenados) início
                                local original = lida.anexos[posição]
                                local nome = original e
                                    util.nomeSeguroDoAnexo(original.nome) ou ""
                                local provisório = armazenado.nome e
                                    armazenado.nome:procure("^anexo%-%d+$") ~= nulo
                                local nomeOriginal = nome ~= "" e
                                    nome:procure("^anexo%-%d+$") == nulo
                                se provisório e nomeOriginal e original.tamanho ==
                                   armazenado.tamanho então
                                    correções[#correções + 1] = {
                                        id = armazenado.id, cartaId = carta.id,
                                        anterior = armazenado.nome, novo = nome
                                    }
                                fim
                            fim
                            examineCarta(índice + 1)
                        fim)
                fim
                se carta.objeto e carta.objeto ~= "" então
                    objetos:leiaAssíncrono(carta.objeto, carta.tamanho,
                        examineMIME)
                senão
                    examineMIME(carta.mime,
                        carta.mime e nulo ou "MIME ausente")
                fim
            fim
            examineCarta(1)
        fim)
    fim

    -- Persiste um literal APPEND como rascunho ou cópia enviada. O MIME é
    -- conservado sem alterações; os campos extraídos existem apenas para a
    -- listagem. Uma repetição idêntica em Enviadas devolve o UID existente,
    -- evitando a segunda cópia que alguns clientes tentam criar após SMTP.
    função este.adicioneMensagemIMAP(_, caixa, pasta, mime, opções, tratador)
        opções = opções ou {}
        se tipo(caixa) ~= "tabela" ou não caixa.id ou não caixa.endereço então
            tratador(nulo, "caixa postal inválida"); retorne
        fim
        se pasta ~= "rascunhos" e pasta ~= "enviadas" então
            tratador(nulo,
                "APPEND aceita somente Rascunhos ou Enviadas")
            retorne
        fim
        local lida, falhaDaLeitura = correio.leiaMensagem(mime)
        se não lida então
            tratador(nulo, "mensagem MIME inválida: " ..
                paraColar(falhaDaLeitura)); retorne
        fim
        local endereçoDaCaixa = endereçoCanônico(caixa.endereço)
        local autor = endereçoCanônico(lida.remetente)
        se autor e autor ~= endereçoDaCaixa então
            tratador(nulo,
                "o cabeçalho From não pertence à caixa autenticada")
            retorne
        fim
        local identificação = util.apare(lida.identificação)
        se identificação == "" então
            identificação = "<imap." .. so.tempo() .. "." ..
                so.aleatório() .. "@" .. configuração.domínioASCII .. ">"
        fim
        local dadosDaMensagem = {
            direção = "saída", pasta = pasta,
            identificação = identificação,
            remetente = caixa.endereço,
            remetenteEnvelope = caixa.endereço,
            destinatários = {
                ["para"] = endereçosDoCabeçalho(lida.destinatários),
                cópia = endereçosDoCabeçalho(lida.cópia),
                cópiaOculta = {}
            },
            assunto = lida.assunto ou "",
            resumo = util.resumo(lida.texto ou lida.html, 280),
            texto = lida.texto, html = lida.html, mime = mime,
            anexos = lida.anexos ou {},
            lida = opções.lida == verdadeiro,
            importante = opções.importante == verdadeiro,
            responderPara = lida.responderPara ou caixa.endereço,
            estadoDaEntrega = pasta == "rascunhos" e "rascunho" ou
                "entregue",
            criadaEm = mat.paraInteiro(opções.criadaEm) ou so.tempo()
        }
        retorne prepareConteúdos(dadosDaMensagem,
            função(_, falhaDoDepósito)
                se falhaDoDepósito então
                    tratador(nulo, falhaDoDepósito); retorne
                fim
                local iniciou, falhaImediata =
                    piscina:inicieTransaçãoAssíncrona(
                    função(_, transação, falhaDaTransação)
                        se falhaDaTransação então
                            tratador(nulo, falhaDaTransação); retorne
                        fim
                        local função insira()
                            reserveCota(transação, caixa.id, dadosDaMensagem,
                                função(_, falhaDaCota)
                                    se falhaDaCota então
                                        desfaça(transação, tratador,
                                            falhaDaCota); retorne
                                    fim
                                    insiraMensagem(transação, caixa.id,
                                        dadosDaMensagem,
                                        função(id, falhaDaMensagem, uid)
                                            se falhaDaMensagem então
                                                desfaça(transação, tratador,
                                                    falhaDaMensagem); retorne
                                            fim
                                            execute(transação, [=[SELECT validade_uid FROM correio_pastas_imap
WHERE caixa_id=? AND pasta=? LIMIT 1]=],
                                                { caixa.id, pasta },
                                                função(estado,
                                                       falhaDoEstado)
                                                    se falhaDoEstado então
                                                        feche(estado)
                                                        desfaça(transação,
                                                            tratador,
                                                            falhaDoEstado)
                                                        retorne
                                                    fim
                                                    local linha =
                                                        estado:obterLinha()
                                                    feche(estado)
                                                    local validade = linha e
                                                        paraNúmero(linha[1])
                                                    se não validade então
                                                        desfaça(transação,
                                                            tratador,
                                                            "UIDVALIDITY ausente")
                                                        retorne
                                                    fim
                                                    confirme(transação,
                                                        tratador, {
                                                            id = id, uid = uid,
                                                            validadeUID = validade,
                                                            duplicada = falso
                                                        })
                                                fim)
                                        fim)
                                fim)
                        fim
                        se pasta ~= "enviadas" então insira(); retorne fim
                        execute(transação, [=[SELECT c.id,c.uid_imap,c.mime_objeto,p.validade_uid
FROM correio_cartas c
JOIN correio_pastas_imap p ON p.caixa_id=c.caixa_id AND p.pasta=c.pasta
WHERE c.caixa_id=? AND c.pasta='enviadas' AND c.identificacao=?
ORDER BY c.id DESC LIMIT 1 FOR UPDATE]=],
                            { caixa.id, identificação },
                            função(resultado, falhaDaBusca)
                                se falhaDaBusca então
                                    feche(resultado)
                                    desfaça(transação, tratador,
                                        falhaDaBusca); retorne
                                fim
                                local linha = resultado:obterLinha()
                                feche(resultado)
                                se linha e linha[3] ==
                                   dadosDaMensagem.mimeObjeto então
                                    confirme(transação, tratador, {
                                        id = paraNúmero(linha[1]),
                                        uid = paraNúmero(linha[2]),
                                        validadeUID = paraNúmero(linha[4]),
                                        duplicada = verdadeiro
                                    })
                                    retorne
                                fim
                                insira()
                            fim)
                    fim)
                se falhaImediata então tratador(nulo, falhaImediata) fim
                retorne iniciou
            fim)
    fim

