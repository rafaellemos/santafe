                    fim
                    local linha = consulta e consulta:obterLinha() ou nulo
                    feche(consulta)
                    se linha então devolva(linha); retorne fim

                    -- Usuários legados do domínio principal recebem a caixa
                    -- na primeira autenticação. Domínios adicionais sempre
                    -- têm a caixa criada explicitamente por sua aplicação.
                    local parteLocal = usuário.usuário:minúscula()
                    se parteLocal:procure("@", 1, verdadeiro) então
                        tratador(nulo, "caixa postal do domínio adicional não foi criada")
                        retorne
                    fim
                    local endereçoExibido = parteLocal .. "@" .. configuração.domínio
                    execute(piscina, [=[INSERT INTO correio_caixas
(usuario_id,parte_local,dominio_ascii,endereco_exibido,nome_exibido)
VALUES (?,?,?,?,?)
ON DUPLICATE KEY UPDATE id=LAST_INSERT_ID(id),nome_exibido=VALUES(nome_exibido),
endereco_exibido=VALUES(endereco_exibido)]=], {
                        usuário.id, parteLocal, configuração.domínioASCII,
                        endereçoExibido, usuário.nome
                    }, função(resultado, falha)
                        feche(resultado)
                        se falha então tratador(nulo, falha); retorne fim
                        consulte()
                    fim)
                fim)
        fim
        consulte()
    fim

    -- Confere a mesma senha Argon2id usada pelo portal e devolve a identidade
    -- postal completa. Um resumo-isca mantém custo semelhante para usuários
    -- inexistentes e evita transformar a porta SMTP em enumerador de contas.
    função este.autentiqueCaixa(_, identificador, senha, resumoIsca, tratador)
        identificador = util.apare(identificador):minúscula()
        se tipo(senha) ~= "colar" ou tipo(resumoIsca) ~= "colar" então
            tratador(nulo, "credencial de submissão inválida")
            retorne
        fim

        local sql, parâmetros
        local arroba = identificador:procure("@", 1, verdadeiro)
        se arroba então
            local parte = identificador:corte(1, arroba - 1)
            local domínio = rede.domínioASCII(identificador:corte(arroba + 1))
            se parte ~= "" e domínio então
                sql = [=[SELECT u.id,u.nome,u.usuario,u.email,u.senha_hash,
       c.id,c.parte_local,c.dominio_ascii,c.endereco_exibido,c.estado,
       c.cota_tacos,c.uso_tacos
FROM usuarios u
LEFT JOIN correio_caixas c ON c.usuario_id=u.id
WHERE u.estado='ativo' AND
((c.parte_local=? AND c.dominio_ascii=?) OR
 (?=? AND u.usuario=?))
LIMIT 1]=]
                parâmetros = { parte, domínio:minúscula(),
                    domínio:minúscula(), configuração.domínioASCII:minúscula(),
                    parte }
            fim
        senão se identificador ~= "" então
            sql = [=[SELECT u.id,u.nome,u.usuario,u.email,u.senha_hash,
       c.id,c.parte_local,c.dominio_ascii,c.endereco_exibido,c.estado,
       c.cota_tacos,c.uso_tacos
FROM usuarios u
LEFT JOIN correio_caixas c ON c.usuario_id=u.id
WHERE u.usuario=? AND u.estado='ativo'
LIMIT 1]=]
            parâmetros = { identificador }
        fim fim

        sql = sql ou [=[SELECT u.id,u.nome,u.usuario,u.email,u.senha_hash,
       c.id,c.parte_local,c.dominio_ascii,c.endereco_exibido,c.estado,
       c.cota_tacos,c.uso_tacos
FROM usuarios u
LEFT JOIN correio_caixas c ON c.usuario_id=u.id
WHERE u.usuario=? AND u.estado='ativo'
LIMIT 1]=]
        parâmetros = parâmetros ou { "" }
        execute(piscina, sql, parâmetros, função(resultado, falha)
            se falha então
                feche(resultado)
                tratador(nulo, falha)
                retorne
            fim
            local linha = resultado e resultado:obterLinha() ou nulo
            feche(resultado)
            local resumo = linha e linha[5] ou resumoIsca
            segredo.confiraSenhaAssíncrono(resumo, senha,
                função(confere, falhaDaSenha)
                    se falhaDaSenha então
                        tratador(nulo, falhaDaSenha)
                        retorne
                    fim
                    se não linha ou não confere ou
                       (linha[6] e linha[10] ~= "ativa") então
                        tratador(nulo, nulo)
                        retorne
                    fim
                    local usuário = {
                        id = paraNúmero(linha[1]), nome = linha[2],
                        usuário = linha[3], correio = linha[4]
                    }
                    local função concluaComCaixa(caixa, falhaDaCaixa)
                        se não caixa então
                            tratador(nulo, falhaDaCaixa)
                            retorne
                        fim
                        tratador({
                            id = usuário.id, nome = usuário.nome,
                            usuário = usuário.usuário,
                            correio = usuário.correio,
                            endereço = caixa.endereço,
                            caixa = caixa
                        }, nulo)
                    fim
                    se linha[6] então
                        concluaComCaixa({
                            id = paraNúmero(linha[6]),
                            usuárioId = usuário.id,
                            parteLocal = linha[7], domínioASCII = linha[8],
                            endereço = linha[9], nome = usuário.nome,
                            estado = linha[10], cota = paraNúmero(linha[11]),
                            uso = paraNúmero(linha[12]) ou 0
                        })
                        retorne
                    fim
                    este:obtenhaOuCrieCaixa(usuário, concluaComCaixa)
                fim)
        fim)
    fim

    função este.listeMensagens(_, caixaId, pasta, busca, limite,
                                        deslocamento, tratador)
        se tipo(deslocamento) == "função" então
            tratador, deslocamento = deslocamento, 0
        fim
        local escopo, parâmetros, falhaDoEscopo =
            escopoDaListagem(caixaId, pasta, busca)
        se não escopo então tratador(nulo, falhaDoEscopo); retorne fim
        limite = mat.paraInteiro(limite) ou 50
        se limite < 1 então limite = 1 fim
        se limite > 100 então limite = 100 fim
        deslocamento = mat.paraInteiro(deslocamento) ou 0
        se deslocamento < 0 então deslocamento = 0 fim
        se deslocamento > 100000000 então deslocamento = 100000000 fim
        local limiteDaConsulta = limite + 1
        local chave = assuntoDaConversaSQL("assunto")
        local função completeMetadados(mensagens, estado)
            se #mensagens == 0 então tratador(mensagens, nulo, estado); retorne fim
            local porChave, chaves, lugares = {}, {}, {}
            para _, mensagem em ipares(mensagens) início
                local chaveDaConversa = mensagem.chaveDaConversa ou ""
                porChave[chaveDaConversa] = mensagem
                chaves[#chaves + 1] = chaveDaConversa
                lugares[#lugares + 1] = "?"
                mensagem.remetentesNaConversa = {}
                mensagem.anexosNaConversa = {}
                mensagem.__remetentes = {}
                mensagem.__anexos = {}
            fim
            local parâmetrosDosMetadados = {}
            para _, valor em ipares(parâmetros) início
                parâmetrosDosMetadados[#parâmetrosDosMetadados + 1] = valor
            fim
            para _, valor em ipares(chaves) início
                parâmetrosDosMetadados[#parâmetrosDosMetadados + 1] = valor
            fim
            execute(piscina, [=[SELECT meta.chave_conversa,meta.id,meta.direcao,meta.remetente,
       meta.destinatarios,a.id,a.nome,a.tipo,a.tamanho
FROM (
    SELECT id,direcao,remetente,destinatarios,criada_em,]=] .. chave .. [=[           AS chave_conversa
    FROM correio_cartas WHERE ]=] .. escopo .. [=[) AS meta
LEFT JOIN correio_anexos a ON a.carta_id=meta.id
WHERE meta.chave_conversa IN (]=] .. tabela.concatene(lugares, ",") .. [=[)
ORDER BY meta.chave_conversa,meta.criada_em,meta.id,a.id]=],
                parâmetrosDosMetadados,
                função(resultado, falhaDosMetadados)
                    se falhaDosMetadados então
                        feche(resultado); tratador(nulo, falhaDosMetadados); retorne
                    fim
                    enquanto verdadeiro início
                        local linha = resultado:obterLinha()
                        se não linha então pare fim
                        local mensagem = porChave[linha[1] ou ""]
                        se mensagem então
                            local participantes = {}
                            se linha[3] == "saída" ou linha[3] == "saida" então
                                local destinatários = decodifiqueLista(linha[5])
                                para _, campo em ipares({
                                    destinatários["para"] ou {},
                                    destinatários.cópia ou {},
                                    destinatários.cópiaOculta ou {}
                                }) início
                                    para _, endereço em ipares(campo) início
                                        participantes[#participantes + 1] = endereço
                                    fim
                                fim
                            senão
                                participantes[1] = linha[4]
                            fim
                            para _, participante em ipares(participantes) início
                                participante = util.apare(participante)
                                local identidade = participante:minúscula()
                                se participante ~= "" e
                                   não mensagem.__remetentes[identidade] então
                                    mensagem.__remetentes[identidade] = verdadeiro
                                    mensagem.remetentesNaConversa[#mensagem.remetentesNaConversa + 1] =
                                        participante
                                fim
                            fim
                            local anexoId = paraNúmero(linha[6])
                            se anexoId e não mensagem.__anexos[anexoId] então
                                mensagem.__anexos[anexoId] = verdadeiro
                                mensagem.anexosNaConversa[#mensagem.anexosNaConversa + 1] = {
                                    mensagemId = paraNúmero(linha[2]), id = anexoId,
                                    nome = linha[7] ou "anexo",
                                    tipo = linha[8] ou "application/octet-stream",
                                    tamanho = paraNúmero(linha[9]) ou 0
                                }
                            fim
                        fim
                    fim
                    feche(resultado)
                    para _, mensagem em ipares(mensagens) início
                        tabela.apague(mensagem, "__remetentes")
                        tabela.apague(mensagem, "__anexos")
                    fim
                    tratador(mensagens, nulo, estado)
                fim)
        fim
        execute(piscina, [=[SELECT id,direcao,pasta,identificacao,remetente,destinatarios,assunto,resumo,
texto,html,tamanho,lida,importante,estado_entrega,falha_entrega,criada_em,
atualizada_em,responder_para,classificacao_triagem,pontuacao_suspeita,
motivos_triagem,resultado_spf,resultado_dkim,resultado_dmarc,dominio_autor,
politica_dmarc,acao_dmarc,decisao_usuario,regra_triagem,decidida_em,
remetente_envelope,chave_conversa,quantidade_conversa,nao_lidas_conversa
FROM (
SELECT id,direcao,pasta,identificacao,remetente,destinatarios,assunto,resumo,
texto,html,tamanho,lida,importante,estado_entrega,falha_entrega,criada_em,
atualizada_em,responder_para,classificacao_triagem,pontuacao_suspeita,
motivos_triagem,resultado_spf,resultado_dkim,resultado_dmarc,dominio_autor,
politica_dmarc,acao_dmarc,decisao_usuario,regra_triagem,decidida_em,
remetente_envelope,]=] .. chave .. [=[ AS chave_conversa,
COUNT(*) OVER (PARTITION BY ]=] .. chave .. [=[) AS quantidade_conversa,
SUM(CASE WHEN lida=FALSE THEN 1 ELSE 0 END)
    OVER (PARTITION BY ]=] .. chave .. [=[) AS nao_lidas_conversa,
ROW_NUMBER() OVER (PARTITION BY ]=] .. chave .. [=[    ORDER BY criada_em DESC,id DESC) AS ordem_conversa
FROM correio_cartas WHERE ]=] .. escopo .. [=[) AS conversas
WHERE ordem_conversa=1
ORDER BY criada_em DESC,id DESC LIMIT ]=] .. limiteDaConsulta ..
            " OFFSET " .. deslocamento,
            parâmetros,
            função(resultado, falha)
                se falha então feche(resultado); tratador(nulo, falha); retorne fim
                local mensagens, temPróxima = {}, falso
                enquanto verdadeiro início
                    local linha = resultado:obterLinha()
                    se não linha então pare fim
                    se #mensagens < limite então
                        mensagens[#mensagens + 1] = linhaDaConversa(linha)
                    senão
                        temPróxima = verdadeiro
                        pare
                    fim
                fim
                feche(resultado)
                completeMetadados(mensagens, {
                    temPróxima = temPróxima,
                    deslocamento = deslocamento,
                    limite = limite
                })
            fim)
    fim

    função este.conteMensagens(_, caixaId, pasta, busca, tratador)
        local escopo, parâmetros, falhaDoEscopo =
            escopoDaListagem(caixaId, pasta, busca)
        se não escopo então tratador(nulo, falhaDoEscopo); retorne fim
        execute(piscina, "SELECT COUNT(DISTINCT " ..
            assuntoDaConversaSQL("assunto") ..
            ") FROM correio_cartas WHERE " .. escopo,
            parâmetros, função(resultado, falha)
                se falha então feche(resultado); tratador(nulo, falha); retorne fim
                local linha = resultado e resultado:obterLinha() ou nulo
                feche(resultado)
                tratador(linha e paraNúmero(linha[1]) ou 0, nulo)
            fim)
    fim

    -- Abre exatamente a conversa representada por uma linha da pasta. O
    -- escopo da pasta é reaplicado para que uma conversa da Lixeira, por
    -- exemplo, nunca arraste cartas de outra caixa para uma ação coletiva.
    função este.listeMensagensDaConversa(esta, caixaId, pasta, id, tratador)
        local escopo, parâmetros, falhaDoEscopo =
            escopoDaListagem(caixaId, pasta, "")
        se não escopo então tratador(nulo, falhaDoEscopo); retorne fim
        local chave = assuntoDaConversaSQL("assunto")
        parâmetros[#parâmetros + 1] = caixaId
        parâmetros[#parâmetros + 1] = id
        execute(piscina, [=[SELECT id FROM correio_cartas
WHERE ]=] .. escopo .. [=[ AND ]=] .. chave .. [=[=(
    SELECT ]=] .. chave .. [=[ FROM correio_cartas
    WHERE caixa_id=? AND id=? LIMIT 1
)
ORDER BY criada_em,id]=], parâmetros, função(resultado, falha)
            se falha então feche(resultado); tratador(nulo, falha); retorne fim
            local ids = {}
            enquanto verdadeiro início
                local linha = resultado:obterLinha()
                se não linha então pare fim
                ids[#ids + 1] = paraNúmero(linha[1])
            fim
            feche(resultado)
            se #ids == 0 então tratador({}, nulo); retorne fim
            local mensagens = {}
            local função carregue(índice)
                se índice > #ids então tratador(mensagens, nulo); retorne fim
                esta:obtenhaMensagem(caixaId, ids[índice],
                    função(mensagem, falhaDaMensagem)
                        se falhaDaMensagem ou não mensagem então
                            tratador(nulo, falhaDaMensagem ou
                                "carta da conversa não encontrada")
                            retorne
                        fim
                        mensagem.posiçãoNaConversa = índice
                        mensagem.quantidadeNaConversa = #ids
                        mensagens[#mensagens + 1] = mensagem
                        carregue(índice + 1)
                    fim)
            fim
            carregue(1)
        fim)
    fim

    função este.listeMensagensParaAção(_, caixaId, pasta, busca, tratador)
        local escopo, parâmetros, falhaDoEscopo =
            escopoDaListagem(caixaId, pasta, busca)
        se não escopo então tratador(nulo, falhaDoEscopo); retorne fim
        execute(piscina, [=[SELECT id,direcao,pasta FROM correio_cartas WHERE ]=] ..
            escopo .. [=[ ORDER BY criada_em DESC,id DESC]=],
            parâmetros, função(resultado, falha)
                se falha então feche(resultado); tratador(nulo, falha); retorne fim
                local mensagens = {}
                enquanto verdadeiro início
                    local linha = resultado:obterLinha()
