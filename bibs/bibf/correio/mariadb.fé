    local função apliqueRegraPessoal(escopo, caixaId, dados, tratador)
        local endereço = normalizeRemetente(dados.remetente) ou ""
        local domínio = domínioDoRemetente(endereço) ou ""
        execute(escopo, [=[SELECT escopo,valor,decisao
FROM correio_regras_triagem
WHERE caixa_id=? AND (
    (escopo='endereco' AND valor=?) OR
    (escopo='dominio' AND valor=?)
)
ORDER BY CASE escopo WHEN 'endereco' THEN 0 ELSE 1 END
LIMIT 1]=], { caixaId, endereço, domínio }, função(resultado, falha)
            se falha então feche(resultado); tratador(nulo, falha); retorne fim
            local linha = resultado:obterLinha()
            feche(resultado)
            local personalizados = {}
            para chave, valor em pares(dados) início
                personalizados[chave] = valor
            fim
            personalizados.decisãoDoUsuário = "nenhuma"
            tabela.apague(personalizados, "regraDaTriagem")
            tabela.apague(personalizados, "decididaEm")
            se linha então
                local decisão = linha[3]
                personalizados.decisãoDoUsuário =
                    decisão == "permitir" e "regular" ou "indesejada"
                personalizados.pasta =
                    decisão == "permitir" e "entrada" ou "indesejadas"
                personalizados.regraDaTriagem = linha[1] .. ":" .. linha[2]
                personalizados.decididaEm = so.tempo()
            fim
            tratador(personalizados, nulo)
        fim)
    fim

