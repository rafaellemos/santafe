                                            local casos, lugares = {}, {}
                                            local parâmetros = { pasta }
                                            para índice = posição, último início
                                                casos[#casos + 1] = "WHEN ? THEN ?"
                                                parâmetros[#parâmetros + 1] = ids[índice]
                                                parâmetros[#parâmetros + 1] =
