-- Adaptador oficial MariaDB do sistema postal. SQL permanece encapsulado aqui.
local adaptador = {}

local pastas = {
    entrada = verdadeiro,
    enviadas = verdadeiro,
    rascunhos = verdadeiro,
    arquivadas = verdadeiro,
    indesejadas = verdadeiro,
    lixeira = verdadeiro
}

local função escopoDaListagem(caixaId, pasta, busca)
    busca = util.apare(busca)
    local filtro = "%" .. busca .. "%"
    local buscaSQL = "(?='' OR remetente LIKE ? OR assunto LIKE ? OR resumo LIKE ?)"
    se pasta == "todas" então
        retorne "caixa_id=? AND pasta NOT IN ('indesejadas','lixeira') " ..
            "AND apagada_imap=FALSE AND " .. buscaSQL,
            { caixaId, busca, filtro, filtro, filtro }
    fim
    se não pastas[pasta] então retorne nulo, nulo, "pasta inválida" fim
    retorne "caixa_id=? AND pasta=? AND apagada_imap=FALSE AND " .. buscaSQL,
        { caixaId, pasta, busca, filtro, filtro, filtro }
fim

-- O Carteiro agrupa a interface por assunto, mas o IMAP continua expondo
-- cada carta individualmente. Prefixos usuais de resposta/encaminhamento não
-- criam uma conversa nova. A expressão fica no adaptador para que contagem,
-- paginação e leitura usem exatamente a mesma chave.
local função assuntoDaConversaSQL(coluna)
    coluna = coluna ou "assunto"
    retorne "LOWER(TRIM(REGEXP_REPLACE(COALESCE(" .. coluna .. ",''), " ..
        "'^([[:space:]]*((re|resposta|fwd|fw|enc|encaminhada)" ..
        "[[:space:]]*:[[:space:]]*))+', '')))"
fim

local função feche(resultado)
    se resultado e tipo(resultado.feche) == "função" então resultado:feche() fim
fim

local função execute(escopo, sql, parâmetros, tratador)
    retorne escopo:executePreparadoAssíncrono(
        sql, parâmetros,
        função(_, resultado, falha) tratador(resultado, falha) fim
    )
fim

local função desfaça(transação, tratador, falhaOriginal)
    se não transação então tratador(nulo, falhaOriginal); retorne fim
    local iniciou, falha = transação:desfaçaAssíncrono(
        função(_, _, falhaDoDesfazimento)
            tratador(nulo, falhaOriginal ou falhaDoDesfazimento)
        fim
    )
    se falha então tratador(nulo, falhaOriginal ou falha) fim
    retorne iniciou
fim

local função confirme(transação, tratador, valor)
    local iniciou, falha = transação:confirmeAssíncrono(
        função(_, _, falhaDaConfirmação)
            tratador(falhaDaConfirmação e nulo ou valor, falhaDaConfirmação)
        fim
    )
    se falha então tratador(nulo, falha) fim
    retorne iniciou
fim

local função listaJSON(valor, registro)
    local funcionou, codificado = proteja(registro e dados.codifiqueDestinatários ou dados.codifiqueLista, valor)
    se não funcionou então retorne nulo, codificado fim
    retorne codificado
fim

local função decodifiqueLista(valor)
    local funcionou, decodificado = proteja(json.decod, valor ou "{}")
    se não funcionou ou tipo(decodificado) ~= "tabela" e tipo(decodificado) ~= "lista" então retorne {} fim
    retorne decodificado
fim

local função normalizeRemetente(valor)
    local endereço = util.apare(valor):minúscula()
    se endereço == "" ou #endereço > 512 ou
       endereço:procure("\r", 1, verdadeiro) ou
       endereço:procure("\n", 1, verdadeiro) então
        retorne nulo
    fim
    retorne endereço
fim

local função endereçoCanônico(valor)
    valor = util.apare(valor)
    local entreSinais = valor:separe("<([^<>]+)>")
    se entreSinais então valor = entreSinais:apare() fim
    local arroba = valor:procure("@", 1, verdadeiro)
    se não arroba ou arroba == 1 ou arroba == #valor então retorne nulo fim
    local parte = valor:corte(1, arroba - 1):minúscula()
    local domínio = rede.domínioASCII(valor:corte(arroba + 1))
    se não domínio então retorne nulo fim
    retorne parte .. "@" .. domínio:minúscula()
fim

local função endereçosDoCabeçalho(valor)
    local partes = util.separeEndereços(valor, 100) ou {}
    local endereços = {}
    para _, parte em ipares(partes) início
        local endereço = endereçoCanônico(parte)
        se endereço então endereços[#endereços + 1] = endereço fim
    fim
    retorne endereços
fim

local função normalizeRegra(escopo, valor)
    escopo = paraColar(escopo ou ""):minúscula():apare()
    valor = paraColar(valor ou ""):minúscula():apare()
    se escopo == "endereço" então escopo = "endereco" fim
    se escopo == "domínio" então escopo = "dominio" fim
    se escopo == "endereco" então
        valor = normalizeRemetente(valor)
        local arroba = valor e valor:procure("@", 1, verdadeiro)
        se não valor ou não arroba ou arroba == 1 ou arroba == #valor então
            retorne nulo, nulo, "endereço da regra inválido"
        fim
        retorne escopo, valor
    fim
    se escopo == "dominio" então
        se valor:corte(1, 1) == "@" então valor = valor:corte(2) fim
        local domínio, falha = rede.domínioASCII(valor)
        se não domínio então retorne nulo, nulo, falha fim
        retorne escopo, domínio:minúscula()
    fim
    retorne nulo, nulo, "escopo da regra deve ser endereço ou domínio"
fim

local função domínioDoRemetente(remetente)
    remetente = normalizeRemetente(remetente)
    se não remetente então retorne nulo fim
    local arroba = remetente:procure("@", 1, verdadeiro)
    se não arroba ou arroba == #remetente então retorne nulo fim
    local domínio = rede.domínioASCII(remetente:corte(arroba + 1))
    retorne domínio e domínio:minúscula() ou nulo
fim

local função linhaDaMensagem(linha)
    se não linha então retorne nulo fim
    retorne {
        id = paraNúmero(linha[1]),
        direção = linha[2], pasta = linha[3],
        identificação = linha[4], remetente = linha[5],
        destinatários = decodifiqueLista(linha[6]),
        assunto = linha[7] ou "", resumo = linha[8] ou "",
        texto = linha[9], html = linha[10], tamanho = paraNúmero(linha[11]) ou 0,
        lida = paraNúmero(linha[12]) == 1,
        importante = paraNúmero(linha[13]) == 1,
        estadoDaEntrega = linha[14], falhaDaEntrega = linha[15],
        criadaEm = paraNúmero(linha[16]) ou 0,
        atualizadaEm = paraNúmero(linha[17]) ou 0,
        responderPara = linha[18],
        classificaçãoDaTriagem = linha[19] ou "regular",
        pontuaçãoDeSuspeita = paraNúmero(linha[20]) ou 0,
        motivosDaTriagem = decodifiqueLista(linha[21]),
        resultadoSPF = linha[22], resultadoDKIM = linha[23],
        resultadoDMARC = linha[24], domínioDoAutor = linha[25],
        políticaDMARC = linha[26], açãoDMARC = linha[27],
        decisãoDoUsuário = linha[28] ou "nenhuma",
        regraDaTriagem = linha[29],
        decididaEm = paraNúmero(linha[30]),
        remetenteEnvelope = linha[31]
    }
fim

local função linhaDaConversa(linha)
    local mensagem = linhaDaMensagem(linha)
    se não mensagem então retorne nulo fim
    mensagem.chaveDaConversa = linha[32] ou ""
    mensagem.quantidadeNaConversa = paraNúmero(linha[33]) ou 1
    mensagem.nãoLidasNaConversa = paraNúmero(linha[34]) ou 0
    -- Uma conversa aparece como não lida enquanto ao menos uma de suas
    -- cartas estiver não lida.
    mensagem.lida = mensagem.nãoLidasNaConversa == 0
    retorne mensagem
fim

local função insiraAnexos(escopo, mensagemId, anexos, índice, tratador)
    se índice > #anexos então tratador(verdadeiro); retorne fim
    local anexo = anexos[índice]
    execute(escopo, [=[INSERT INTO correio_anexos (carta_id,nome,tipo,tamanho,dados,dados_objeto)
VALUES (?,?,?,?,NULL,?)]=], {
        mensagemId,
        util.nomeSeguroDoAnexo(anexo.nome),
        anexo.tipo ou "application/octet-stream",
        #anexo.dados,
        anexo.objeto
    }, função(resultado, falha)
        feche(resultado)
        se falha então tratador(nulo, falha); retorne fim
        insiraAnexos(escopo, mensagemId, anexos, índice + 1, tratador)
    fim)
fim

local função tamanhoOcupado(dados)
    local total = #(dados.mime ou "")
    para _, anexo em ipares(dados.anexos ou {}) início
        -- O MIME conserva o anexo e a tabela de anexos mantém uma cópia
        -- indexável para download; a cota contabiliza o espaço das duas.
        total = total + #(anexo.dados ou "")
    fim
    retorne total
fim

local função reserveCota(escopo, caixaId, dados, tratador)
    local tamanho = tamanhoOcupado(dados)
    execute(escopo, [=[UPDATE correio_caixas
SET uso_tacos=uso_tacos+?,atualizada_em=CURRENT_TIMESTAMP
WHERE id=? AND uso_tacos+?<=cota_tacos]=],
        { tamanho, caixaId, tamanho }, função(resultado, falha)
            local alteradas = resultado e resultado:linhasAfetadas() ou 0
            feche(resultado)
            se falha então tratador(nulo, falha); retorne fim
            se alteradas ~= 1 então
                tratador(nulo, "cota da caixa postal excedida"); retorne
            fim
            tratador(verdadeiro, nulo)
        fim)
fim

-- Reserva o próximo UID sob o bloqueio da transação chamadora. O UID não
-- deriva do id global: cartas novas e movidas percorrem o mesmo contador.
local função reserveUIDIMAP(escopo, caixaId, pasta, tratador)
    se não pastas[pasta] então tratador(nulo, "pasta inválida"); retorne fim
    execute(escopo, [=[INSERT INTO correio_pastas_imap
(caixa_id,pasta,validade_uid,proximo_uid) VALUES (?,?,?,1)
ON DUPLICATE KEY UPDATE caixa_id=VALUES(caixa_id)]=],
        { caixaId, pasta, so.tempo() }, função(criação, falhaDaCriação)
            feche(criação)
            se falhaDaCriação então tratador(nulo, falhaDaCriação); retorne fim
            execute(escopo, [=[SELECT proximo_uid FROM correio_pastas_imap
WHERE caixa_id=? AND pasta=? FOR UPDATE]=], { caixaId, pasta },
                função(estado, falhaDoEstado)
                    se falhaDoEstado então
                        feche(estado); tratador(nulo, falhaDoEstado); retorne
                    fim
                    local linha = estado e estado:obterLinha() ou nulo
                    feche(estado)
                    local uid = linha e paraNúmero(linha[1]) ou nulo
                    se não uid então
                        tratador(nulo, "próximo UID da pasta ausente"); retorne
                    fim
                    execute(escopo, [=[UPDATE correio_pastas_imap
SET proximo_uid=proximo_uid+1 WHERE caixa_id=? AND pasta=?]=],
                        { caixaId, pasta }, função(atualização, falhaDaAtualização)
                            feche(atualização)
                            tratador(falhaDaAtualização e nulo ou uid,
                                falhaDaAtualização)
                        fim)
                fim)
        fim)
fim

local função insiraMensagem(escopo, caixaId, dados, tratador)
    local destinatários, falha = listaJSON(dados.destinatários ou {}, verdadeiro)
    se não destinatários então tratador(nulo, falha); retorne fim
    local motivosDaTriagem
    motivosDaTriagem, falha = listaJSON(dados.motivosDaTriagem ou {})
    se não motivosDaTriagem então tratador(nulo, falha); retorne fim
    reserveUIDIMAP(escopo, caixaId, dados.pasta,
        função(uid, falhaDoUID)
            se não uid então tratador(nulo, falhaDoUID); retorne fim
            execute(escopo, [=[INSERT INTO correio_cartas
(caixa_id,uid_imap,direcao,pasta,identificacao,remetente,destinatarios,assunto,
 resumo,texto,html,mime,mime_objeto,tamanho,lida,importante,estado_entrega,
 falha_entrega,referencia_fila,criada_em,atualizada_em,responder_para,
 classificacao_triagem,pontuacao_suspeita,motivos_triagem,
 resultado_spf,resultado_dkim,resultado_dmarc,dominio_autor,politica_dmarc,
 acao_dmarc,decisao_usuario,regra_triagem,decidida_em,remetente_envelope)
VALUES (?,?,?,?,?,?,?,?,?,?,?,NULL,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)]=], {
        caixaId, uid, dados.direção, dados.pasta, dados.identificação,
        dados.remetente, destinatários, dados.assunto ou "",
        dados.resumo ou "", dados.texto, dados.html, dados.mimeObjeto,
        #dados.mime, dados.lida == verdadeiro, dados.importante == verdadeiro,
        dados.estadoDaEntrega, dados.falhaDaEntrega, dados.referênciaFila,
        dados.criadaEm, dados.criadaEm, dados.responderPara,
        dados.classificaçãoDaTriagem ou "regular",
        dados.pontuaçãoDeSuspeita ou 0, motivosDaTriagem,
        dados.resultadoSPF, dados.resultadoDKIM, dados.resultadoDMARC,
        dados.domínioDoAutor, dados.políticaDMARC, dados.açãoDMARC,
        dados.decisãoDoUsuário ou "nenhuma", dados.regraDaTriagem,
        dados.decididaEm, dados.remetenteEnvelope
            }, função(resultado, falhaSQL)
                local id = resultado e resultado:idInserido()
                feche(resultado)
                se falhaSQL então tratador(nulo, falhaSQL); retorne fim
                insiraAnexos(escopo, id, dados.anexos ou {}, 1,
                    função(_, falhaDosAnexos)
                        tratador(falhaDosAnexos e nulo ou id,
                            falhaDosAnexos, uid)
                    fim)
            fim)
        fim)
fim

função adaptador.novo(piscina, configuração, depósitoFornecido)
    garanta(piscina, "piscina MariaDB é obrigatória")
    configuração = configuração ou {}
    local objetos = depósitoFornecido ou garanta(
        Depósito.novo(configuração.depósito ou {}))
    local este = {
        piscina = piscina,
        configuração = configuração,
        depósito = objetos
    }

    local função prepareConteúdos(dados, tratador)
        retorne objetos:graveAssíncrono(dados.mime,
            função(objetoMIME, falhaDoMIME)
                se não objetoMIME então tratador(nulo, falhaDoMIME); retorne fim
                dados.mimeObjeto = objetoMIME.resumo
                local função gravePróximo(índice)
                    se índice > #(dados.anexos ou {}) então
                        tratador(dados, nulo)
                        retorne
                    fim
                    local anexo = dados.anexos[índice]
                    objetos:graveAssíncrono(anexo.dados,
                        função(objetoDoAnexo, falhaDoAnexo)
                            se não objetoDoAnexo então
                                tratador(nulo, falhaDoAnexo)
                                retorne
                            fim
                            anexo.objeto = objetoDoAnexo.resumo
                            gravePróximo(índice + 1)
                        fim)
                fim
                gravePróximo(1)
            fim)
    fim

    local função garantaPastaIMAP(caixaId, pasta, tratador)
        se não pastas[pasta] então tratador(nulo, "pasta inválida"); retorne fim
        execute(piscina, [=[INSERT INTO correio_pastas_imap
(caixa_id,pasta,validade_uid,proximo_uid) VALUES (?,?,?,1)
ON DUPLICATE KEY UPDATE caixa_id=VALUES(caixa_id)]=],
            { caixaId, pasta, so.tempo() }, função(resultado, falha)
                feche(resultado)
                se falha então tratador(nulo, falha); retorne fim
                execute(piscina, [=[SELECT validade_uid,proximo_uid
FROM correio_pastas_imap WHERE caixa_id=? AND pasta=? LIMIT 1]=],
                    { caixaId, pasta }, função(consulta, falhaDaConsulta)
                        se falhaDaConsulta então
                            feche(consulta); tratador(nulo, falhaDaConsulta); retorne
                        fim
                        local linha = consulta e consulta:obterLinha() ou nulo
                        feche(consulta)
                        se não linha então
                            tratador(nulo, "estado IMAP da pasta não foi criado")
                            retorne
                        fim
                        tratador({
                            validadeUID = paraNúmero(linha[1]) ou 1,
                            próximoUID = paraNúmero(linha[2]) ou 1
                        }, nulo)
                    fim)
            fim)
    fim

    local função movaComUID(caixaId, id, pasta, tratador)
        se não pastas[pasta] então tratador(nulo, "pasta inválida"); retorne fim
        local iniciou, falhaImediata = piscina:inicieTransaçãoAssíncrona(
            função(_, transação, falhaDaTransação)
                se falhaDaTransação então
                    tratador(nulo, falhaDaTransação); retorne
                fim
                execute(transação, [=[SELECT pasta FROM correio_cartas
WHERE caixa_id=? AND id=? FOR UPDATE]=], { caixaId, id },
                    função(consulta, falhaDaConsulta)
                        se falhaDaConsulta então
                            feche(consulta)
                            desfaça(transação, tratador, falhaDaConsulta)
                            retorne
                        fim
                        local linha = consulta:obterLinha()
                        feche(consulta)
                        se não linha então
                            desfaça(transação, tratador,
                                "carta não encontrada")
                            retorne
                        fim
                        se linha[1] == pasta então
                            confirme(transação, tratador, verdadeiro)
                            retorne
                        fim
                        execute(transação, [=[INSERT INTO correio_pastas_imap
(caixa_id,pasta,validade_uid,proximo_uid) VALUES (?,?,?,1)
ON DUPLICATE KEY UPDATE caixa_id=VALUES(caixa_id)]=],
                            { caixaId, pasta, so.tempo() },
                            função(criação, falhaDaCriação)
                                feche(criação)
                                se falhaDaCriação então
                                    desfaça(transação, tratador,
                                        falhaDaCriação)
                                    retorne
                                fim
                                execute(transação, [=[SELECT proximo_uid FROM correio_pastas_imap
WHERE caixa_id=? AND pasta=? FOR UPDATE]=], { caixaId, pasta },
                                    função(estado, falhaDoEstado)
                                        se falhaDoEstado então
                                            feche(estado)
                                            desfaça(transação, tratador,
                                                falhaDoEstado)
                                            retorne
                                        fim
                                        local estadoLinha = estado:obterLinha()
                                        feche(estado)
                                        local uid = estadoLinha e
                                            paraNúmero(estadoLinha[1]) ou nulo
                                        se não uid então
                                            desfaça(transação, tratador,
                                                "próximo UID da pasta ausente")
                                            retorne
                                        fim
                                        execute(transação, [=[UPDATE correio_pastas_imap SET proximo_uid=proximo_uid+1
WHERE caixa_id=? AND pasta=?]=], { caixaId, pasta },
                                            função(atualizaEstado,
                                                   falhaDaAtualização)
                                                feche(atualizaEstado)
                                                se falhaDaAtualização então
                                                    desfaça(transação,
                                                        tratador,
                                                        falhaDaAtualização)
                                                    retorne
                                                fim
                                                execute(transação, [=[UPDATE correio_cartas
SET pasta=?,uid_imap=?,apagada_imap=FALSE,atualizada_em=?
WHERE caixa_id=? AND id=?]=],
                                                    { pasta, uid, so.tempo(),
                                                      caixaId, id },
                                                    função(atualizaCarta,
                                                           falhaDaCarta)
                                                        local alteradas =
                                                            atualizaCarta e
                                                            atualizaCarta:linhasAfetadas() ou 0
                                                        feche(atualizaCarta)
                                                        se falhaDaCarta ou
                                                           alteradas ~= 1 então
                                                            desfaça(transação,
                                                                tratador,
                                                                falhaDaCarta ou
                                                                "carta não foi movida")
                                                            retorne
                                                        fim
                                                        confirme(transação,
                                                            tratador,
                                                            { uid = uid })
                                                    fim)
                                            fim)
                                    fim)
                            fim)
                    fim)
            fim)
        se falhaImediata então tratador(nulo, falhaImediata) fim
        retorne iniciou
    fim

    local função identificaçõesÚnicas(identificações)
        local únicas, vistas = {}, {}
        para _, valor em ipares(identificações ou {}) início
            local id = mat.paraInteiro(valor)
            se id e id > 0 e não vistas[id] então
                vistas[id] = verdadeiro
                únicas[#únicas + 1] = id
            fim
        fim
        retorne únicas
    fim

    -- COPY cria novas cartas lógicas e novos UIDs, mas conserva as
    -- referências imutáveis do Depósito. A operação inteira ocorre sob uma
    -- transação: cota, contador da pasta, cartas e anexos avançam juntos.
    local função copieEmLote(caixaId, identificações, pasta, tratador)
        se não pastas[pasta] então tratador(nulo, "pasta inválida"); retorne fim
        local ids = identificaçõesÚnicas(identificações)
        se #ids == 0 então
            tratador({ validadeUID = nulo, cópias = {} }, nulo); retorne
        fim
        local lugares, parâmetros = {}, { caixaId }
        para _, id em ipares(ids) início
            lugares[#lugares + 1] = "?"
            parâmetros[#parâmetros + 1] = id
        fim
        local iniciou, falhaImediata = piscina:inicieTransaçãoAssíncrona(
            função(_, transação, falhaDaTransação)
                se falhaDaTransação então
                    tratador(nulo, falhaDaTransação); retorne
                fim
                execute(transação, [=[SELECT id,tamanho FROM correio_cartas
WHERE caixa_id=? AND id IN (]=] .. tabela.concatene(lugares, ",") ..
                    ") FOR UPDATE", parâmetros,
                    função(cartas, falhaDasCartas)
                        se falhaDasCartas então
                            feche(cartas)
                            desfaça(transação, tratador, falhaDasCartas)
                            retorne
                        fim
                        local encontradas, tacos = {}, 0
                        enquanto verdadeiro início
                            local linha = cartas:obterLinha()
                            se não linha então pare fim
                            encontradas[paraNúmero(linha[1])] = verdadeiro
                            tacos = tacos + (paraNúmero(linha[2]) ou 0)
                        fim
                        feche(cartas)
                        para _, id em ipares(ids) início
                            se não encontradas[id] então
                                desfaça(transação, tratador,
                                    "carta não encontrada")
                                retorne
                            fim
                        fim
                        execute(transação, [=[SELECT COALESCE(SUM(a.tamanho),0)
FROM correio_anexos a JOIN correio_cartas c ON c.id=a.carta_id
