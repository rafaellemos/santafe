    -- A exclusão definitiva remove somente as referências transacionais.
    -- Objetos endereçados por conteúdo podem ser compartilhados e serão
    -- recolhidos depois por uma varredura que confirme a ausência de referências.
    local função removaDefinitivamente(caixaId, id, tratador)
        local iniciou, falhaImediata = piscina:inicieTransaçãoAssíncrona(
            função(_, transação, falhaDaTransação)
                se falhaDaTransação então
                    tratador(nulo, falhaDaTransação); retorne
                fim
                execute(transação, [=[SELECT pasta,tamanho
FROM correio_cartas WHERE caixa_id=? AND id=? FOR UPDATE]=],
                    { caixaId, id }, função(consulta, falhaDaConsulta)
                        se falhaDaConsulta então
                            feche(consulta)
                            desfaça(transação, tratador, falhaDaConsulta)
                            retorne
                        fim
                        local linha = consulta:obterLinha()
                        feche(consulta)
                        se não linha então
                            desfaça(transação, tratador,
                                "carta não encontrada")
                            retorne
                        fim
                        se linha[1] ~= "lixeira" então
                            desfaça(transação, tratador,
                                "somente cartas da lixeira podem ser removidas definitivamente")
                            retorne
                        fim
                        local tacos = paraNúmero(linha[2]) ou 0
                        execute(transação, [=[SELECT COALESCE(SUM(tamanho),0)
FROM correio_anexos WHERE carta_id=?]=], { id },
                            função(anexos, falhaDosAnexos)
                                se falhaDosAnexos então
                                    feche(anexos)
                                    desfaça(transação, tratador,
                                        falhaDosAnexos)
                                    retorne
                                fim
                                local linhaDosAnexos = anexos:obterLinha()
                                feche(anexos)
                                tacos = tacos + (paraNúmero(
                                    linhaDosAnexos e linhaDosAnexos[1]) ou 0)
                                execute(transação, [=[DELETE FROM correio_cartas
WHERE caixa_id=? AND id=? AND pasta='lixeira']=], { caixaId, id },
                                    função(exclusão, falhaDaExclusão)
                                        local alteradas = exclusão e
                                            exclusão:linhasAfetadas() ou 0
                                        feche(exclusão)
                                        se falhaDaExclusão ou alteradas ~= 1 então
                                            desfaça(transação, tratador,
                                                falhaDaExclusão ou
                                                "carta não foi removida")
                                            retorne
                                        fim
                                        libereCota(transação, caixaId, tacos,
                                            tratador, {
                                                id = id,
                                                tacosLiberados = tacos
                                            })
                                    fim)
                            fim)
                    fim)
            fim)
        se falhaImediata então tratador(nulo, falhaImediata) fim
        retorne iniciou
    fim

