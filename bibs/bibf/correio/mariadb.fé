SET pasta=?,uid_imap=CASE id ]=] ..
                                                tabela.concatene(casos, " ") ..
                                                [=[ ELSE uid_imap END,
apagada_imap=FALSE,atualizada_em=? WHERE caixa_id=? AND id IN (]=] ..
