    local função libereCota(transação, caixaId, tacos, tratador, valor)
        execute(transação, [=[UPDATE correio_caixas
SET uso_tacos=IF(uso_tacos>=?,uso_tacos-?,0),
    atualizada_em=CURRENT_TIMESTAMP
WHERE id=?]=], { tacos, tacos, caixaId },
            função(resultado, falha)
                local alteradas = resultado e resultado:linhasAfetadas() ou 0
                feche(resultado)
                se falha ou alteradas ~= 1 então
                    desfaça(transação, tratador,
                        falha ou "cota da caixa postal não foi liberada")
                    retorne
