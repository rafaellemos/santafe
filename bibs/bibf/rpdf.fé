        retorne este.m_AutoQuebraDePagina
    fim,

    Célula = função(este, w, h, texto, borda, linha, alinhamento, interior, ligacao)
        -- Desenhe uma célula
        local s
        local k = este.m_k
		h = h ou 0
        se (este.m_y+h > este.m_GatilhoDeQuebraDePagina e (não este.m_EmCabecalho) e (não este.m_EmRodape) e este:AceitaQuebraDePágina()) então
            -- Quebra de página automática
            local x = este.m_x
            local ws = este.m_ws
            se (ws > 0) então
                este.m_ws = 0
                este:_saida("0 Tw\n")
            fim
            este:AdicionePágina(este.m_OrientacaoAtual, este.m_CurPageSize)
            este.m_x = x + este.m_xDelta
            se (ws>0) então
                este.m_ws = ws
                este:_saidaformatada("%.3f Tw\n", ws*k)
            fim
        fim
        se (w==0) então
            w = este.m_w - este.m_rMargin - este.m_x
		fim

        se (interior ou (borda e borda == 1)) então
			se interior então
				se borda e borda == 1 então
					s = "B"
				senão
					s = "f"
				fim
			senão
				s = "S"
			fim
            s = cadeiaformate("%.2f %.2f %.2f %.2f re %s ", este.m_x*k,(este.m_h-este.m_y)*k,w*k,-h*k, s)
        fim
        se (borda) então
            local x = este.m_x
            local y = este.m_y
            s = s ou ''
            se(cadeiaprocure(borda, 'L', 1, verdadeiro)) então
                s = cadeiaformate("%s%.2f %.2f m %.2f %.2f l S ", s, x*k,(este.m_h-y)*k,x*k,(este.m_h-(y+h))*k)
			fim
            se (cadeiaprocure(borda, 'T', 1, verdadeiro)) então
                s = cadeiaformate("%s%.2f %.2f m %.2f %.2f l S ", s, x*k,(este.m_h-y)*k,(x+w)*k,(este.m_h-y)*k)
			fim
            se (cadeiaprocure(borda,'R', 1, verdadeiro)) então
                s = cadeiaformate("%s%.2f %.2f m %.2f %.2f l S ", s, (x+w)*k,(este.m_h-y)*k,(x+w)*k,(este.m_h-(y+h))*k)
			fim
            se (cadeiaprocure(borda,'B', 1, verdadeiro)) então
                s = cadeiaformate("%s%.2f %.2f m %.2f %.2f l S ", s, x*k,(este.m_h-(y+h))*k,(x+w)*k,(este.m_h-(y+h))*k)
			fim
        fim
        se (texto) então
            local dx
            local texto_largura = este:PegueLarguraDoColar(texto)
            se (alinhamento=='R') então
                dx = w-  este.m_cMargin-texto_largura
            senãose (alinhamento=='C') então
                dx = (w-texto_largura)/2
            senão
                dx = este.m_cMargin
	    fim

            s = cadeiaformate("%s%s", s ou '', este:_TextoBase((este.m_x+dx)*k, (este.m_h-(este.m_y+.5*h+.3*este.m_TamanhoDaFonte))*k, texto))

            se (ligacao) então
                este:Ligação(este.m_x+dx, este.m_y+.5*h-.5*este.m_TamanhoDaFonte, texto_largura, este.m_TamanhoDaFonte, ligacao)
			fim
        fim
        se (s e #s > 0) então este:_saidaformatada("%s\n", s) fim
        este.m_lasth = h
        se (linha e linha>0) então
            -- Vá para a próxima página
            este.m_y = este.m_y + h
            se (linha==1) então este.m_x = este.m_lMargin fim
        senão
			este.m_x = este.m_x + w
		fim
    fim,

    MultiCélula = função(este, w, h, texto, borda, alinhamento, interior)
		alinhamento = alinhamento ou 'J'
        -- Desenha um texto com quebra de linhas automáticas ou explícitas
        local cw = este.m_FonteAtual.font.cw
        se (w==0) então w = este.m_w-este.m_rMargin-este.m_x fim
        local wmax = (w-2*este.m_cMargin)*1000.0/este.m_TamanhoDaFonte
        local stmp
		local s = colar.troque(texto ou "", "\r", "")
        local nb = #s
		local NL = cadeiaembyte("\n", 1)
		local SP = cadeiaembyte(" ", 1)
        se (nb>0 e s:byte(nb)==NL) então nb = nb -1 fim
        local b, b2
        se (borda) então
            se(borda== 1) então
                borda = "LTRB";
                b = "LRT";
                b2 = "LR";
            senão
                se(cadeiaprocure(borda,'L', 1, verdadeiro)) então  b2 = "L" fim
                se(cadeiaprocure(borda,'R', 1, verdadeiro)) então b2 =  "R" fim
                se cadeiaprocure(borda,'T', 1, verdadeiro) então b = "T"
		senão
			b = b2
		fim
            fim
        fim
        local sep = -1
        local i = 1
        local j = 1
        local l = 0
        local ns = 0
        local nl = 1
        local ls = 0
        enquanto (i<=nb) início
            -- Pegue próximo caractere
            local c = s:byte(i)
            se (c==NL) então
                -- Quebra de linha explícita
                se (este.m_ws>0) então
                    este.m_ws = 0
                    este:_saida("0 Tw\n")
                fim
                stmp = s:corte(j, i-1)
                este:Célula(w,h,stmp,b,2,alinhamento,interior)
                i = i + 1
                sep = -1
                j = i
                l = 0
                ns = 0
                nl = nl + 1
                se (borda e nl==2) então b = b2 fim
                --continue --continue on my luajit is broke
			senão
				se (c==SP) então
					sep = i
					ls = l
					ns = ns + 1
				fim
				l = l + cw[c+1] --matrizes em lua/prisma começam por 1 então adicione 1
				se (l>wmax) então
					-- Quebra de linha automática
					se (sep==-1) então
						se(i==j) então i = i +1 fim
						se (este.m_ws>0) então
							este.m_ws = 0;
							este:_saida("0 Tw\n")
						fim
						stmp = s:corte(j, i-1)
						este:Célula(w,h,stmp,b,2,alinhamento,interior)
					senão
						se (alinhamento=='J') então
							se (ns>1) então
								este.m_ws = (wmax-ls)/1000.0*este.m_TamanhoDaFonte/(ns-1)
							senão
								este.m_ws = 0
							fim

							este:_saidaformatada("%.3f Tw\n",este.m_ws*este.m_k)
						fim
						stmp = s:corte(j, sep-1)
						este:Célula(w,h,stmp,b,2,alinhamento,interior)
						i = sep+1
					fim
					sep = -1
					j = i
					l = 0
					ns = 0
					nl = nl +1
