            local caractere = utf8.caractere(código)
            se caractere == "\n" então
                emita(junte(1, #caracteres))
                caracteres = {}
            senão
                caracteres[#caracteres + 1] = caractere
                se #caracteres > 1 e este:PegueLarguraDoColar(junte(1, #caracteres)) > largura então
                    local separador
