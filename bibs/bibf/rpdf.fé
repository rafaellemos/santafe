            Sublinhado = cadeiaformate(" %s ", este:_Sublinha(x, y, texto))
	senão
	   Sublinhado = ''
        fim
        retorne cadeiaformate("%sBT %.2f %.2f Td <%s> Tj ET%s%s", cor1, x, y, este:_codifiqueTextoUnicode(texto), Sublinhado, cor2)
    fim,

--public

    Rotacione = função(este, angulo, x, y)
        se (não x) então x=este.m_x fim
        se (não y) então y=este.m_y fim
        se (este.m_angulo ~= 0) então este:_saida("Q\n") fim
        este.m_angulo=angulo
        se (angulo~=0) então
            angulo = angulo * mat.pi/180.0;
            local c= mat.cosseno(angulo)
            local s= mat.seno(angulo)
            local cx= x*este.m_k
            local cy=(este.m_h-y)*este.m_k
            este:_saidaformatada("q %.5f %.5f %.5f %.5f %.2f %.2f cm 1 0 0 1 %.2f %.2f cm\n",
                    c,s,-s,c,cx,cy,-cx,-cy)
        fim
    fim,

