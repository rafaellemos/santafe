local função escrevaCor(este, cor, operador)
    se cor então este:_saidaformatada("%.4f %.4f %.4f %s\n",cor[1]/255,cor[2]/255,cor[3]/255,operador) fim
fim

local função pinteSvg(este, estilo)
    local temP,temL=estilo.preenchimento~=nulo,estilo.traço~=nulo
    se temP e temL então retorne "B" fim
    se temP então retorne "f" fim
    se temL então retorne "S" fim
    retorne "n"
fim

local função caminhoSvg(este, tokens)
    local i,cmd,x,y,sx,sy,cx,cy=1,nulo,0,0,0,0,nulo,nulo
    local função n() local v=tokens[i]; garanta(tipo(v)=="número","caminho SVG incompleto"); i=i+1; retorne v fim
    enquanto i<=#tokens início
        se tipo(tokens[i])=="colar" então cmd=tokens[i]; i=i+1 fim
        garanta(cmd,"caminho SVG sem comando")
        local rel=cmd==cmd:minúscula(); local c=cmd:maiúscula()
        se c=="Z" então este:_saida("h\n"); x,y=sx,sy; cmd=nulo
        senãose c=="M" ou c=="L" então
            local nx,ny=n(),n(); se rel então nx,ny=nx+x,ny+y fim; x,y=nx,ny
            este:_saidaformatada("%.4f %.4f %s\n",x,y,c=="M" e "m" ou "l")
            se c=="M" então sx,sy=x,y; cmd=rel e "l" ou "L" fim; cx,cy=nulo,nulo
        senãose c=="H" então local nx=n(); x=rel e x+nx ou nx; este:_saidaformatada("%.4f %.4f l\n",x,y); cx,cy=nulo,nulo
        senãose c=="V" então local ny=n(); y=rel e y+ny ou ny; este:_saidaformatada("%.4f %.4f l\n",x,y); cx,cy=nulo,nulo
        senãose c=="C" então
            local x1,y1,x2,y2,nx,ny=n(),n(),n(),n(),n(),n()
            se rel então x1,y1,x2,y2,nx,ny=x1+x,y1+y,x2+x,y2+y,nx+x,ny+y fim
            este:_saidaformatada("%.4f %.4f %.4f %.4f %.4f %.4f c\n",x1,y1,x2,y2,nx,ny); x,y,cx,cy=nx,ny,x2,y2
        senãose c=="S" então
            local x1,y1=cx e 2*x-cx ou x,cy e 2*y-cy ou y; local x2,y2,nx,ny=n(),n(),n(),n()
            se rel então x2,y2,nx,ny=x2+x,y2+y,nx+x,ny+y fim
            este:_saidaformatada("%.4f %.4f %.4f %.4f %.4f %.4f c\n",x1,y1,x2,y2,nx,ny); x,y,cx,cy=nx,ny,x2,y2
        senãose c=="Q" ou c=="T" então
            local qx,qy
            se c=="Q" então qx,qy=n(),n(); se rel então qx,qy=qx+x,qy+y fim
            senão qx,qy=cx e 2*x-cx ou x,cy e 2*y-cy ou y fim
            local nx,ny=n(),n(); se rel então nx,ny=nx+x,ny+y fim
            local x1,y1=x+2*(qx-x)/3,y+2*(qy-y)/3; local x2,y2=nx+2*(qx-nx)/3,ny+2*(qy-ny)/3
            este:_saidaformatada("%.4f %.4f %.4f %.4f %.4f %.4f c\n",x1,y1,x2,y2,nx,ny); x,y,cx,cy=nx,ny,qx,qy
        senão erro("comando de caminho SVG ainda não aceito: "..c) fim
    fim
fim

local função desenheSvg(este, imagem, x, y, w, h)
    local vista=imagem.vista; local vw,vh=vista[3],vista[4]
    se w==0 e h==0 então w,h=imagem.largura/96*25.4,imagem.altura/96*25.4
    senãose w==0 então w=h*vw/vh senãose h==0 então h=w*vh/vw fim
    x=x==-1 e este.m_x ou x; y=y==-1 e este.m_y ou y
    local sx,sy=w*este.m_k/vw,h*este.m_k/vh
    este:_saidaformatada("q %.6f 0 0 %.6f %.4f %.4f cm\n",sx,-sy,x*este.m_k-vista[1]*sx,(este.m_h-y)*este.m_k+vista[2]*sy)
    para _,elemento em ipares(imagem.elementos) início
        garanta(não elemento.transformação,"transformações SVG serão aceitas numa próxima versão")
        garanta((elemento.estilo.opacidadeDoPreenchimento ou 1)==1 e (elemento.estilo.opacidadeDoTraço ou 1)==1,
            "opacidades separadas de preenchimento e traço SVG serão aceitas numa próxima versão")
        este:_saida("q\n"); escrevaCor(este,elemento.estilo.preenchimento,"rg"); escrevaCor(este,elemento.estilo.traço,"RG")
        se (elemento.estilo.opacidade ou 1) ~= 1 então este:DefinaAlfa(elemento.estilo.opacidade) fim
        este:_saidaformatada("%.4f w\n",elemento.estilo.espessura ou 1)
        se elemento.espécie=="rect" então este:_saidaformatada("%.4f %.4f %.4f %.4f re\n",elemento.x,elemento.y,elemento.largura,elemento.altura)
        senãose elemento.espécie=="line" então este:_saidaformatada("%.4f %.4f m %.4f %.4f l\n",elemento.x1,elemento.y1,elemento.x2,elemento.y2)
        senãose elemento.espécie=="polyline" ou elemento.espécie=="polygon" então
            para j=1,#elemento.pontos,2 início este:_saidaformatada("%.4f %.4f %s\n",elemento.pontos[j],elemento.pontos[j+1],j==1 e "m" ou "l") fim
            se elemento.espécie=="polygon" então este:_saida("h\n") fim
        senãose elemento.espécie=="circle" ou elemento.espécie=="ellipse" então
            local rx=elemento.espécie=="circle" e elemento.r ou elemento.rx; local ry=elemento.espécie=="circle" e elemento.r ou elemento.ry; local k=.5522847498
            este:_saidaformatada("%.4f %.4f m\n",elemento.cx+rx,elemento.cy)
            este:_saidaformatada("%.4f %.4f %.4f %.4f %.4f %.4f c\n",elemento.cx+rx,elemento.cy+ry*k,elemento.cx+rx*k,elemento.cy+ry,elemento.cx,elemento.cy+ry)
            este:_saidaformatada("%.4f %.4f %.4f %.4f %.4f %.4f c\n",elemento.cx-rx*k,elemento.cy+ry,elemento.cx-rx,elemento.cy+ry*k,elemento.cx-rx,elemento.cy)
            este:_saidaformatada("%.4f %.4f %.4f %.4f %.4f %.4f c\n",elemento.cx-rx,elemento.cy-ry*k,elemento.cx-rx*k,elemento.cy-ry,elemento.cx,elemento.cy-ry)
            este:_saidaformatada("%.4f %.4f %.4f %.4f %.4f %.4f c h\n",elemento.cx+rx*k,elemento.cy-ry,elemento.cx+rx,elemento.cy-ry*k,elemento.cx+rx,elemento.cy)
        senãose elemento.espécie=="path" então caminhoSvg(este,elemento.caminho) fim
        este:_saida(pinteSvg(este,elemento.estilo).."\nQ\n")
    fim
    este:_saida("Q\n")
    retorne w,h
fim

