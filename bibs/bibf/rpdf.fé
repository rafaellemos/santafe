    _registreCódigoUnicode = função(este, código)
        local cid = este.m_cidPorCódigo[código]
        se cid então retorne cid fim
        cid = este.m_próximoCid
        garanta(cid <= 65535, "o documento excedeu 65.535 caracteres Unicode distintos")
        local glifo = fonteUnicodePadrão:glifo(código)
        garanta(glifo ~= 0, colar.formate("a fonte Noto Sans não possui U+%04X", código))
        este.m_próximoCid = cid + 1
        este.m_cidPorCódigo[código] = cid
        este.m_códigoPorCid[cid] = código
        este.m_glifoPorCid[cid] = glifo
        este.m_larguraPorCid[cid] = unicodePdf.escala(fonteUnicodePadrão, fonteUnicodePadrão:larguraDoGlifo(glifo))
        retorne cid
    fim,

    _codifiqueTextoUnicode = função(este, texto)
        local partes = {}
        para _, código em utf8.caracteres(texto) início
            partes[#partes + 1] = unicodePdf.u16be(este:_registreCódigoUnicode(código))
        fim
        retorne unicodePdf.hex(tabela.concatene(partes))
    fim,

