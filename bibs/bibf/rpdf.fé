        local estilo = este.m_EstiloDaFonte
        se (este.m_Sublinhado) então estilo = estilo .. "U" fim
        local tamanhodafonte = este.m_TamanhoDaFontePt
        local lw = este.m_EspessuraDaLinha
        local dc = este.m_CorDaLinha
        local fc = este.m_CorInterna
        local tc = este.m_CorDoTexto
