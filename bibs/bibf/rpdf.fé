            se tipo(borda) == "colar" então
                bordaDaLinha = ""
                se i == 1 e borda:procure("T", 1, verdadeiro) então bordaDaLinha = bordaDaLinha .. "T" fim
                se borda:procure("L", 1, verdadeiro) então bordaDaLinha = bordaDaLinha .. "L" fim
                se borda:procure("R", 1, verdadeiro) então bordaDaLinha = bordaDaLinha .. "R" fim
                se i == #linhas e borda:procure("B", 1, verdadeiro) então bordaDaLinha = bordaDaLinha .. "B" fim
            fim
            este:Célula(w, h, linha, bordaDaLinha, 2, alinhamento, interior)
        fim
        este.m_x = este.m_lMargin
    fim,

