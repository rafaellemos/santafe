    --Célula com escala horizontal se o texto for muito grande
    CélulaAjustada = função(este, w, h, texto, borda, linha, alinhamento, interior, ligacao, scale, force)
		h = h ou 0
        -- Obtém a largura do colar.
        local str_largura=este:PegueLarguraDoColar(texto)

        --Calcula relação para ajustar a celula
        se (w==0.0) então w = este.m_w-este.m_rMargin-este.m_x fim
        local ratio = (w-este.m_cMargin*2)/str_largura

        local fit = (ratio < 1 ou (ratio > 1 e force))
        se fit então
            se scale então
                --Calcula escala horizontal
                local horiz_scale=ratio*100.0
                --Defina escala horizontal
                este:_saidaformatada("BT %.2f Tz ET\n", horiz_scale)
            senão
                --Calcula espaçamento de caracteres em pontos
                local texto_size = utf8.tamanho(texto)
                local char_space=(w-este.m_cMargin*2-str_largura)/mat.máximo(texto_size-1,1)*este.m_k
                --Defina espaçamento de caracteres
                este:_saidaformatada("BT %.2f Tc ET\n", char_space)
            fim
            --Sobrescreve alinhamento do usuário(desde que o texto preencha a céulula)
            alinhamento=' '
        fim

        --Passe sobre para o método Célula
        este:Célula(w,h,texto,borda,linha,alinhamento,interior,ligacao)

        --Redefina escala de espaçamento/horizontal do caractere
