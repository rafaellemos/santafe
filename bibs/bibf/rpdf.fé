    RetânguloAbaulado = função(este, x, y, w, h, r, estilo)
        local k = este.m_k;
        local hp = este.m_h;
        local MyArc = 4.0/3.0 * (mat.raiz(2) - 1)
        este:_saidaformatada("%.2f %.2f m\n",(x+r)*k,(hp-y)*k)
        local xc = x+w-r
        local yc = y+r
        este:_saidaformatada("%.2f %.2f l\n", xc*k,(hp-y)*k)

        este:_Arco(xc + r*MyArc, yc - r, xc + r, yc - r*MyArc, xc + r, yc)
        xc = x+w-r
        yc = y+h-r
        este:_saidaformatada("%.2f %.2f l\n",(x+w)*k,(hp-yc)*k)
        este:_Arco(xc + r, yc + r*MyArc, xc + r*MyArc, yc + r, xc, yc + r)
        xc = x+r
        yc = y+h-r
        este:_saidaformatada("%.2f %.2f l\n",xc*k,(hp-(y+h))*k)
        este:_Arco(xc - r*MyArc, yc + r, xc - r, yc + r*MyArc, xc - r, yc)
        xc = x+r
        yc = y+r
        este:_saidaformatada("%.2f %.2f l\n",(x)*k,(hp-yc)*k)
        este:_Arco(xc - r, yc - r*MyArc, xc - r*MyArc, yc - r, xc, yc - r)
        se (estilo=="F") então
			este:_saida("f\n")
        senãose (estilo=="FD" ou estilo=="DF") então
