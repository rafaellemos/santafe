     DefinaFonte = função(este, afamilia, aestilo, size)
        local familia, estilo = "notosans", ""
        se (aestilo e #aestilo > 0) então
            estilo = aestilo:minúscula()
		senão
			estilo = ""
        fim

        se (estilo:procure("u", 1, verdadeiro)) então
            este.m_Sublinhado = verdadeiro
            estilo = estilo:troque("u", "")
        senão
            este.m_Sublinhado = falso
		fim
        se (estilo=="ib") então estilo = "bi" fim
        se (não size ou size==0) então size = este.m_TamanhoDaFontePt fim
        -- Teste se a fonte já foi selecionada
        se (este.m_FamiliaDaFonte==familia e este.m_EstiloDaFonte==estilo e este.m_TamanhoDaFontePt==size) então
            retorne
		fim
        -- Teste se a fonte já está carregada
        local fontkey = "notosans"
        local font = este.m_fonts[fontkey]
        se (não font) então
            este:AdicioneFonte(familia, estilo)
        fim
        -- Selecione ela
        este.m_FamiliaDaFonte = familia
        este.m_EstiloDaFonte = estilo
        este.m_TamanhoDaFontePt = size
        este.m_TamanhoDaFonte = size/este.m_k
        este.m_FonteAtual = este.m_fonts[fontkey]
        se (este.m_page>0) então
            este:_saidaformatada("BT /F%d %.2f Tf ET\n", este.m_FonteAtual.i, este.m_TamanhoDaFontePt)
		fim
     fim,

