		se não Codigo ou Codigo == '' então erro('*************Precisa de um codigo de 44 digitos*********') fim
		local E = BarraEstreita ou 0.39						-- Estreito
		local L = BarraLarga    ou 0.95						-- Largo: o dobro ou triplo do estreito
		local PH = Abscissa 	ou este:PegueAbscissa()	-- Posição inicial do código de barras
		local PV = Ordenada		ou este:PegueOrdenada()	-- Posição vertical
		local A  = Altura 		ou 16						-- Altura da barra
		local Preto = 'F'									-- Estilo pré definido
		local Branco = 'B' 									-- Idem


		local função impar(n)										-- Função para determinar se n é impar
			local resto = mat.resto(n,2)
			se resto == 1 então retorne verdadeiro
			senão retorne falso
			fim
		fim

		local t = Codigo:analise('0123456789')					-- t é uma tabela contendo todos os díditos
		se este:_PegueTamanhoDaTabela(t) < 44 então erro('Código deve conter 44 dídigos')	fim
		para i,v em pares(t) início t[i] = paraNúmero(v) fim 	-- convertendo os números

		local TL = {}              -- tabela contendo os díditos e suas posições
			TL[0] = {E,E,L,L,E}		-- Largo, Estreito definidos acima
			TL[1] = {L,E,E,E,L}
			TL[2] = {E,L,E,E,L}
			TL[3] = {L,L,E,E,E}
			TL[4] = {E,E,L,E,L}
			TL[5] = {L,E,L,E,E}
			TL[6] = {E,L,L,E,E}
			TL[7] = {E,E,E,L,L}
			TL[8] = {L,E,E,L,E}
			TL[9] = {E,L,E,L,E}

		local TBF = {}			-- Tabela final contendo os díditos intercalados


		para i=1, #t,2   início -- laço para cada par de díditos do código digitado
			para j=1, 10 início -- laço para preencher o conjunto de 2 de 5
				se impar(j) então    -- se for impar
					para r,f em pares(TL) início  -- laço na tabela de largura, são 10 índices
						se r == t[i] então
							se j == 1 então
									tabela.insira(TBF,TL[t[i] ][1]) --Inserindo o impar na sua posição
								senãose j == 3 então
									tabela.insira(TBF,TL[t[i] ][2])
								senãose j == 5 então
									tabela.insira(TBF,TL[t[i] ][3])
								senãose j == 7 então
									tabela.insira(TBF,TL[t[i] ][4])
								senãose j == 9 então
									tabela.insira(TBF,TL[t[i] ][5])
							fim
						fim
					fim
				senão
					para r,f em pares(TL) início
						se r == t[i+1] então                     -- se r que é par for igual ao par de t
							se j == 2 então						 -- Vai iserir apenas se
								tabela.insira(TBF,TL[t[i+1] ][1]) -- Inserindo o par na sua posição
							senãose j == 4 então
								tabela.insira(TBF,TL[t[i+1] ][2])
							senãose j == 6 então
								tabela.insira(TBF,TL[t[i+1] ][3])
							senãose j == 8 então
								tabela.insira(TBF,TL[t[i+1] ][4])
							senãose j == 10 então
								tabela.insira(TBF,TL[t[i+1] ][5])
							fim
						fim
					fim
				fim
			fim
		fim

			-- Ajustes gráficos do código.
	    este:DefinaCorInterna(0)
	    este:DefinaCorDaLinha(255)
	    este:DefinaEspessuraDoQuadro(0)
		    -- Barras iniciais.
	    este:Retângulo(PH,PV,E,A,Preto)  PH = PH + E
	    este:Retângulo(PH,PV,E,A,Branco) PH = PH + E
	    este:Retângulo(PH,PV,E,A,Preto)  PH = PH + E
	    este:Retângulo(PH,PV,E,A,Branco) PH = PH + E
		    -- Dados intercalados.
		local Pos = PH
		para i,v em pares(TBF) início
			se impar(i) então

				este:Retângulo(PH,PV,v,A,Preto) PH = PH + v
			senão
			Pos = Pos + TBF[i-1]

				este:Retângulo(PH,PV,v,A,Branco) PH = PH + v
			fim
		fim

			-- Barras finais.

		este:Retângulo(PH,PV,L,A,Preto) PH = PH + L
		este:Retângulo(PH,PV,E,A,Branco) PH = PH + E
		este:Retângulo(PH,PV,E,A,Preto)
		este:DefinaCorDaLinha(0)

    fim,


    _Arco = função(este, x1, y1, x2, y2, x3, y3)
        local h = este.m_h
	local k = este.m_k
        este:_saidaformatada("%.2f %.2f %.2f %.2f %.2f %.2f c \n", x1*k,
                (h-y1)*k, x2*k, (h-y2)*k, x3*k, (h-y3)*k);
    fim,

    --end,

    _verifique = função(este)
    fim,

    _verifiquesaida = função(este)
    fim,

    _pegue_tamanho_da_pagina = função(este, size)
	local result = {}
        se size == pdf_e_A3 então
            result.w = 841.89
            result.h = 1190.55
        senãose size == pdf_e_A5 então
            result.w = 420.94
            result.h = 595.28
        senãose size == pdf_e_Letter então
            result.w = 612
            result.h = 792
        senãose size == pdf_e_Legal então
            result.w = 612
            result.h = 1008
        senão
            --case pdf_e_A4
            result.w = 595.28
            result.h = 841.89
        fim

        result.w = result.w / este.m_k
        result.h = result.h / este.m_k
        retorne result
    fim,

    _inicio_da_pagina = função(este, orientation, size)
        este.m_page = este.m_page + 1
	tabelainsira(este.m_paginas, {})
        este.m_estado = 2
        este.m_x = este.m_lMargin
        este.m_y = este.m_tMargin
        este.m_FamiliaDaFonte = ""
        -- Check page size and orientation
        se (não orientation ou orientation==pdf_e_orientation_none)  então orientation = este.m_DefOrientation fim
        local psize
        se não size então
		psize = este.m_DefPageSize
        senão
		psize = size
	fim
        se (orientation~=este.m_OrientacaoAtual ou psize.w ~= este.m_CurPageSize.w ou psize.h  ~= este.m_CurPageSize.h) então
            -- New size or orientation
            se (orientation==pdf_e_orientation_portrait) então
                este.m_w = psize.w
                este.m_h = psize.h
            senão
                este.m_w = psize.h
                este.m_h = psize.w
            fim
            este.m_wPt = este.m_w*este.m_k;
            este.m_hPt = este.m_h*este.m_k;
            este.m_GatilhoDeQuebraDePagina = este.m_h-este.m_bMargin
            este.m_OrientacaoAtual = orientation
            este.m_CurPageSize = psize
        fim

        se (orientation ~= este.m_DefOrientation ou psize.w ~= este.m_DefPageSize.w ou psize.h ~= este.m_DefPageSize.h) então
            local ps = {}
            ps.w = este.m_wPt;
            ps.h = este.m_hPt;
            este.m_PageSizes[este.m_page] = ps
        fim

        se este.m_duploFaceado então
            se este.m_page % 2 == 0 então
                este.m_xDelta = este.m_margemExterior - este.m_margemInterior
                este:DefinaMargemEsquerda(este.m_margemExterior)
                este:DefinaMargemDireita(este.m_margemInterior)
            senão
                este.m_xDelta=este.m_margemInterior - este.m_margemExterior
                este:DefinaMargemEsquerda(este.m_margemInterior)
                este:DefinaMargemDireita(este.m_margemExterior)
            fim
            este.m_x=este.m_lMargin;
            este.m_y=este.m_tMargin;
        fim
    fim,

    _fim_da_pagina = função(este)
        se este.m_angulo ~=0 então
            este.m_angulo=0
            este:_saida("Q\n")
        fim
        este.m_estado = 1
    fim,

    --end,

     _escape = função(s)
        -- Escapa apenas a sintaxe de um colar literal PDF. Não converte UTF-8
        -- para WinAnsi/CP1252: a API pública do RPDF é exclusivamente Unicode.
        retorne (s ou ""):troque("\\", "\\\\"):troque("(", "\\("):troque(")", "\\)"):troque("\r", "")
     fim,

    _textstring = função(s)
        -- Format a text colar
        retorne cadeiaformate("(%s)", este._escape(s))
    fim,

     --__UTF8toUTF16(const std::colar &s)
     --end,

    conte_caracteres = função(str, c)
        local count = 0
        se str e #str > 0 então
		local byte_char = cadeiaembyte(c)
		para i = 1, #str início
			se str:byte( i) == byte_char então
				count = count + 1
			fim
		fim
        fim
        retorne count
    fim,

    _Sublinha = função(este, x, y, texto)
        -- Underline text
        local up = este.m_FonteAtual.font.up
        local ut = este.m_FonteAtual.font.ut
        local w = este:PegueLarguraDoColar(texto) + este.m_ws * este.conte_caracteres(texto,' ')
        retorne cadeiaformate("%.2f %.2f %.2f %.2f re f", x*este.m_k, (este.m_h-(y-up/1000.0*este.m_TamanhoDaFonte))*este.m_k, w*este.m_k,-ut/1000.0*este.m_TamanhoDaFontePt)
    fim,

    _calc_m_buffer_size = função(este)
	local size = 0
	para k,v em pares(este.m_buffer) início
		size = size + #v
	fim
	retorne size
    fim,

    _novoobj = função(este)
        -- Begin a novo object
        este.m_n = este.m_n + 1
        tabelainsira(este.m_offsets, este:_calc_m_buffer_size())
        este:_saidaformatada("%d 0 obj\n", este.m_n)
    fim,

    _poefluxo = função(este, s)
        este:_saida("stream\n")
        este:_saida(s)
        este:_saida("\nendstream\n")
    fim,

    _saida = função(este, s)
        -- Add a line to the document
        se este.m_estado==2 então
	    tabelainsira(este.m_paginas[este.m_page], s)
        senão
            tabelainsira(este.m_buffer, s)
        fim
    fim,

    _saidaformatada = função(este, fmt, ...)
	este:_saida(cadeiaformate(fmt, ...))
    fim,

    _poepaginas = função(este)
        local nb = este.m_page
	para n=1, nb início
		este.m_paginas[n] = tabela.concatene(este.m_paginas[n])
	fim
        se (este.m_PseudoNumeroDePaginas) então
            -- Replace number of pages
            local str = cadeiaformate("%d", nb)
            para n=1, nb início
                local page = este.m_paginas[n]
		este.m_paginas[n] = page:troque(este.m_PseudoNumeroDePaginas, str)
            fim
        fim
        local wPt, hPt
	local k = este.m_k
        se (este.m_DefOrientation==pdf_e_orientation_portrait) então
            wPt = este.m_DefPageSize.w*k
            hPt = este.m_DefPageSize.h*k
        senão
            wPt = este.m_DefPageSize.h*k
            hPt = este.m_DefPageSize.w*k
        fim
        local filter
	se (este.m_comprima) então
		filter = "/Filter /FlateDecode "
	senão
		filter = ""
	fim
        para n=1, nb início
            -- Page
            este:_novoobj()
            este:_saidaformatada("<<\n/Type /Page\n/Parent 1 0 R\n");
            se (este.m_PageSizes[n] e #este.m_PageSizes[n] > 0) então
                este:_saidaformatada("/MediaBox [0 0 %.2f %.2f]\n", este.m_PageSizes[n].w, este.m_PageSizes[n].h)
	    fim
            este:_saidaformatada("/Resources 2 0 R\n")
            se (este.m_LigacaoDaPagina[n]) então
                -- Links
                local annots = "/Annots ["

               este: _saidaformatada("%s]\n", annots)
            fim
            se (este.m_VersaoPDF > "1.3") então
                este:_saidaformatada("/Group\n<<\n/Type /Group /S /Transparency /CS /DeviceRGB\n>>\n")
	    fim
            este:_saidaformatada("/Contents %d 0 R\n>>\n", este.m_n+1)
            este:_saida("endobj\n")
            -- Page content
            local zbuf
	    local p
	    se PDF_USING_ZLIB então
		se este.m_comprima então
			p = comprimagz(zbuf, este.m_paginas[n])
		senão
			p = este.m_paginas[n]
		fim
	    senão
                p = este.m_paginas[n]
	    fim
            este:_novoobj()
            este:_saidaformatada("<<\n%s/Length %d\n>>\n", filter, #p)
            este:_poefluxo(p)
            este:_saida("endobj\n")
        fim
        -- Pages root
        este.m_offsets[1] = este:_calc_m_buffer_size()
        este:_saida("1 0 obj\n<<\n/Type /Pages\n")
        local kids = "/Kids ["
        para  i=1, nb início
		kids = cadeiaformate("%s %d 0 R ", kids, (3+2*(i-1)))
	fim
        este:_saidaformatada("%s]\n/Count %d\n/MediaBox [0 0 %.2f %.2f]\n>>\nendobj\n", kids, nb, wPt, hPt);
    fim,

    -- Fonte composta Unicode incorporada para PDF 2.0.
    _poefontes = função(este)
        para _, font em pares(este.m_fonts) início
            local fonte, nome = font.fonteUnicode, font.name
            local tipo0 = este.m_n + 1
            local cidFonte, descritor = tipo0 + 1, tipo0 + 2
            local arquivoFonte, mapaGlifos, paraUnicode = tipo0 + 3, tipo0 + 4, tipo0 + 5
            font.n = tipo0

            este:_novoobj()
            este:_saidaformatada("<<\n/Type /Font\n/Subtype /Type0\n/BaseFont /%s\n/Encoding /Identity-H\n/DescendantFonts [%d 0 R]\n/ToUnicode %d 0 R\n>>\nendobj\n", nome, cidFonte, paraUnicode)

            local larguras = {}
            para cid = 1, este.m_próximoCid - 1 início larguras[#larguras + 1] = paraColar(este.m_larguraPorCid[cid]) fim
            este:_novoobj()
            este:_saidaformatada("<<\n/Type /Font\n/Subtype /CIDFontType2\n/BaseFont /%s\n/CIDSystemInfo << /Registry (Adobe) /Ordering (Identity) /Supplement 0 >>\n/FontDescriptor %d 0 R\n/DW 1000\n", nome, descritor)
            se #larguras > 0 então este:_saida("/W [1 [" .. tabela.concatene(larguras, " ") .. "]]\n") fim
            este:_saidaformatada("/CIDToGIDMap %d 0 R\n>>\nendobj\n", mapaGlifos)

            este:_novoobj()
            este:_saidaformatada("<<\n/Type /FontDescriptor\n/FontName /%s\n/Flags 32\n/FontBBox [%d %d %d %d]\n/ItalicAngle %.2f\n/Ascent %d\n/Descent %d\n/CapHeight %d\n/StemV 80\n/FontFile2 %d 0 R\n>>\nendobj\n",
                nome, unicodePdf.escala(fonte, fonte.xMínimo), unicodePdf.escala(fonte, fonte.yMínimo),
                unicodePdf.escala(fonte, fonte.xMáximo), unicodePdf.escala(fonte, fonte.yMáximo),
                fonte.ânguloItálico, unicodePdf.escala(fonte, fonte.ascendente), unicodePdf.escala(fonte, fonte.descendente),
                unicodePdf.escala(fonte, fonte.ascendente), arquivoFonte)

            este:_novoobj()
            este:_saidaformatada("<<\n/Length %d\n/Length1 %d\n>>\n", #fonte.dados, #fonte.dados)
            este:_poefluxo(fonte.dados)
            este:_saida("endobj\n")

            local mapa = {unicodePdf.u16be(0)}
            para cid = 1, este.m_próximoCid - 1 início mapa[#mapa + 1] = unicodePdf.u16be(este.m_glifoPorCid[cid]) fim
            mapa = tabela.concatene(mapa)
            este:_novoobj()
            este:_saidaformatada("<<\n/Length %d\n>>\n", #mapa)
            este:_poefluxo(mapa)
            este:_saida("endobj\n")

            local linhas = {
                "/CIDInit /ProcSet findresource begin", "12 dict begin", "begincmap",
                "/CIDSystemInfo << /Registry (Adobe) /Ordering (UCS) /Supplement 0 >> def",
                "/CMapName /Adobe-Identity-UCS def", "/CMapType 2 def",
                "1 begincodespacerange", "<0000> <FFFF>", "endcodespacerange"
            }
            local cid = 1
            enquanto cid < este.m_próximoCid início
                local quantidade = mat.mínimo(100, este.m_próximoCid - cid)
                linhas[#linhas + 1] = quantidade .. " beginbfchar"
                para deslocamento = 0, quantidade - 1 início
                    local atual = cid + deslocamento
                    linhas[#linhas + 1] = colar.formate("<%04X> <%s>", atual, unicodePdf.utf16beHex(este.m_códigoPorCid[atual]))
                fim
                linhas[#linhas + 1] = "endbfchar"
                cid = cid + quantidade
            fim
            linhas[#linhas + 1] = "endcmap"
            linhas[#linhas + 1] = "CMapName currentdict /CMap defineresource pop"
            linhas[#linhas + 1] = "end"
            linhas[#linhas + 1] = "end"
            local mapaUnicode = tabela.concatene(linhas, "\n") .. "\n"
            este:_novoobj()
            este:_saidaformatada("<<\n/Length %d\n>>\n", #mapaUnicode)
            este:_poefluxo(mapaUnicode)
            este:_saida("endobj\n")
        fim
    fim,

    _poeimagens = função(este)
        para k, img em pares(este.m_imagens) início
            este:_poeimagem(img)
            img.dados = nulo -- liberando a memória
            img.máscaraSuave = nulo -- idem
        fim
    fim,

    _poeimagem = função(este, info)
        este:_novoobj()
        info.númeroDoObjeto = este.m_n
        este:_saida("<<\n/Type /XObject\n/Subtype /Image\n")
        este:_saidaformatada("/Width %d\n", info.largura)
        este:_saidaformatada("/Height %d\n", info.altura)
        se (info.espaçoDeCor=="Indexed") então
            este:_saidaformatada("/ColorSpace [/Indexed /DeviceRGB %d %d 0 R]\n", (#info.paleta)/3-1, (este.m_n+1))
        senão
            este:_saidaformatada("/ColorSpace /%s\n", info.espaçoDeCor)
            se (info.espaçoDeCor=="DeviceCMYK") então
                este:_saida("/Decode [1 0 1 0 1 0 1 0]\n")
            fim
        fim
        este:_saidaformatada("/BitsPerComponent %d\n", info.bitsPorComponente)
        se(info.filtro e #info.filtro > 0) então
            este:_saidaformatada("/Filter /%s\n", info.filtro)
        fim
        se (info.parâmetrosDeDecodificação e #info.parâmetrosDeDecodificação > 0) então
            este:_saidaformatada("/DecodeParms\n<<\n%s\n>>", info.parâmetrosDeDecodificação)
        fim
        se(info.transparência e #info.transparência > 0) então
            local transparência = {"/Mask ["}
            para i=1, #info.transparência início
				tabelainsira(transparência, cadeiaformate(" %d", info.transparência[i]))
            fim
            tabelainsira(transparência, "]")
            este:_saidaformatada("%s\n", tabela.concatene(transparência))
        fim
        se (info.máscaraSuave e #info.máscaraSuave > 0) então
            este:_saidaformatada("/SMask %d  0 R\n", (este.m_n+1))
        fim

        este:_saidaformatada("/Length %d\n>>\n", #info.dados)
        este:_poefluxo(info.dados)
        este:_saida("endobj\n")
        -- Soft mask
        se(info.máscaraSuave e #info.máscaraSuave > 0) então
            local parâmetros = cadeiaformate("/Predictor 15 /Colors 1 /BitsPerComponent 8 /Columns %d", info.largura)
            local máscara = {}
            para chave, valor em pares(info) início máscara[chave] = valor fim
            máscara.espaçoDeCor = "DeviceGray"
            máscara.bitsPorComponente = 8
            máscara.ticosPorComponente = 8
            máscara.parâmetrosDeDecodificação = parâmetros
            máscara.dados = info.máscaraSuave
            máscara.máscaraSuave = nulo
            este:_poeimagem(máscara)
        fim
        -- Palette
        se (info.espaçoDeCor=="Indexed") então
            local filter
            se (este.m_comprima) então
				filter = "/Filter /FlateDecode "
			senão
				filter = ""
			fim
            local zbuf
            local pal
			se PDF_USING_ZLIB então
				se este.m_comprima então
					pal = comprimagz(zbuf, info.paleta)
				senão
					pal = info.paleta
				fim
			senão
				pal = info.paleta
			fim
            este:_novoobj()
            este:_saidaformatada("<<\n%s/Length %d\n>>\n", filter, #pal)
            este:_poefluxo(pal)
            este:_saida("endobj\n")
        fim
    fim,

    _poe_dicionario_do_objetoX = função(este)
        para k,v em pares(este.m_imagens) início
			este:_saidaformatada("/I%d %d 0 R\n", v.índice, v.númeroDoObjeto)
		fim
    fim,

    _poeextgstates = função(este)
        para i = 1, #este.m_extgstates início
		este:_novoobj()
		local gs = este.m_extgstates[i]
		gs.n = este.m_n;
		este:_saidaformatada("<<\n/Type /ExtGState\n/ca %0.3f\n/CA %0.3f\n/BM /%s\n>>\nendobj\n", gs.alfa, gs.alfa, gs.bm)
        fim
    fim,

    _poejavascript = função(este)
        este:_novoobj()
        este.m_n_js=este.m_n
        este:_saidaformatada("<<\n/Names [(EmbeddedJS) %d 0 R]\n>>\nendobj\n", este.m_n+1)
        este:_novoobj()
        este:_saidaformatada("<<\n/S /JavaScript\n/JS (%s)\n>>\nendobj\n", este._escape(este.m_javascript))
    fim,

    _poe_dicionario_do_recurso = função(este)
        este:_saida("/ProcSet [/PDF /Text /ImageB /ImageC /ImageI]\n/Font\n<<\n")
        para k,v em pares(este.m_fonts) início
            este:_saidaformatada("/F%d %d 0 R\n", v.i, v.n ou 0);
		fim
        este:_saidaformatada(">>\n/XObject\n<<\n")
        este:_poe_dicionario_do_objetoX()
        este:_saidaformatada(">>\n")
        se #este.m_extgstates > 0 então
            este:_saida("/ExtGState\n<<\n")
            para i = 1, #este.m_extgstates início
                este:_saidaformatada("/GS%d %d 0 R\n", i, este.m_extgstates[i].n)
            fim
            este:_saida(">>\n")
        fim
    fim,

    _poerecursos = função(este)
        este:_poeextgstates()
        este:_poefontes()
        este:_poeimagens()
        -- Resource dictionary
        este.m_offsets[2] = este:_calc_m_buffer_size()
        este:_saidaformatada("2 0 obj\n<<\n")
        este:_poe_dicionario_do_recurso()
        este:_saida(">>\nendobj\n")
        se  este.m_javascript e #este.m_javascript > 0 então
            este:_poejavascript()
        fim
    fim,

    _poeinfo = função(este)
        este:_saidaformatada("/Producer %s\n", unicodePdf.textoUtf8("RPDF " .. FPDF_VERSION))
        se este.m_titulo e #este.m_titulo > 0 então
            este:_saidaformatada("/Title %s\n", unicodePdf.textoUtf8(este.m_titulo))
        fim
        se este.m_assunto e #este.m_assunto > 0 então
            este:_saidaformatada("/Subject %s\n", unicodePdf.textoUtf8(este.m_assunto))
        fim
        se este.m_autor e #este.m_autor > 0 então
            este:_saidaformatada("/Author %s\n", unicodePdf.textoUtf8(este.m_autor));
        fim
        se este.m_palavraschave e #este.m_palavraschave > 0 então
            este:_saidaformatada("/Keywords %s\n", unicodePdf.textoUtf8(este.m_palavraschave))
        fim
        se este.m_criador e #este.m_criador > 0 então
            este:_saidaformatada("/Creator %s\n", unicodePdf.textoUtf8(este.m_criador))
        fim

        este:_saida(so.data("/CreationDate (D:%Y%m%d%H%M%S)\n"))
    fim,

    _poemetadados = função(este)
        local função xml(texto)
            retorne (texto ou ""):troque("&", "&amp;"):troque("<", "&lt;"):troque(">", "&gt;"):troque('"', "&quot;"):troque("'", "&apos;")
        fim
        local criado = so.data("%Y-%m-%dT%H:%M:%S%z")
        local xmp = colar.formate([[<?xpacket begin="%s" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
 <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <rdf:Description rdf:about="" xmlns:pdf="http://ns.adobe.com/pdf/1.3/" xmlns:xmp="http://ns.adobe.com/xap/1.0/" xmlns:dc="http://purl.org/dc/elements/1.1/" pdf:Producer="%s" xmp:CreateDate="%s" xmp:ModifyDate="%s">
   <dc:format>application/pdf</dc:format>
   <dc:title><rdf:Alt><rdf:li xml:lang="x-default">%s</rdf:li></rdf:Alt></dc:title>
   <dc:creator><rdf:Seq><rdf:li>%s</rdf:li></rdf:Seq></dc:creator>
   <dc:description><rdf:Alt><rdf:li xml:lang="x-default">%s</rdf:li></rdf:Alt></dc:description>
  </rdf:Description>
 </rdf:RDF>
</x:xmpmeta>
<?xpacket end="w"?>]], utf8.caractere(0xFEFF), xml("RPDF " .. FPDF_VERSION), criado, criado, xml(este.m_titulo), xml(este.m_autor), xml(este.m_assunto))
        este:_novoobj()
        este.m_objetoMetadados = este.m_n
        este:_saidaformatada("<<\n/Type /Metadata\n/Subtype /XML\n/Length %d\n>>\n", #xmp)
        este:_poefluxo(xmp)
        este:_saida("endobj\n")
    fim,

    _poecatalogo = função(este)
        este:_saidaformatada("/Type /Catalog\n/Pages 1 0 R\n")
        se este.m_objetoMetadados então este:_saidaformatada("/Metadata %d 0 R\n", este.m_objetoMetadados) fim
        se este.m_AmpliaPersonalizado ~= pdf_e_amplia_padrao então
            este:_saidaformatada("/OpenAction [3 0 R /XYZ null null %.2f]\n", este.m_AmpliaPersonalizado/100.0)
        senãose este.m_ModoAmpliado==pdf_e_amplia_paginainteira então
            este:_saidaformatada("/OpenAction [3 0 R /Fit]\n")
        senãose este.m_ModoAmpliado==pdf_e_amplia_larguratotal então
            este:_saidaformatada("/OpenAction [3 0 R /FitH null]\n")
        senãose este.m_ModoAmpliado==pdf_e_amplia_real então
            este:_saidaformatada("/OpenAction [3 0 R /XYZ null null 1]\n")
	fim

        se este.m_ModoVisual==pdf_e_visual_simples então
            este:_saidaformatada("/PageLayout /SinglePage\n")
        senãose este.m_ModoVisual==pdf_e_visual_continuo então
            este:_saidaformatada("/PageLayout /OneColumn\n")
        senãose este.m_ModoVisual==pdf_e_visual_duplo então
            este:_saidaformatada("/PageLayout /TwoColumnLeft\n")
	fim

        se este.m_javascript e #este.m_javascript > 0 então
            este:_saidaformatada("/Names\n<<\n/JavaScript %d 0 R\n>>\n", este.m_n_js)
        fim
    fim,

    _poecabecalho = função(este)
        este:_saida(cadeiaformate("%%PDF-%s\n", este.m_VersaoPDF))
    fim,

    _poeraiz = função(este)
		local n = este.m_n
        este:_saidaformatada("/Size %d\n/Root %d 0 R\n/Info %d 0 R\n", (n+1), este.m_objetoCatalogo, este.m_objetoInfo)
    fim,

    _enddoc = função(este)
        se (#este.m_extgstates > 0 e (este.m_VersaoPDF < "1.4") ) então este.m_VersaoPDF = "1.4" fim
        este:_poecabecalho()
        este:_poepaginas()
        este:_poerecursos()
        -- Info
        este:_novoobj()
        este.m_objetoInfo = este.m_n
        este:_saida("<<\n")
        este:_poeinfo()
        este:_saida(">>\nendobj\n")
        este:_poemetadados()
        -- Catalog
        este:_novoobj()
        este.m_objetoCatalogo = este.m_n
        este:_saida("<<\n")
        este:_poecatalogo()
        este:_saida(">>\nendobj\n")
        --save begining of xref
        local saved_startxref = este:_calc_m_buffer_size()
        -- Cross-ref
        este:_saidaformatada("xref\n0 %d\n0000000000 65535 f \n", (este.m_n+1))
        para i=1, este.m_n início
            este:_saidaformatada("%010d 00000 n \n", este.m_offsets[i])
        fim
        -- Trailer
        este:_saida("trailer\n<<\n")
        este:_poeraiz()
        este:_saidaformatada(">>\nstartxref\n%d\n%%%%EOF\n", saved_startxref)
        este.m_estado = 3
    fim,

}

função FPDF:novo(obj)
	obj = obj ou {}   -- create object if user does not provide one
	definaMetatabela(obj, este)
	este.__índice = este
	obj:reinicie(pdf_e_orientation_portrait, pdf_e_units_mm, pdf_e_A4)
	retorne obj
fim

retorne FPDF;
