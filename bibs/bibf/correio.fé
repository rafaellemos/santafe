    -- Usado quando o chamador já formou e persistiu o MIME. Isso garante que
    -- a cópia da caixa e a fila referenciem exatamente os mesmos tacos.
    função fila.adicioneFormadaAssíncrono(esta, mensagem, conteúdo, objeto,
                                                  tratador, dado)
        se tipo(mensagem) ~= "tabela" ou
                tipo(mensagem.destinatários) ~= "função" então
            retorne falhe("mensagem inválida; use correio.novaMensagem")
        fim
        se tipo(conteúdo) ~= "colar" então
            retorne falhe("conteúdo MIME precisa ser um colar binário")
        fim
        se não esta.depósito então
            retorne falhe("depósito é obrigatório para MIME já persistido")
        fim
        se tipo(objeto) ~= "tabela" ou tipo(objeto.resumo) ~= "colar" ou
                #objeto.resumo ~= 64 ou
                não objeto.resumo:procure("^[0-9a-f]+$") ou
                objeto.tamanho ~= #conteúdo então
            retorne falhe("objeto MIME preparado é inválido")
        fim
        retorne insira(esta, "saída", "pendente", mensagem.remetente,
            mensagem:destinatários(), conteúdo, tratador, dado, objeto)
    fim

    função fila.reservePróximaAssíncrono(esta, tratador, dado)
        se tipo(tratador) ~= "função" então
            retorne falhe("tratador precisa ser uma função")
        fim
        local bilhete = colar.formate("%08x%08x%08x",
            so.aleatório(), so.aleatório(), so.aleatório())
        local agora = so.tempo()
        local atualize = "UPDATE `" .. esta.tabela .. "` SET " ..
            "estado='processando',bilhete=?,arrendada_ate=?,atualizada_em=? " ..
            "WHERE estado='pendente' AND proxima_tentativa<=? " ..
            "ORDER BY id LIMIT 1"
        retorne esta.piscina:executePreparadoAssíncrono(atualize,
            { bilhete, agora + esta.tempoDaReserva, agora, agora },
            função(_, resultado, falhaSQL)
                local afetadas = resultado e resultado:linhasAfetadas() ou 0
                fecheResultado(resultado)
                se falhaSQL então chame(tratador, nulo, falhaSQL, dado); retorne fim
                se afetadas == 0 então chame(tratador, nulo, nulo, dado); retorne fim
                local selecione = "SELECT id,remetente,destinatarios,conteudo," ..
                    "conteudo_objeto,tamanho,tentativas,criada_em," ..
                    "falhas_permanentes,ultima_falha FROM `" ..
                    esta.tabela .. "` WHERE bilhete=?"
                esta.piscina:executePreparadoAssíncrono(selecione, { bilhete },
                    função(_, consulta, falhaDaSeleção)
                        se falhaDaSeleção então
                            fecheResultado(consulta)
                            chame(tratador, nulo, falhaDaSeleção, dado)
                            retorne
                        fim
                        local linha = consulta:obterLinha()
                        fecheResultado(consulta)
                        se não linha então
                            chame(tratador, nulo, "reserva MariaDB desapareceu", dado)
                            retorne
                        fim
                        local função registreFalhaInterna(mensagem)
                            esta:registreFalhaInternaAssíncrono(
                                paraNúmero(linha[1]), mensagem,
                                esta.limiteDeFalhasInternas,
                                função(_, falhaDoRegistro)
                                    chame(tratador, nulo,
                                        falhaDoRegistro ou mensagem, dado)
                                fim)
                        fim
                        local decodificou, destinatários = proteja(json.decod, linha[3])
                        se não decodificou então
                            registreFalhaInterna(
                                "destinatários da fila estão corrompidos: " ..
                                paraColar(destinatários))
                            retorne
                        fim
                        local permanentes = {}
                        se linha[9] e linha[9] ~= "" então
                            local decodificouPermanentes, listaPermanente =
                                proteja(json.decod, linha[9])
                            se não decodificouPermanentes então
                                registreFalhaInterna(
                                    "falhas permanentes da fila estão corrompidas: " ..
                                    paraColar(listaPermanente))
                                retorne
                            fim
                            permanentes = listaPermanente
                        fim
                        local função entregue(conteúdo)
                            chame(tratador, {
                                identificação = paraNúmero(linha[1]),
                                remetente = linha[2],
                                destinatários = destinatários,
                                conteúdo = conteúdo,
                                tentativas = paraNúmero(linha[7]) ou 0,
                                criadaEm = paraNúmero(linha[8]),
                                falhasPermanentes = permanentes,
                                últimaFalha = linha[10],
                                bilhete = bilhete
                            }, nulo, dado)
                        fim
                        se linha[5] então
                            se não esta.depósito então
                                chame(tratador, nulo,
                                    "fila usa objeto, mas não recebeu depósito",
                                    dado)
                                retorne
                            fim
                            esta.depósito:leiaAssíncrono(
                                linha[5], paraNúmero(linha[6]),
                                função(conteúdo, falhaDoDepósito)
                                    se não conteúdo então
                                        chame(tratador, nulo,
                                            falhaDoDepósito, dado)
                                        retorne
                                    fim
                                    entregue(conteúdo)
                                fim)
                            retorne
                        fim
                        se linha[4] == nulo então
                            registreFalhaInterna(
                                "item da fila sem conteúdo armazenado")
                            retorne
                        fim
                        entregue(linha[4])
                    fim)
            fim)
    fim

