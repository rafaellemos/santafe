        se não limite ou limite < 1 ou limite > 1000 então
            retorne falhe("limite da quarentena deve ficar entre 1 e 1000")
        fim
        local sql = "SELECT id,remetente,destinatarios,tentativas," ..
            "falhas_internas,ultima_falha,criada_em,atualizada_em FROM `" ..
            esta.tabela .. "` WHERE estado='quarentena' " ..
            "ORDER BY atualizada_em DESC,id DESC LIMIT " .. limite
        retorne esta.piscina:executeAssíncrono(sql,
            função(_, resultado, falhaSQL)
                se falhaSQL então
                    fecheResultado(resultado)
                    chame(tratador, nulo, falhaSQL, dado); retorne
                fim
                local itens = {}
                enquanto verdadeiro início
                    local linha = resultado:obterLinha()
                    se não linha então pare fim
                    itens[#itens + 1] = {
                        identificação = paraNúmero(linha[1]),
                        remetente = linha[2], destinatários = linha[3],
                        tentativas = paraNúmero(linha[4]) ou 0,
                        falhasInternas = paraNúmero(linha[5]) ou 0,
                        falha = linha[6], criadaEm = paraNúmero(linha[7]),
                        atualizadaEm = paraNúmero(linha[8])
                    }
                fim
                fecheResultado(resultado)
                chame(tratador, itens, nulo, dado)
            fim)
    fim

