    função fila.soliciteAvisoAssíncrono(esta, identificação,
            tipoDoAviso, detalhes, tratador, dado)
        local codificado, falhaDoAviso = codifiqueAviso(tipoDoAviso, detalhes)
        se não codificado então retorne nulo, falhaDoAviso fim
        local agora = so.tempo()
        local sql = "INSERT IGNORE INTO `" .. esta.tabelaDeAvisos .. "` " ..
            "(fila_id,tipo,estado,detalhes,tentativas,proxima_tentativa," ..
            "criada_em,atualizada_em) VALUES (?,?,'pendente',?,0,?,?,?)"
        retorne esta.piscina:executePreparadoAssíncrono(sql,
            { identificação, tipoDoAviso, codificado, agora, agora, agora },
            função(_, resultado, falhaSQL)
                local inseriu = resultado e resultado:linhasAfetadas() == 1
                fecheResultado(resultado)
                chame(tratador, falhaSQL e nulo ou {
                    inseriu = inseriu, tipo = tipoDoAviso
                }, falhaSQL, dado)
            fim)
    fim

    função fila.marqueFalhouEAviseAssíncrono(esta, identificação,
            falhaDaEntrega, falhasPermanentes, detalhes, tratador, dado)
        local funcionou, permanentesJSON = proteja(json.cod,
            falhasPermanentes ou {})
        se não funcionou então retorne nulo, permanentesJSON fim
        local avisoJSON, falhaDoAviso = codifiqueAviso("falha", detalhes)
        se não avisoJSON então retorne nulo, falhaDoAviso fim
        local iniciou, falhaDaTransação =
            esta.piscina:inicieTransaçãoAssíncrona(
            função(_, transação, falhaAoIniciar)
                se falhaAoIniciar então
                    chame(tratador, nulo, falhaAoIniciar, dado); retorne
                fim
                local agora = so.tempo()
                local atualize = "UPDATE `" .. esta.tabela .. "` SET " ..
                    "estado='falhou',ultima_falha=?,falhas_permanentes=?," ..
                    "bilhete=NULL,arrendada_ate=NULL,atualizada_em=? WHERE id=?"
                transação:executePreparadoAssíncrono(atualize,
                    { paraColar(falhaDaEntrega), permanentesJSON,
                      agora, identificação },
                    função(_, resultado, falhaDaMarca)
                        local afetadas = resultado e
                            resultado:linhasAfetadas() ou 0
                        fecheResultado(resultado)
                        se falhaDaMarca ou afetadas ~= 1 então
                            transação:desfaçaAssíncrono(função()
                                chame(tratador, nulo, falhaDaMarca ou
                                    "item da fila não encontrado", dado)
                            fim)
                            retorne
                        fim
                        local inclua = "INSERT IGNORE INTO `" ..
                            esta.tabelaDeAvisos .. "` " ..
                            "(fila_id,tipo,estado,detalhes,tentativas," ..
                            "proxima_tentativa,criada_em,atualizada_em) " ..
                            "VALUES (?,'falha','pendente',?,0,?,?,?)"
                        transação:executePreparadoAssíncrono(inclua,
                            { identificação, avisoJSON,
                              agora, agora, agora },
                            função(_, inclusão, falhaDaInclusão)
                                fecheResultado(inclusão)
                                se falhaDaInclusão então
                                    transação:desfaçaAssíncrono(função()
                                        chame(tratador, nulo,
                                            falhaDaInclusão, dado)
                                    fim)
                                    retorne
                                fim
                                transação:confirmeAssíncrono(
                                    função(_, _, falhaDaConfirmação)
                                        chame(tratador,
                                            falhaDaConfirmação e nulo ou verdadeiro,
                                            falhaDaConfirmação, dado)
                                    fim)
                            fim)
                    fim)
            fim)
        se falhaDaTransação então
            chame(tratador, nulo, falhaDaTransação, dado)
        fim
        retorne iniciou
    fim

