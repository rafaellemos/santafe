    local função insira(esta, direção, estado, remetente, destinatários,
                             conteúdo, tratador, dado, objetoPreparado)
        local codificou, lista = proteja(json.cod, destinatários)
        se não codificou então
            chame(tratador, nulo, lista, dado)
            retorne nulo, lista
        fim
        local função insiraNoBanco(objeto)
            local agora = so.tempo()
            local sql, parâmetros
            se objeto então
                sql = "INSERT INTO `" .. esta.tabela .. "` " ..
                    "(direcao,estado,remetente,destinatarios,conteudo," ..
                    "conteudo_objeto,tamanho,tentativas,proxima_tentativa," ..
                    "criada_em,atualizada_em) VALUES (?,?,?,?,NULL,?,?,0,?,?,?)"
                parâmetros = {
                    direção, estado, remetente, lista, objeto.resumo,
                    objeto.tamanho, agora, agora, agora
                }
            senão
                -- Compatibilidade de transição para filas sem um depósito
                -- configurado. A instalação postal oficial sempre o fornece.
                sql = "INSERT INTO `" .. esta.tabela .. "` " ..
                    "(direcao,estado,remetente,destinatarios,conteudo,tamanho," ..
                    "tentativas,proxima_tentativa,criada_em,atualizada_em) " ..
                    "VALUES (?,?,?,?,?,?,0,?,?,?)"
                parâmetros = {
                    direção, estado, remetente, lista, conteúdo, #conteúdo,
                    agora, agora, agora
                }
            fim
            retorne esta.piscina:executePreparadoAssíncrono(sql, parâmetros,
                função(_, resultado, falhaSQL)
                    local identificação = resultado e resultado:idInserido()
                    fecheResultado(resultado)
                    chame(tratador, falhaSQL e nulo ou identificação,
                        falhaSQL, dado)
                fim)
        fim

        se objetoPreparado então retorne insiraNoBanco(objetoPreparado) fim
        se esta.depósito então
            retorne esta.depósito:graveAssíncrono(conteúdo,
                função(objeto, falhaDoDepósito)
                    se não objeto então
                        chame(tratador, nulo, falhaDoDepósito, dado)
                        retorne
                    fim
                    insiraNoBanco(objeto)
                fim)
        fim
        retorne insiraNoBanco(nulo)
    fim

