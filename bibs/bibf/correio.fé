    função fila.adicioneAssíncrono(esta, mensagem, tratador, dado)
        se tipo(mensagem) ~= "tabela" ou tipo(mensagem.forme) ~= "função" então
            retorne falhe("mensagem inválida; use correio.novaMensagem")
        fim
        local conteúdo, falhaDaFormação = mensagem:forme()
        se não conteúdo então retorne nulo, falhaDaFormação fim
        retorne insira(esta, "saída", "pendente", mensagem.remetente,
            mensagem:destinatários(), conteúdo, tratador, dado)
