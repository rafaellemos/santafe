%YAML 1.2
---
name: Santafé
file_extensions:
  - fé
  - fe
scope: source.santafe
version: 2
first_line_match: '(?i)^#!.*\bsantafé\b'

variables:
  ident_start: '[[:alpha:]_]'
  ident_char: '[[:alnum:]\p{M}_]'
  ident: '{{ident_start}}{{ident_char}}*'
  ident_before: '(?<!{{ident_char}})'
  ident_break: '(?!{{ident_char}})'
  palavra_reservada: '{{ident_before}}(?:local|função|retorne|se|então|senão|enquanto|para|em|repita|até|início|fim|pare|vápara|nulo|verdadeiro|falso|e|ou|não){{ident_break}}'
  função_global: '(?:mostre|tipo|tamanho|octetos|importe|carregue|carregueArquivo|executeArquivo|garanta|proteja|protejaMais|paraNúmero|paraColar|pares|ipares|próximo|erro|coleteLixo){{ident_break}}'

contexts:
  prototype:
    - include: comentários

  main:
    - include: declarações
    - include: gabaritos
    - include: colares
    - include: números
    - match: '{{palavra_reservada}}'
      scope: keyword.control.santafe
    - match: '{{ident_before}}_(?:AMBIENTE|VERSÃO){{ident_break}}'
      scope: support.constant.santafe
    - match: '{{ident_before}}{{função_global}}'
      scope: support.function.builtin.santafe
    - match: '{{ident_before}}{{ident}}(?=\s*[.:])'
      scope: variable.namespace.santafe
    - match: '(?:\.\.|//|<<|>>|==|~=|<=|>=|[+\-*/%^#=<>~&|])'
      scope: keyword.operator.santafe
    - match: '[{}()\[\],;:]'
      scope: punctuation.separator.santafe

  comentários:
    - match: '--\[(=*)\['
      scope: punctuation.definition.comment.begin.santafe
      push:
        - meta_scope: comment.block.santafe
        - meta_include_prototype: false
        - match: '\]\1\]'
          scope: punctuation.definition.comment.end.santafe
          pop: true
    - match: '--'
      scope: punctuation.definition.comment.santafe
      push:
        - meta_scope: comment.line.double-dash.santafe
        - meta_include_prototype: false
        - match: '$\n?'
          pop: true

  declarações:
    - match: '{{ident_before}}(local\s+)?(função)\s+({{ident}})'
      scope: meta.function.santafe
      captures:
        1: storage.modifier.santafe
        2: keyword.declaration.function.santafe
        3: entity.name.function.santafe

  gabaritos:
    - match: '`'
      scope: punctuation.definition.string.begin.santafe
      push:
        - meta_scope: string.quoted.other.gabarito.santafe
        - meta_include_prototype: false
        - match: '`'
          scope: punctuation.definition.string.end.santafe
          pop: true
        - match: '[®Ⓡ]\{'
          scope: punctuation.section.interpolation.begin.santafe
          push:
            - meta_scope: meta.interpolation.santafe
            - match: '\}'
              scope: punctuation.section.interpolation.end.santafe
              pop: true
            - include: main
        - match: '\\.'
          scope: constant.character.escape.santafe

  colares:
    - match: '\[(=*)\['
      push:
        - meta_scope: string.quoted.other.long.santafe
        - meta_include_prototype: false
        - match: '\]\1\]'
          pop: true
    - match: "'"
      push:
        - meta_scope: string.quoted.single.santafe
        - meta_include_prototype: false
        - match: "'"
          pop: true
        - match: '\\.'
          scope: constant.character.escape.santafe
    - match: '"'
      scope: punctuation.definition.string.begin.santafe
      push:
        - meta_scope: string.quoted.double.santafe
        - meta_include_prototype: false
        - match: '"'
          scope: punctuation.definition.string.end.santafe
          pop: true
        - match: '\\.'
          scope: constant.character.escape.santafe

  números:
    - match: '(?<!{{ident_char}})(?:0[xX][0-9A-Fa-f]+|(?:\d+\.?\d*|\.\d+)(?:[eE][+-]?\d+)?)(?!{{ident_char}})'
      scope: constant.numeric.santafe
