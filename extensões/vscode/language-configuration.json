{
  "comments": {
    "lineComment": "--",
    "blockComment": ["--[[", "]]" ]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "`", "close": "`", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"],
    ["`", "`"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?!--).*\\b(início|então|função|repita)\\b.*$",
    "decreaseIndentPattern": "^\\s*(fim|até|senão)\\b"
  },
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\s`~!@#%\\^&*()=+[{]}\\\\|;:'\\\",.<>/?]+)"
}
