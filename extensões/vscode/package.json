{
  "name": "santafe",
  "displayName": "Santafé",
  "description": "Santafé 3: listas, nulo armazenável, ONFÉ e integração com SLS 1.1.",
  "version": "2.0.0",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "publisher": "santafe",
  "license": "MIT",
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "santafé",
    "santafe",
    "português",
    "lua",
    "lsp"
  ],
  "main": "./extension.js",
  "icon": "./icon.png",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onLanguage:santafe-dados",
    "onLanguage:onfe"
  ],
  "contributes": {
    "configurationDefaults": {
      "[santafe-dados]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "semanticTokenTypes": [
      {
        "id": "santafeEmbeddedTag",
        "description": "Tag HTML em colar"
      },
      {
        "id": "santafeEmbeddedAttribute",
        "description": "Atributo HTML em colar"
      },
      {
        "id": "santafeEmbeddedComment",
        "description": "Comentário embutido"
      },
      {
        "id": "santafeEmbeddedString",
        "description": "Colar embutido"
      },
      {
        "id": "santafeEmbeddedNumber",
        "description": "Número embutido"
      },
      {
        "id": "santafeEmbeddedConstant",
        "description": "Constante embutida"
      },
      {
        "id": "santafeEmbeddedKeyword",
        "description": "Palavra-chave embutida"
      },
      {
        "id": "santafeEmbeddedStorage",
        "description": "Declaração embutida"
      },
      {
        "id": "santafeEmbeddedOperator",
        "description": "Operador embutido"
      },
      {
        "id": "santafeEmbeddedFunction",
        "description": "Função embutida"
      },
      {
        "id": "santafeEmbeddedType",
        "description": "Tipo embutido"
      },
      {
        "id": "santafeEmbeddedSupport",
        "description": "Símbolo nativo embutido"
      },
      {
        "id": "santafeEmbeddedVariable",
        "description": "Variável embutida"
      },
      {
        "id": "santafeEmbeddedParameter",
        "description": "Parâmetro embutido"
      },
      {
        "id": "santafeEmbeddedProperty",
        "description": "Propriedade embutida"
      },
      {
        "id": "santafeEmbeddedEntity",
        "description": "Entidade ou escape embutido"
      },
      {
        "id": "santafeEmbeddedPunctuation",
        "description": "Pontuação embutida"
      },
      {
        "id": "santafeEmbeddedText",
        "description": "Texto embutido"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "santafe",
        "scopes": {
          "santafeEmbeddedTag": [
            "entity.name.tag"
          ],
          "santafeEmbeddedAttribute": [
            "entity.other.attribute-name"
          ],
          "santafeEmbeddedComment": [
            "comment"
          ],
          "santafeEmbeddedString": [
            "string"
          ],
          "santafeEmbeddedNumber": [
            "constant.numeric"
          ],
          "santafeEmbeddedConstant": [
            "constant.language"
          ],
          "santafeEmbeddedKeyword": [
            "keyword.control"
          ],
          "santafeEmbeddedStorage": [
            "storage.type"
          ],
          "santafeEmbeddedOperator": [
            "keyword.operator"
          ],
          "santafeEmbeddedFunction": [
            "entity.name.function"
          ],
          "santafeEmbeddedType": [
            "entity.name.type"
          ],
          "santafeEmbeddedSupport": [
            "support.function"
          ],
          "santafeEmbeddedVariable": [
            "variable.other"
          ],
          "santafeEmbeddedParameter": [
            "variable.parameter"
          ],
          "santafeEmbeddedProperty": [
            "variable.other.property"
          ],
          "santafeEmbeddedEntity": [
            "constant.character.entity"
          ],
          "santafeEmbeddedPunctuation": [
            "punctuation"
          ],
          "santafeEmbeddedText": [
            "text.html.basic"
          ]
        }
      }
    ],
    "languages": [
      {
        "id": "santafe",
        "aliases": [
          "Santafé",
          "santafe"
        ],
        "extensions": [
          ".fé",
          ".fe"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "onfe",
        "aliases": [
          "ONFÉ"
        ],
        "extensions": [
          ".onfé"
        ],
        "configuration": "./onfe-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "santafe",
        "scopeName": "source.santafe",
        "path": "./syntaxes/santafe.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.inline.santafe": "santafe"
        }
      },
      {
        "language": "onfe",
        "scopeName": "source.onfe",
        "path": "./syntaxes/onfe.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "santafe",
        "path": "./snippets/santafe.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "santafe.paletaEmbutida",
        "title": "Santafé: Paleta de HTML e JavaScript embutidos"
      },
      {
        "command": "santafe.reiniciarSLS",
        "title": "Santafé: Reiniciar SLS"
      },
      {
        "command": "santafe.abrirRegistroSLS",
        "title": "Santafé: Abrir registro do SLS"
      }
    ],
    "configuration": {
      "title": "Santafé",
      "properties": {
        "santafe.highlight.embeddedPalette": {
          "type": "string",
          "enum": [
            "tema",
            "suave"
          ],
          "default": "tema",
          "description": "Paleta de HTML/JavaScript dentro de colares: acompanhar o tema ou cores suaves. Não altera arquivos HTML/JS independentes."
        },
        "santafe.languageServer.enable": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Ativa os diagnósticos e a navegação do SLS local compatível com Santafé 3."
        },
        "santafe.languageServer.command": {
          "type": "string",
          "default": "santafé-sls",
          "scope": "machine",
          "description": "Comando local que inicia o Servidor de Linguagem Santafé."
        },
        "santafe.languageServer.args": {
          "type": "array",
          "default": [],
          "scope": "machine",
          "items": {
            "type": "string"
          },
          "description": "Argumentos adicionais para o comando do SLS."
        },
        "santafe.languageServer.trace": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Registra os quadros LSP enviados e recebidos no canal de saída Santafé SLS."
        },
        "santafe.languageServer.scopeWarnings": {
          "type": "boolean",
          "default": false,
          "description": "Avisa sobre nomes sem declaração local visível. Globais dinâmicos continuam válidos; não cria temVar."
        }
      }
    }
  }
}
